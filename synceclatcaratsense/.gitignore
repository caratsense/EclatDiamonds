# ── Secrets — NEVER commit. Only the *.example.* templates are safe. ──────────
# The real config holds the Eclat service password, SQL Server + R2 credentials.
eclat_config.bat
eclat_config.backup.bat
*.env
.env
!*.example.bat
!*.example.env

# ── Generated at setup / runtime on the client machine ───────────────────────
# _pyexe.bat: written by setup.bat (local Python path)
_pyexe.bat
# state*.json / sync_state.json: per-target watermarks
state*.json
sync_state.json
# uploaded_media.json: media upload ledger
uploaded_media.json
.gati-sync.lock
# stage_map.json: client-specific status->stage mapping (regenerated by discover)
stage_map.json

# ── Run OUTPUT. A discovery report is a readable extract of the client's own
# business (branch names, party counts, document series). It belongs in the
# engagement, not the source tree, and regenerates in two minutes.
reports/
logs/
*.log

# ── Python / build artifacts ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
env/
build/
dist/
*.egg-info/
