enum ReturnType {
  return
  exchange
  repair
  old_gold
}

enum ReturnStatus {
  draft
  pending_approval
  approved
  rejected
  settled
}

enum SettlementType {
  credit_note
  refund
  exchange
}

enum DiscountStatus {
