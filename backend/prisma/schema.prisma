// ============================================================================
// DATA PIPELINE — sync watermark state (docs/DATA_PIPELINE.md)
// ============================================================================

/// Per-source-table watermark so the live SQL Server agent never re-pulls or loses rows.
model SyncState {
  id            String    @id @default(cuid())
  /// Legacy source table, e.g. "JewelTrans", "Inward", "VoucherEntry".
  sourceTable   String
  /// Store this watermark belongs to (sync is per-store per-table).
  storeId       String?
  /// Highest identity PK seen (append-row watermark).
  lastLegacyId  String?
  /// Highest UpdateDate/EntryDate seen (changed-row watermark).
  lastUpdatedAt DateTime?
  lastRunAt     DateTime?
  rowsSynced    Int       @default(0)

  updatedAt DateTime @updatedAt

  @@unique([sourceTable, storeId])
}

/// Gap-free, race-free counter behind every human-readable document reference
/// (order no, discount request no, …).
///
/// The old `prisma.<model>.count() + 1` pattern is unsafe on two counts: two
/// concurrent bookings read the same count and mint the SAME ref, and deleting a
/// row makes the next ref collide with an existing one. `SequenceService` instead
/// bumps this row inside a single atomic `UPDATE … RETURNING`, so every caller
/// gets a distinct number even under concurrency.
///
/// `scope` is the counter's partition key — typically `<DOCTYPE>:<storeId>:<YYMM>`
/// so each store gets its own monthly series.
model DocSequence {
  scope     String   @id
  next      Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt
}

// ============================================================================
// MODULE 3 — DASHBOARD TASKS (to-do / cross-dept follow-ups)
// ============================================================================

/// A simple to-do/task surfaced on the dashboard agenda (Module 3).
model Task {
  id          String    @id @default(cuid())
  storeId     String?
  title       String
  detail      String?
  assignee    String?
  /// "open" | "done"
  status      String    @default("open")
  dueDate     DateTime? @db.Date
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status])
}

/// Cross-department hand-off (Module 3 collaboration): one team raises a piece of
/// work for another department (e.g. sales -> workshop). Store-scoped.
model Handoff {
  id            String   @id @default(cuid())
  storeId       String
  fromDept      String
  toDept        String
  title         String
  note          String?
  /// "open" | "accepted" | "done" (assignee finished) | "closed" (creator approved)
  status        String   @default("open")
  createdById   String
  createdByName String
  /// Display name of the assignee (kept for legacy rows / free-text fallback).
  assignedTo    String?
  /// The assignee's user id — who gets notified and whose "assigned to me" this is.
  assignedToId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([status])
}

// ============================================================================
// MODULE 10 — REPORTING & DSR (Daily Sales Report, store-close entry)
// ============================================================================

/// A store-close Daily Sales Report — the exact figures a store manager currently
/// types on WhatsApp at end of day, captured on the website instead. One row per
/// store per report-date (traffic + sales + payment split + old-gold). Rolls up
/// into the derived weekly/monthly summaries; the composed text mirrors the
/// owner's WhatsApp format 1:1 (see docs/CLIENT-CALL-2026-07.md § Module 10).
model DailyReport {
  id               String   @id @default(cuid())
  storeId          String
  reportDate       DateTime @db.Date
  reportTime       String? // "8:00 PM"
  walkIns          Int      @default(0)
  seriousEnquiries Int      @default(0)
  deliveredBilled  Decimal  @default(0) @db.Decimal(14, 2)
  bookingsNew      Decimal  @default(0) @db.Decimal(14, 2)
  advanceReceived  Decimal  @default(0) @db.Decimal(14, 2)
  cash             Decimal  @default(0) @db.Decimal(14, 2)
  card             Decimal  @default(0) @db.Decimal(14, 2)
  upi              Decimal  @default(0) @db.Decimal(14, 2)
  oldGoldWtG       Decimal? @db.Decimal(12, 3)
  oldGoldValue     Decimal? @db.Decimal(14, 2)
  submittedBy      String?
  createdAt        DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, reportDate])
}

// ============================================================================
// LEGACY MIRROR — full raw copy of EVERY APRS-SJEP table (extract-everything-once)
// ============================================================================

/// Generic landing table: one row per source-table row, the whole record as JSON.
/// The on-site agent's full-dump mode mirrors EVERY legacy table here, so ANY
/// field is available later without ever changing the sync code. Upserted by
/// (sourceTable, rowKey); incremental via legacyUpdatedAt where the source has it.
model LegacyRow {
  id              String    @id @default(cuid())
  sourceTable     String
  rowKey          String
  data            Json
  legacyUpdatedAt DateTime?
  syncedAt        DateTime  @default(now())

  @@unique([sourceTable, rowKey])
  @@index([sourceTable])
  @@index([sourceTable, legacyUpdatedAt])
}

// ============================================================================
// AUDIT LOG — append-only trail of sensitive decisions (approvals, role changes)
// ============================================================================

/// One immutable audit entry per sensitive mutation (discount/return approvals,
/// role/store changes, leave decisions, commission-rate + target edits). Written
/// best-effort by AuditService AFTER the main write; never blocks the mutation.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  actorName  String
  actorRole  Role
  action     String
  entityType String
  entityId   String
  storeId    String?
  summary    String
  metadata   Json?
  actor      User     @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([storeId])
}

// ============================================================================
// SALES TARGETS — per-store (+ optional per-staff) monthly revenue goals
// ============================================================================

/// A monthly revenue target for a store, optionally narrowed to one staff member.
/// `staffId = null` is the WHOLE-STORE target used by the dashboard achievement view.
model SalesTarget {
  id          String   @id @default(cuid())
  storeId     String
  staffId     String?
  period      String // "YYYY-MM"
  amount      Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  staff User? @relation("UserSalesTargets", fields: [staffId], references: [id])

  @@unique([storeId, staffId, period])
  @@index([period])
}
