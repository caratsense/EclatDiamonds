// CORE: MULTI-STORE HIERARCHY + RBAC
// ============================================================================

/// Multi-org tenant root (CaratOS Phase 2). Nullable FKs are backfilled later;
/// only the anchored-isolation model set carries organisationId.
model Organisation {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  gstin     String?
  legalName String?

  /// Tenant lifecycle. `onboarding` may still sign in (it has to, to finish
  /// setup); `suspended` and `cancelled` are refused at the auth guard. This
  /// replaces the former `isActive` boolean so a tenant's state has exactly one
  /// source of truth rather than a flag and a status that can disagree.
  status OrganisationStatus @default(active)

  /// Which industry pack seeds this tenant's taxonomy, attributes and field
  /// policy (see IndustryPack). NULL means no pack has been chosen yet, which is
  /// only valid while `status = onboarding`.
  industryPackCode    String?
  /// Version of that pack last applied, so an upgrade can diff pack-owned rows
  /// (packCode set) and leave tenant-created ones alone.
  industryPackVersion Int?

  /// Modules this tenant has switched OFF, on top of what their industry pack
  /// includes.
  ///
  /// ── Why a column and not a key in `settings` ─────────────────────────────
  ///
  /// The entitlement guard reads this on EVERY request, alongside the status and
  /// pack code it already selects. `settings` is a shared JSONB bag holding
  /// branding, assistant switches, qualification policy and routing rules;
  /// pulling all of it into the authentication path to read one array would cost
  /// every request, and writing to it needs the row lock in `org-settings.ts`
  /// because three unrelated features share it. A dedicated array is cheap to
  /// select, has no lost-update problem, and says what it is.
  ///
  /// ── Why subtract rather than store the whole list ────────────────────────
  ///
  /// Storing the tenant's complete enabled list would freeze it: a module added
  /// to their industry pack in a later release would never appear, exactly as
  /// the old stored `featureProfile.enabledNavigation` froze tenants on the
  /// navigation of whichever industry they signed up under. The pack stays the
  /// source of what the industry INCLUDES; this records only what this tenant
  /// has deliberately turned off, so the two compose and neither drifts.
  ///
  /// Entries are navigation slugs, which are the same strings the entitlement
  /// registry calls capabilities. Empty for every tenant until somebody switches
  /// something off.
  disabledCapabilities String[] @default([])

  /// Regional defaults. Eclat is India/INR/Asia-Kolkata; a new tenant elsewhere
  /// sets its own rather than inheriting a hardcoded assumption. `timezone` is
  /// the tenant-level fallback — a store's own timezone still wins (tz.util).
  country  String @default("IN")
  currency String @default("INR")
  timezone String @default("Asia/Kolkata")

  /// Tenant-level settings that are genuinely free-form (branding, feature
  /// toggles, locale preferences). Anything queried or validated gets a real
  /// column instead — this is not an escape hatch for modelling.
  settings Json?

  /// Bumped by ConfigService whenever taxonomy / attributes / field policy
  /// change, so a client can cache GET /config/bootstrap and revalidate cheaply.
  configVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions                      Region[]
  stores                       Store[]
  users                        User[]
  parties                      Party[]
  metalRates                   MetalRate[]
  diamondRates                 DiamondRate[]
  discountLimits               DiscountLimit[]
  discountPresets              DiscountPreset[]
  schemePlans                  SchemePlan[]
  syncStates                   SyncState[]
  legacyRows                   LegacyRow[]
  scheduledJobRuns             ScheduledJobRun[]
  products                     Product[]
  productEmbeddings            ProductEmbedding[]
  productImages                ProductImage[]
  similaritySearchFeedbacks    SimilaritySearchFeedback[]
  leads                        Lead[]
  quotes                       Quote[]
  stockItems                   StockItem[]
  stockTransfers               StockTransfer[]
  sales                        Sale[]
  customOrders                 CustomOrder[]
  manufacturingOrders          ManufacturingOrder[]
  ledgerEntries                LedgerEntry[]
  payments                     Payment[]
