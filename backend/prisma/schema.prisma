  id        String    @id @default(cuid())
  userId    String
  storeId   String?
  type      LeaveType
  year      Int
  allocated Decimal   @default(0) @db.Decimal(5, 1)
  used      Decimal   @default(0) @db.Decimal(5, 1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, year])
  @@index([userId, year])
}

/// Request to fix a missed/wrong punch (Zoho-style HRMS regularization, Module 6).
model AttendanceRegularization {
  id                String      @id @default(cuid())
  storeId           String
  staffId           String
  staffName         String?
  date              DateTime    @db.Date
  requestedCheckIn  DateTime?
