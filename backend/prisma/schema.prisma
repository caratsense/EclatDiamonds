  purchase
  branch_transfer
  proforma
  sale_return
  purchase_return
}

enum OrderStatus {
  booked
  designing
  casting
  stone_setting
  polishing
  qc
  ready
  delivered
  cancelled
}

enum TimelineRole {
  salesperson
  back_office
  runner
  factory
}

/// Whether an order is a customer custom order or a stock/replenishment order.
enum OrderKind {
