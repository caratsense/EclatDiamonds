// Eclat / CaratSense � PostgreSQL target schema (data layer for the new backend).
//
// Design principles (see CLAUDE.md, docs/eclat-schema.md):
//   1. Multi-store first: Region -> Store hierarchy; every business row carries storeId.
//   2. RBAC: User / Role / UserStore assignments; per-role discount-approval limits.
//   3. Exact numerics: Decimal for all money, gold/metal weights, making charges, tax.
//   4. Legacy provenance: tables mirroring APRS-SJEP rows carry legacyId + legacyUpdatedAt
//      so the 15-min sync agent can upsert by watermark (docs/DATA_PIPELINE.md).
//   5. Images live in object storage; only URLs + (future) vectors live in Postgres.
//
// NOTE ON AI IMAGE SEARCH (Module 5):
//   pgvector is NOT installed on the local dev Postgres, so the catalogue embedding is
//   modelled as Float[] here (portable, applies cleanly everywhere). Once the `vector`
//   extension is installed in the target environment, migrate `embedding` to a real
//   `vector(N)` column and add an HNSW/IVFFlat ANN index. See docs/eclat-schema.md
//   ("AI image search") for the exact upgrade migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

/// Tenant lifecycle. Enforced in JwtAuthGuard: only `onboarding` and `active`
/// may authenticate. `cancelled` is retained (not deleted) so an offboarded
/// tenant's data survives for export/retention rather than vanishing.
enum OrganisationStatus {
  onboarding
  active
  suspended
  cancelled
}

enum Role {
  salesperson
  store_manager
  area_manager
  head_office
  /// APPENDED. The store's inventory job: catalogue, stock inward, VIN lookup,
  /// dead stock and product photos at their own branch — and nothing about
  /// customers, money or the team. Not a rung on the ladder above: its access is
  /// an explicit permission list (auth/permissions.ts), never a rank comparison.
  /// RETIRED 2026-09-19 (with area_manager): no longer assignable; kept only
  /// because Postgres enum values cannot be dropped while rows could hold them.
  storeperson
  /// APPENDED 2026-09-19. One per store: CRM, marketing and inbound, and their
  /// own attendance and leave — no sales, stock or money (auth/access.ts).
  marketing
}

/// Self-signup approval lifecycle. `approved` is the default so every existing
/// and manager-provisioned user is unaffected � only self-signups start `pending`
/// and are gated OUT of login until an authorised approver acts. This is distinct
/// from `isActive` (offboarding) and from imported-staff activation.
enum ApprovalStatus {
  approved
  pending
  rejected
}

enum PartyType {
  customer
  supplier
  staff
  salesperson
  branch
  account
}

enum LeadStage {
  inquiry
  quotation
  order_placed
}

enum LeadSource {
  walk_in
  phone
  whatsapp
  website
  instagram
  referral
  /// A lead form submitted on Facebook or Instagram (Meta Lead Ads).
  /// Appended, never inserted: Postgres enum values are positional and existing
  /// rows reference them. `instagram` is the organic channel, not a paid lead
  /// form, so the two are deliberately separate values.
  meta_ads
  /// Opened from a spreadsheet or connector import. Says only what is known —
  /// this came out of a file — rather than crediting a marketing channel that
  /// may never have been involved.
  imported
}

enum QuoteStatus {
  draft
  shared
  accepted
  expired
  /// APPENDED, never inserted: Postgres enum values are positional and existing
  /// rows reference them by position. Adding these in the middle would silently
  /// re-label every quote already in the table.
  ///
  /// A quote whose amount is over the tenant's threshold sits here until a
  /// manager decides. Tenants with no threshold configured never see it, and
  /// every quote written before this existed keeps the status it had.
  pending_approval
  approved
  rejected
}

/// Whether a quote is a normal sale quote or a making-only repair quote (Round 2).
enum QuoteKind {
  sale
  repair
}

enum MetalKind {
  gold_24k
  gold_22k
  gold_18k
  /// 14K/10K/9K gold � the real purities this (lab-grown diamond) business uses;
  /// karat is read per-piece from the SKU token (-14KT-/-18KT-/-9KT-).
  gold_14k
  /// 12K (500 fineness): one of the six karats the business quotes in.
  gold_12k
  gold_10k
  gold_9k
  rose_gold_18k
  platinum
  silver
  /// Gold whose karat could not be determined from the legacy source (rare).
  gold_unspecified
  /// Neutral material bucket for non-jewellery catalogue records imported from
  /// a generic ERP. The source wording is retained in Product.materialLabel.
  unspecified
