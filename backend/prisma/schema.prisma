  legacyUpdatedAt DateTime?
  createdAt       DateTime  @default(now())

  order ManufacturingOrder? @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

/// Customer-facing custom order with stage progress (Module 8 timeline UI).
model CustomOrder {
  id              String           @id @default(cuid())
  ref             String           @unique
  storeId         String
  partyId         String?
  customerName    String
  kind            OrderKind        @default(custom)
  category        ProductCategory?
  qty             Int              @default(1)
  details         String?
  imageUrl        String?
  item            String
  value           Decimal?         @db.Decimal(14, 2)
  advanceReceived Decimal?         @db.Decimal(14, 2)
  stage           OrderStatus      @default(booked)
  ownerRole       TimelineRole     @default(salesperson)
  ownerName       String?
  bookedOn        DateTime
  eta             DateTime?

  // Round 2: custom-order booking detail + advance proof (all additive/optional).
  /// Ring size (custom order booking detail).
  ringSize          String?
  /// Bangle size (custom order booking detail).
  bangleSize        String?
  /// Metal colour, open text: yellow / white / rose / platinum / silver.
  metalColor        String?
  /// Payment mode for the advance: cash / card / upi / bank.
  advanceMode       String?
  /// Object-storage URL of the advance receipt photo (separate from imageUrl design ref).
  advanceReceiptUrl String?
  /// Promised customer-facing delivery date (distinct from eta).
  deliveryDate      DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store              @relation(fields: [storeId], references: [id])
  party  Party?             @relation(fields: [partyId], references: [id])
  events CustomOrderEvent[]

  @@index([storeId, createdAt])
  @@index([stage])
}

model CustomOrderEvent {
  id         String        @id @default(cuid())
  orderId    String
  stage      OrderStatus
  note       String?
  byRole     TimelineRole?
  byName     String?
  occurredAt DateTime      @default(now())

  order CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
}

