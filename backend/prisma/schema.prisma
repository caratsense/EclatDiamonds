// ============================================================================
// NOTIFICATIONS � persisted, per-recipient, clearable
// ============================================================================

/// What produced a notification. Drives the icon, the grouping and the
/// assistant's intent filters.
enum NotificationKind {
  discount_request
  return_request
  leave_request
  regularization_request
  special_request
  diamond_rate_request
  order_delayed
  attendance_review
  reminder
  system
}

/// A delivered notification.
///
/// The bell used to be a set of live `count()` queries with no rows behind it,
/// which is why nothing could be cleared: there was nothing to clear, only a
/// number that fell when someone resolved the underlying record. Persisting the
/// event gives each recipient their own read/dismiss state, a history that
/// survives the source record being decided, and something the assistant can
/// actually answer questions about.
model Notification {
  id      String           @id @default(cuid())
  /// Recipient. Notifications are fanned out per-user, not per-role, so read
  /// state is genuinely personal.
  userId  String
  storeId String?
  kind    NotificationKind
  title   String
  body    String?
  /// In-app route this deep-links to.
  href    String?

  /// The record this is about, so the UI can jump to it and the feed can be
  /// reconciled when that record is later decided.
  entityType String?
  entityId   String?

  /// 'normal' | 'high' � high sorts first and renders with an accent.
  priority String @default("normal")

  /// Who caused it (null for system-generated).
  actorId   String?
  actorName String?

  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  metadata Json?

  /// Idempotency key for emitters that may fire more than once for the same
  /// event (retries, a re-run day-close). Unique per recipient, so re-emitting
  /// updates rather than duplicating.
  dedupeKey String?

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, dismissedAt, createdAt])
  @@index([userId, readAt])
  @@index([entityType, entityId])
}

// ============================================================================
// SPECIAL REQUESTS � branch �  manager �  area �  head office
// ============================================================================

/// What a branch is asking for. `diamond_rate` is the one with a side effect:
/// approving it writes the new rate into the DiamondRate table.
enum SpecialRequestKind {
  diamond_rate
  price_override
  stock_transfer
  purchase
  expense
  staff
  other
}

enum SpecialRequestStatus {
  pending
  /// Raised above the approver it first landed on.
  escalated
  approved
  rejected
  /// Withdrawn by the branch that raised it.
  cancelled
}

/// A request a branch raises to someone above it.
///
/// Distinct from a Ticket: a ticket reports a PROBLEM to be worked (IT, HR,
/// maintenance, logistics) and is closed when fixed. A special request asks for
/// a DECISION � approve or reject � and carries an approver level, a decision
/// record and, for diamond rates, a side effect on approval.
model SpecialRequest {
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id])
  id             String             @id @default(cuid())
  ref            String             @unique
  storeId        String
  kind           SpecialRequestKind
  title          String
  details        String?

  /// Money at stake, when there is any. Feeds the escalation ladder � a bigger
  /// ask needs a more senior approver.
  amount   Decimal?             @db.Decimal(14, 2)
  priority TicketPriority       @default(medium)
  status   SpecialRequestStatus @default(pending)
  /// The date the branch needs an answer by; drives the overdue flag.
  neededBy DateTime?            @db.Date

  requestedById   String
  requestedByName String?
  requestedRole   Role
  /// Minimum role that may decide this. Always at least one rank above the
  /// requester, so nobody can approve their own request.
  requiredRole    Role

  decidedById   String?
  decidedByName String?
  decidedRole   Role?
  decidedAt     DateTime?
  decisionNote  String?

  // --- diamond_rate payload -------------------------------------------------
  /// Diamond spec/code the rate applies to (matches DiamondRate.spec).
  diamondSpec           String?
  /// The rate in force when the request was raised, snapshotted for the approver.
  currentRatePerCarat   Decimal? @db.Decimal(12, 2)
  requestedRatePerCarat Decimal? @db.Decimal(12, 2)
  /// DiamondRate row written when an approved rate request was applied.
  appliedRateId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store                   @relation(fields: [storeId], references: [id])
  requestedBy User                    @relation("SpecialRequestRequester", fields: [requestedById], references: [id])
  messages    SpecialRequestMessage[]

  @@index([storeId, createdAt])
  @@index([status, requiredRole])
  @@index([requestedById])
  @@index([organisationId])
}

/// One message on a special request's thread, so the approver can ask for
/// context without the request bouncing between statuses.
model SpecialRequestMessage {
  id         String   @id @default(cuid())
  requestId  String
  authorId   String?
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  request SpecialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// ============================================================================
// MODULE 14 � RETURNS & EXCHANGE (partial legacy: JewelTrans return variant)
// ============================================================================

model ReturnRecord {
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  id             String         @id @default(cuid())
  ref            String         @unique
  storeId        String
  partyId        String?
  saleId         String?
  customerName   String
  phone          String?
  type           ReturnType
  item           String?
  /// Estimated value / trade-in value (INR).
  value          Decimal?       @db.Decimal(14, 2)
  weightGrams    Decimal?       @db.Decimal(12, 3)
  settlement     SettlementType @default(credit_note)
  status         ReturnStatus   @default(draft)
  reason         String?
  /// Approver's note on the approve/reject decision � surfaced back to the requester.
  decisionNote   String?
  raisedBy       String?
  /// User id of whoever raised the return. `raisedBy` alone is a display name,
  /// which cannot be compared against the approver � so self-approval could not
  /// be detected. Nullable for rows created before this existed.
  raisedById     String?

  // Round 2: By-Invoice vs By-Manual intake toggle.
  /// 'invoice' = pulled from a Gati bill, 'manual' = typed.
  entryMode String? @default("manual")
  /// Source invoice number when entryMode = 'invoice'.
  invoiceNo String?

  // Module 14 � exchange / buyback calculator (all additive, nullable).
  // Original purchase inputs (manager keys these from the old bill):
  purchaseGoldWtG       Decimal? @db.Decimal(12, 3)
  purchaseGoldRate      Decimal? @db.Decimal(12, 2)
  purchaseDiaCarat      Decimal? @db.Decimal(10, 3)
  purchaseDiaRate       Decimal? @db.Decimal(12, 2)
  diaSpec               String?
  purchaseMaking        Decimal? @db.Decimal(14, 2)
  /// Purchase discount type: 'percent' | 'value' | 'piece'
  purchaseDiscountType  String?
  /// Purchase discount amount or percentage
  purchaseDiscountValue Decimal? @db.Decimal(14, 2)
  // Resolved "today" rates + computed option values (snapshot at intake):
  todayGoldRate         Decimal? @db.Decimal(12, 2)
  todayDiaRate          Decimal? @db.Decimal(12, 2)
  exchangeValue         Decimal? @db.Decimal(14, 2)
  buybackValue          Decimal? @db.Decimal(14, 2)
  /// 'exchange' | 'buyback' � which option the customer took.
  chosenOption          String?

  // Legacy provenance (JewelTrans return-type doc).
  legacyId        String?
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store         @relation(fields: [storeId], references: [id])
  party  Party?        @relation(fields: [partyId], references: [id])
  sale   Sale?         @relation(fields: [saleId], references: [id])
  photos ReturnPhoto[]

  @@unique([organisationId, legacyId])
  @@index([storeId, createdAt])
  @@index([status])
  @@index([organisationId])
}

/// Photo-based intake (Module 14) � file in object storage, URL only here.
model ReturnPhoto {
  id        String   @id @default(cuid())
  returnId  String
  url       String
  label     String?
  createdAt DateTime @default(now())

  returnRecord ReturnRecord @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

/// HO-set diamond rate table for the Module 14 exchange/buyback calculator.
/// Unlike gold (daily, MetalRate) this changes only every 3-6 months and is keyed
/// by diamond spec / internal code (e.g. "1ct", "20cent"). Optional per-store override.
model DiamondRate {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  spec           String
  ratePerCarat   Decimal      @db.Decimal(12, 2)
  effectiveFrom  DateTime
  storeId        String?
  createdAt      DateTime     @default(now())

  @@index([spec, effectiveFrom])
  @@index([organisationId])
}

// ============================================================================
// MODULE 15 � DISCOUNT MANAGEMENT (partial legacy: DiscountMarkupMst)
// ============================================================================

model DiscountRequest {
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  id             String         @id @default(cuid())
  ref            String         @unique
  storeId        String
  customerName   String
  item           String?
  /// Requested discount as percentage and/or absolute amount (legacy single figure).
  percent        Decimal?       @db.Decimal(5, 2)
  amount         Decimal?       @db.Decimal(14, 2)
  /// Module 15 split caps: requested DIAMOND / MAKING discount percentages. Gold is never discounted.
  diamondPercent Decimal?       @db.Decimal(5, 2)
  makingPercent  Decimal?       @db.Decimal(5, 2)
  /// Snapshot of the piece's selling price (INR) at request time (from Gati / Product).
  sellingPrice   Decimal?       @db.Decimal(14, 2)
  /// Snapshot of the piece's cost price (INR). Never surfaced to store_manager or below.
  costPrice      Decimal?       @db.Decimal(14, 2)
  /// Margin-impact preview snapshot (INR) shown before approval.
  marginImpact   Decimal?       @db.Decimal(14, 2)
  status         DiscountStatus @default(pending)
  reason         String?
  /// Approver's note on the approve/reject decision � surfaced back to the requester.
  decisionNote   String?

  requestedById String?
  requestedRole Role?
  /// Module 15: the minimum role that must approve this request (set on escalation).
  requiredRole  Role?
  approvedById  String?
  approvedRole  Role?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store @relation(fields: [storeId], references: [id])
  requestedBy User? @relation("DiscountRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("DiscountApprover", fields: [approvedById], references: [id])
  /// The manual sale this request authorised (Module 15 direct-sale over-cap flow), if any.
  sale        Sale? @relation("SaleDiscount")

  @@index([storeId, createdAt])
  @@index([status])
  @@index([organisationId])
}

