/// CaratOS import-engine provenance + reconciliation record. One row per import
/// run (Excel/CSV upload, later a connector sync): what source, which entity,
/// and the reconciliation counts so nothing is ever silently dropped.
model ImportBatch {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id])
  /// Effective branch target resolved from the authenticated principal. Null is
  /// an organisation-wide/head-office import, never an omitted client choice.
  targetStoreId      String?
  targetStore        Store?       @relation("ImportBatchTargetStore", fields: [targetStoreId], references: [id], onDelete: SetNull)
  /// 'csv' | 'excel' | connector source system.
  sourceSystem       String
  /// Canonical entity imported, e.g. 'customers'.
  entity             String
  fileName           String?
  /// 'running' | 'completed' | 'needs_review' | 'failed'.
  status             String       @default("completed")
  discovered         Int          @default(0)
  imported           Int          @default(0)
  updated            Int          @default(0)
  skipped            Int          @default(0)
  failed             Int          @default(0)
  duplicate          Int          @default(0)
  createdById        String?
  /// SHA-256 idempotency key supplied by an enrolled Connect agent. Human file
  /// imports leave it null. The unique scope makes a committed response safe to
  /// replay after a network timeout without applying the same snapshot twice.
  runKey             String?
  profileId          String?
  profileHash        String?
  sourceInstanceHash String?
  /// Opaque server-issued Connect configuration generation used for this
  /// machine receipt. Human file imports leave it null.
  configRevision     String?
  payloadHash        String?
  /// Short-lived ownership for crash recovery. Only the worker holding this
  /// token may refresh or finalise a machine receipt.
  leaseToken         String?
  leaseExpiresAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  parties            Party[]
  products           Product[]
  stores             Store[]      @relation("ImportBatchCreatedStores")

  @@unique([organisationId, sourceSystem, entity, runKey])
  @@index([organisationId, createdAt])
  @@index([organisationId, targetStoreId, createdAt])
}

/// A private reference file supplied to the AI CRM knowledge library. The
/// original binary is held outside the public media tree; extracted text is
/// split into chunks so retrieval never has to scan a whole document body.
model KnowledgeDocument {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id])
  title            String
  originalFileName String
  mimeType         String
  sizeBytes        Int
  sha256           String
  storageKey       String
  /// uploaded | extracting | ready | needs_ocr | needs_conversion | failed
  status           String       @default("uploaded")
  extractionMethod String?
  extractedChars   Int          @default(0)
  error            String?
  uploadedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  chunks KnowledgeChunk[]

  @@unique([organisationId, sha256])
  @@index([organisationId, status, createdAt])
}

/// Searchable text window extracted from one knowledge document. Embeddings can
/// be added later without changing the upload/extraction contract.
model KnowledgeChunk {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  content        String
  charStart      Int
  charEnd        Int
  createdAt      DateTime          @default(now())

  @@unique([documentId, chunkIndex])
  @@index([organisationId, documentId])
}

/// Region / Area grouping so area-manager and head-office roles roll up.
model Region {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  name           String
  code           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stores Store[]

  @@unique([organisationId, code])
  @@index([organisationId])
}

/// A physical store / branch. Legacy: a PartyMst row with IsLocation/IsFactory.
model Store {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  name           String
  city           String
  code           String?
  regionId       String?
  isActive       Boolean      @default(true)
  /// Lifecycle: pending (auto-detected, awaiting HO/AM setup) | active | closed.
  /// Kept in sync with isActive in code: active => isActive true; pending/closed => false.
  status         String       @default("active")
  /// true only for the synthetic "All Stores" aggregate the UI shows to broad roles.
  isAggregate    Boolean      @default(false)
  /// A non-physical reconciliation bucket for imported rows whose source branch
  /// cannot yet be resolved. It stays inside backend store scope so the rows are
  /// never lost, but must never be presented or operated as a real branch.
  isHolding      Boolean      @default(false)
  /// An attendance-only location (e.g. Head Office): staff are rostered and
  /// punch here, but it is not a trading branch — no sales, stock, targets,
  /// footfall or DSR, and it is left out of store KPIs.
  attendanceOnly Boolean      @default(false)
  /// HR has entered this location's weekly offs, holidays, shifts and grace
  /// minutes and confirmed them complete through this date. For any later date
  /// (or while null) an unpunched day stays "not marked" — never an automatic
  /// "absent" — because none of those rules can be inferred from the data.
  attendanceRulesConfirmedThrough DateTime? @db.Date

  // Geofence for HRMS geo-attendance (Module 6).
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  geofenceRadiusM Int?     @default(150)
  /// Weekly off day for this store (0=Sunday ⬦ 6=Saturday), set by HO (Module 6).
  weekOffDay      Int?
  /// IANA timezone of the store's physical location. EVERY attendance/shift
  /// calculation is done in this zone � punch instants are stored in UTC but the
  /// business date, lateness vs "HH:MM" shift times, and week-off day are all
  /// resolved store-locally. Never compare a stored UTC instant to a shift string
  /// without going through `common/tz.util.ts`.
  timezone        String   @default("Asia/Kolkata")

  // Office address + contact, imported from the PartyMst branch row.
  //
  // Held on Store rather than looked up through Party because a branch's own
  // address is operational data the app prints on documents and shows on the
  // store profile � it must survive even if the party link is later re-pointed.
  // Note the legacy system has NO coordinates anywhere, so latitude/longitude
  // above cannot be imported and must be set per store before geo-attendance
  // works; `GET /stores/geo-readiness` reports which are still missing.
  addressLine1 String?
  addressLine2 String?
  state        String?
  pincode      String?
  country      String?
  phone        String?
  email        String?
  gstin        String?

  // Legacy provenance (PartyMst branch/location row).
  legacyId        String?
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region                Region?                    @relation(fields: [regionId], references: [id])
  userStores            UserStore[]
  parties               Party[]
  products              Product[]
  stockItems            StockItem[]
  transfersFrom         StockTransfer[]            @relation("StockTransferFrom")
  transfersTo           StockTransfer[]            @relation("StockTransferTo")
  leads                 Lead[]
  quotes                Quote[]
  sales                 Sale[]
  manufacturingOrders   ManufacturingOrder[]
  customOrders          CustomOrder[]
  ledgerEntries         LedgerEntry[]
  payments              Payment[]
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  regularizations       AttendanceRegularization[]
  shifts                Shift[]
  holidays              StoreHoliday[]
  checkIns              CheckIn[]
  schemeMembers         SchemeMember[]
  tickets               Ticket[]
  returns               ReturnRecord[]
  discountRequests      DiscountRequest[]
  campaignStores        CampaignStore[]
  dailyReports          DailyReport[]
  salesTargets          SalesTarget[]
  handoffs              Handoff[]
  specialRequests       SpecialRequest[]
  // CaratOS Phase A3.
  activityEvents        ActivityEvent[]
  conversations         Conversation[]
  productInteractions   ProductInteraction[]
  responseSlas          ConversationResponseSla[]
  scheduledReports      ScheduledReport[]
  /// Phase A7 — the file or Connect import run that created this row. Later
  /// updates do not rewrite creation provenance; legacyId identifies its source.
  importBatchId         String?
  importBatch           ImportBatch?               @relation("ImportBatchCreatedStores", fields: [importBatchId], references: [id])
  targetedImportBatches ImportBatch[]              @relation("ImportBatchTargetStore")
  connectAgents         ConnectAgent[]
  leadForms             LeadForm[]
  loyaltyAccounts       LoyaltyAccount[]
  loyaltyLedgerEntries  LoyaltyLedgerEntry[]
  messagingRoutes       StoreMessagingRoute[]

  @@unique([organisationId, legacyId])
  @@unique([organisationId, code])
  @@index([regionId])
  @@index([organisationId])
  @@index([organisationId, isHolding, status])
}

/// Application user (staff login). Legacy: SPM_Users (logins only).
model User {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  name           String
  /// The LOGIN ID — an identifier, not a mailbox. Generated for new staff from
  /// the tenant's template or the default `firstname.storeslug@<tenant domain>`
  /// (see users.util.renderLoginId); stored values are never rewritten.
  email          String       @unique
  /// The personal/contact email the person actually gave. NOT unique � two people
  /// may legitimately share one (a family inbox, a store address) � and never used
  /// to sign in. Purely for reaching them.
  contactEmail   String?
  initials       String?
  phone          String?
  passwordHash   String?
  isActive       Boolean      @default(true)

  /// Primary role. Cross-store scope is derived from UserStore rows + role rank.
  role Role @default(salesperson)

  /// Head office's changes to what this person may open, on top of their
  /// role's defaults (auth/access.ts): `{ "<screen>": "none" | "own" | "store" }`.
  /// Null = the role's defaults exactly.
  accessOverrides Json?

  /// Self-signup approval workflow. Self-registered users start `pending` +
  /// `isActive=false` and hold NO role/store until an authorised approver grants
  /// it: the requested role/store are only a request, never access. `head_office`
  /// approves store/area-manager requests; a store/area manager approves the
  /// salesperson requests inside their own scope (strictly-below-rank rule).
  approvalStatus   ApprovalStatus @default(approved)
  /// The role the signup asked for (never granted until approval). Placeholder
  /// `role` stays `salesperson` meanwhile so a bug can never leak privilege.
  requestedRole    Role?
  /// The store the signup asked to join (validated + scope-checked at approval).
  requestedStoreId String?
  approvedById     String?
  approvedAt       DateTime?
  /// Who declined a self-signup, when, and why. A rejection is terminal for
  /// that request: the row never becomes approvable or activatable again, and
  /// the person re-applies as a fresh request (see users.util REAPPLICATION).
  rejectedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?

  /// Google's `sub`, set on first Google sign-in. Matched on instead of email
  /// because emails get recycled. Null for OTP/password-only users.
  googleSub String? @unique

  // Optional link to the party/staff master row.
  partyId String? @unique

  /// Legacy provenance for staff imported from the client's system (a PartyMst
  /// row with IsSalesMan, or an SPM_Users login). Set only on imported staff.
  ///
  /// Imported staff arrive **inactive and without a passwordHash** � they can be
  /// seen and assigned, but cannot sign in until head office activates them and
  /// issues credentials. Auto-creating working logins from legacy rows would mint
  /// accounts whose role mapping is guessed and whose owner may have left the
  /// business years ago.
  legacyId        String?
  legacyUpdatedAt DateTime?

  /// Welcome-guide progress, held per ACCOUNT rather than per browser so it
  /// follows the person to the shop tablet and back. `tourViews` counts how many
  /// times the guide has opened by itself; once it reaches the cap in
  /// onboarding.service.ts it stops doing so. `tourDoneAt` retires it early �
  /// set when the user finishes it or picks "Don't show this again".
  tourViews  Int       @default(0)
  tourDoneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party                 Party?               @relation(fields: [partyId], references: [id])
  userStores            UserStore[]
  ownedLeads            Lead[]               @relation("LeadOwner")
  leadNotes             LeadNote[]
  followUpsDone         LeadFollowUp[]       @relation("FollowUpDoneBy")
  followUpsAssigned     LeadFollowUp[]       @relation("FollowUpAssignee")
  quotes                Quote[]
  discountRequested     DiscountRequest[]    @relation("DiscountRequester")
  discountApproved      DiscountRequest[]    @relation("DiscountApprover")
  ticketMessages        TicketMessage[]
  assignedTickets       Ticket[]             @relation("TicketAssignee")
  commissions           Commission[]
  leaveBalances         LeaveBalance[]
  auditLogs             AuditLog[]           @relation("UserAuditLogs")
  salesTargets          SalesTarget[]        @relation("UserSalesTargets")
  notifications         Notification[]       @relation("UserNotifications")
  specialRequests       SpecialRequest[]     @relation("SpecialRequestRequester")
  whatsappIdentities    WhatsAppIdentity[]
  whatsappLinkCodes     WhatsAppLinkCode[]
  // CaratOS Phase A3 — named back-relations for the CRM spine.
  activityEvents        ActivityEvent[]      @relation("ActivityActor")
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  authoredMessages      Message[]            @relation("MessageAuthor")
  productInteractions   ProductInteraction[] @relation("ProductInteractionUser")
  assignedTasks         Task[]               @relation("TaskAssignee")

  resolvedRoutingConflicts ConversationRoutingConflict[] @relation("RoutingConflictResolver")
  aiDraftsReviewed         AiDraftRecord[]               @relation("AiDraftReviewer")
  checkInsAttended         CheckIn[]                     @relation("CheckInAttendedBy")
  checkInFollowUpsOwned    CheckIn[]                     @relation("CheckInFollowUpOwner")
  partiesArchived          Party[]                       @relation("PartyArchivedBy")
  staffDigestRuns          StaffDigestRun[]              @relation("StaffDigestRecipient")
  slaResponses             ConversationResponseSla[]     @relation("SlaResponder")
  weekOffs                 StaffWeekOff[]
  compensation             StaffCompensation?
  employeeProfile          EmployeeProfile?  @relation("EmployeeProfileUser")
  shiftAssignments         ShiftAssignment[]
  payslips                 Payslip[]
  quotesApprovalRequested  Quote[]                       @relation("QuoteApprovalRequestedBy")
  quotesApprovalDecided    Quote[]                       @relation("QuoteApprovalDecidedBy")
  callsHandled             CallLog[]                     @relation("CallLogAgent")

  @@unique([organisationId, legacyId])
  @@index([role])
  @@index([organisationId])
}

/// User <-> Store assignment. A salesperson maps to one store; area/HO map to many
/// (or to a Region) so their dashboards roll up. RBAC + store-scoping (see eclat-schema.md).
/// One row per scheduled-job execution, and the guard that keeps it to one.
///
/// The unique key is the whole point: the cron fires on every API instance, so
/// two replicas would otherwise both close the same day. Whoever inserts the row
/// first owns the run; the loser gets a unique-violation and skips. It doubles as
/// the answer to "did last night's day-close actually happen?", which previously
/// had no record anywhere.
model ScheduledJobRun {
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  id             String        @id @default(cuid())
  /// Job name, e.g. "attendance.day-close".
  job            String
  /// What it ran for � a storeId, or "global" for jobs that are not per-store.
  scope          String
  /// The business key that must run at most once, e.g. the store-local date.
  runKey         String

  /// running | ok | failed
  status    String    @default("running")
  detail    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@unique([job, scope, runKey])
  @@index([job, startedAt])
  @@index([organisationId])
}

model UserStore {
  id        String  @id @default(cuid())
  userId    String
  storeId   String
  /// Optional per-assignment role override (else falls back to User.role).
  role      Role?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

/// One-time WhatsApp sign-in code (POST /auth/otp/request|verify). `phone` is the
/// NORMALIZED last-10-digit Indian mobile. Only the bcrypt hash of the 6-digit
/// code is stored; rows are rate-limit evidence too (5/phone/hour, 60s cooldown).
model LoginOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// A verified binding between a WhatsApp number and a store user (the internal
/// reporting bot — see docs/modules/10-whatsapp-bot.md). Kept SEPARATE from
/// User.phone so OTP login is untouched and unbinding is auditable. The bot
/// resolves an inbound sender to a user ONLY through an `active` row here — the
/// raw `from` number is never trusted on its own.
///
/// `organisationId` is the user's tenant, stamped at link time. Every DSR the
/// bot writes and every notification it fans out is scoped to this organisation,
/// so a linked number can never reach another tenant's stores or reports.
model WhatsAppIdentity {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  userId         String
  /// E.164 without the leading '+', matching Meta's inbound `from` and
  /// WhatsAppService.normalise (e.g. "919876543210"). Globally unique: a physical
  /// number belongs to at most one person across the whole platform.
  phoneE164      String       @unique
  /// active | revoked. (A binding is only ever created once verified.)
  status         String       @default("active")
  verifiedAt     DateTime?
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organisationId])
}

/// Every inbound webhook message, stored BEFORE it is processed.
///
/// Meta expects a 200 within seconds and retries for up to ~7 days otherwise, so
/// the webhook persists and acknowledges first and processes after. `wamid` is
/// Meta's message id and is unique here: a retried delivery collides and is
/// skipped, which is what stops one message becoming two daily reports.
///
/// `organisationId` is NULL at arrival — an inbound message from an unknown or
/// not-yet-linked number has no tenant. It is stamped once the sender resolves to
/// a linked user at processing time; unresolved messages stay org-less (honest),
/// never guessed onto a tenant.
model WhatsAppEvent {
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  id             String        @id @default(cuid())
  /// Meta's message id ("wamid.xxx"). The idempotency key.
  wamid          String?       @unique
  direction      String        @default("inbound")
  phoneE164      String
  /// Resolved at processing time, when the sender is a linked user.
  userId         String?
  messageType    String        @default("text")
  body           String?
  payload        Json
  /// received | processed | ignored | failed
  status         String        @default("received")
  error          String?
  attempts       Int           @default(0)
  processedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([phoneE164, createdAt])
  @@index([organisationId])
}

/// Where a conversation with the bot has got to. WhatsApp is stateless
/// request/response, but a daily report is ten questions, so the answers so far
/// live in `draft` until the user confirms and the row is written. One live
/// session per number; it expires so an abandoned half-report never resurfaces
/// days later as if it were today's. `organisationId` is the resolved user's
/// tenant — a session only ever exists for a linked user.
model WhatsAppSession {
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  id             String        @id @default(cuid())
  phoneE164      String        @unique
  userId         String?
  /// idle | dsr | dsr_confirm | message | pick_store
  flow           String        @default("idle")
  /// Index into the flow's question list.
  step           Int           @default(0)
  /// Answers collected so far, keyed by DailyReport field name.
  draft          Json?
  storeId        String?
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([expiresAt])
  @@index([organisationId])
}

/// One-time code that links a WhatsApp number to a user. The user starts the
/// link in-app (POST /whatsapp/link/start), which shows this code; they send it
/// to the bot from the number they want to bind, proving control of that number.
/// Only the bcrypt hash is stored; short TTL, single-use (mirrors LoginOtp).
/// `organisationId` is the requesting user's tenant.
model WhatsAppLinkCode {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  userId         String
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organisationId])
}

/// Per-role discount approval ceiling (Module 15). e.g. salesperson <= 2%, SM <= 5%.
/// Optionally scoped to a store/region; null scope = global default.
model DiscountLimit {
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id])
  id                String       @id @default(cuid())
  role              Role
  storeId           String?
  /// Single overall cap. Discount requests and direct sales use the split caps
  /// below; a QUOTE discount (one % off making + diamond) is judged against this.
  maxPercent        Decimal      @db.Decimal(5, 2)
  /// Module 15: max self-approvable DIAMOND discount for this role (e.g. 5.00 = 5%). Gold is never discounted.
  maxDiamondPercent Decimal?     @db.Decimal(5, 2)
  /// Module 15: max self-approvable MAKING-charge discount for this role (e.g. 10.00 = 10%).
  maxMakingPercent  Decimal?     @db.Decimal(5, 2)
  /// Optional absolute ceiling in INR.
  maxAmount         Decimal?     @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, role, storeId])
  @@index([organisationId])
}

/// Pre-configured discount rules/codes dropdown (Module 15 client requirement: 45-50 codes).
model DiscountPreset {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  code           String
  name           String
  diamondPercent Decimal?     @db.Decimal(5, 2)
  makingPercent  Decimal?     @db.Decimal(5, 2)
  overallPercent Decimal?     @db.Decimal(5, 2)
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([organisationId, code])
  @@index([organisationId])
}

// ============================================================================
// PARTY HUB (Module 1 customers, suppliers, staff) � legacy PartyMst
// ============================================================================

/// Universal party master mirroring legacy PartyMst (role flags -> `types`).
model Party {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  storeId        String?
  name           String
  legalName      String?
  code           String?
  /// Which roles this party plays (customer / supplier / staff / salesperson ...).
  types          PartyType[]

  phone        String?
  whatsapp     String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String? @default("India")
  pincode      String?

  gstin   String?
  pan     String?
  aadhaar String?

  birthday    DateTime? @db.Date
  anniversary DateTime? @db.Date

  creditLimit   Decimal? @db.Decimal(14, 2)
  isBlacklisted Boolean  @default(false)

  /*
   * Archived — taken out of the working lists, NOT deleted.
   *
   * The meeting asked to "delete blocked contacts". Deleting is the one thing
   * this must not do. A person who sent STOP is remembered BY their record: the
   * consent events, the opt-out, the blacklist flag and the delivery history all
   * hang off this row. Remove it and the next inbound message from that number
   * resolves to a brand-new customer with no opt-out on it, and the system
   * cheerfully messages someone who told it to stop.
   *
   * So archiving hides, and identity resolution deliberately still finds
   * archived rows — that is what keeps the refusal attached to the person.
   */
  archivedAt     DateTime?
  archivedById   String?
  archivedBy     User?     @relation("PartyArchivedBy", fields: [archivedById], references: [id])
  /// Why, in the archiver's own words. Required by the API, not by the column,
  /// because rows written before this existed have no reason to give.
  archiveReason  String?

  // Legacy provenance (PartyMst.PartyNo).
  legacyId        String?
  legacyUpdatedAt DateTime?

  /// Tenant-defined custom attribute values, keyed by AttributeDefinition.key
  /// (entity='party'). Industry vocabulary lives here instead of in new columns, so
  /// a pharmacy's `composition` and a textile's `gsm` need no migration.
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store               Store?               @relation(fields: [storeId], references: [id])
  user                User?
  leads               Lead[]
  quotes              Quote[]
  sales               Sale[]
  manufacturingOrders ManufacturingOrder[]
  customOrders        CustomOrder[]
  ledgerEntries       LedgerEntry[]
  payments            Payment[]
  checkIns            CheckIn[]
  schemeMembers       SchemeMember[]
  returns             ReturnRecord[]

  contactPoints       ContactPoint[]
  mergePrimary        MergeCandidate[]     @relation("MergePrimary")
  mergeDuplicate      MergeCandidate[]     @relation("MergeDuplicate")
  activityEvents      ActivityEvent[]
  conversations       Conversation[]
  productInteractions ProductInteraction[]
  attributionTouches  AttributionTouch[]

  /// Phase A7 — the file or Connect import run that created this row. Later
  /// updates do not rewrite creation provenance; legacyId identifies its source.
  importBatchId      String?
  importBatch        ImportBatch?        @relation(fields: [importBatchId], references: [id])
  tasks              Task[]
  leadQualifications LeadQualification[]
  callLogs           CallLog[]
  feedbackRequests   FeedbackRequest[]
  loyaltyAccounts    LoyaltyAccount[]

  @@unique([organisationId, legacyId])
  @@index([storeId, createdAt])
  @@index([phone])
  @@index([organisationId])
  @@index([organisationId, archivedAt])
}

// ============================================================================
// MODULE 1 � CRM & LEADS (net-new; customer sourced from Party)
// ============================================================================

model Lead {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  ref            String       @unique
  storeId        String
  partyId        String?
  ownerId        String?

  customerName String
  phone        String?
  /// Estimated deal value (INR).
  value        Decimal?   @db.Decimal(14, 2)
  source       LeadSource
  stage        LeadStage  @default(inquiry)
  interest     String?
  lastActivity DateTime?

  /// Zoho-style closed-outcome tracking: 'open' | 'won' | 'lost' (validated in DTO).
  outcome    String    @default("open")
  lostReason String?
  closedAt   DateTime?

  // Round 2: CRM contact detail (all additive/optional).
  address     String?
  location    String?
  birthday    DateTime? @db.Date
  anniversary DateTime? @db.Date

  /// Tenant-defined custom attribute values, keyed by AttributeDefinition.key
  /// (entity='lead'). Industry vocabulary lives here instead of in new columns, so
  /// a pharmacy's `composition` and a textile's `gsm` need no migration.
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store     Store              @relation(fields: [storeId], references: [id])
  party     Party?             @relation(fields: [partyId], references: [id])
  owner     User?              @relation("LeadOwner", fields: [ownerId], references: [id])
  notes     LeadNote[]
  reminders OccasionReminder[]
  followUps LeadFollowUp[]
  quotes    Quote[]

  activityEvents      ActivityEvent[]
  productInteractions ProductInteraction[]
  attributionTouches  AttributionTouch[]
  tasks               Task[]
  leadQualifications  LeadQualification[]

  /// Stable identity of the AUTOMATIC ad interaction that opened this lead, so
  /// two concurrent deliveries of the same click cannot create two leads.
  /// `click:<ctwa_clid>` when the provider gave a click id, else
  /// `convo:<conversationId>`. NULL for every human-created lead, and Postgres
  /// treats NULLs as distinct — so this constrains ONLY auto-created leads and
  /// never limits how many opportunities a customer may legitimately have.
  originKey String?
  callLogs  CallLog[]
  tagAssignments LeadTagAssignment[]
  visits    CheckIn[] @relation("CheckInLead")

  @@unique([organisationId, originKey])
  @@index([storeId, createdAt])
  @@index([stage])
  @@index([ownerId])
  @@index([organisationId])
  /// Supports the lead-ageing SLA summary, which counts every open lead of a
  /// tenant in four `lastActivity` ranges rather than reading a capped page.
  /// Without this the four counts are four sequential scans of the whole table.
  @@index([organisationId, outcome, lastActivity])
}

/// Auto follow-up reminders for a lead (Module 1). SOP defaults: +7d (seq 1) and
/// +30d (seq 2) from lead creation; store manager can edit dates or mark done.
/// In-app only � no WhatsApp/push (see docs/CLIENT-CALL-2026-07.md, Module 1).
/// A lead-capture form a tenant embeds on its own website.
///
/// Deliberately a table and not a key in `Organisation.settings`: the public
/// submit endpoint has to find a form by its key with no tenant in hand, and
/// scanning every organisation's settings JSON to do that would be both slow and
/// exactly the modelling escape hatch the Organisation.settings comment forbids.
model LeadForm {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// The unguessable identifier that appears in the customer's page. Globally
  /// unique because the public endpoint resolves the tenant FROM it — a
  /// guessable or shared key would let anyone file leads into any tenant.
  publicKey String @unique

  /// Shown to staff only, so two forms can be told apart.
  name String

  /// Destination branch. Every lead needs one and a branch is never guessed, so
  /// this is required — an unrouted website form would produce leads nobody owns.
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  /// Used when the visitor leaves the enquiry box empty, so the lead still says
  /// what it was about.
  defaultInterest String?

  /// Declared campaign metadata. Never presented as measured attribution: the
  /// tenant typed it, the provider did not report it.
  campaign String?

  /// Origins permitted to submit, e.g. ["https://www.example.com"]. Empty means
  /// any origin, which is the honest default for a form whose whole job is to be
  /// embedded somewhere this system cannot see.
  allowedOrigins Json?

  /// The kill switch. A form that is turned off returns the same refusal as one
  /// that never existed, so probing cannot distinguish them.
  enabled Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organisationId])
  @@index([storeId])
}

model LeadFollowUp {
  id        String    @id @default(cuid())
  leadId    String
  storeId   String // denormalized for reminder scoping
  seq       Int // 1 = +7d SOP, 2 = +30d SOP (extensible)
  dueDate   DateTime  @db.Date
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneById  String?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  doneBy User? @relation("FollowUpDoneBy", fields: [doneById], references: [id])

  /// Three different things, kept apart. `dueDate` is the day the CUSTOMER is
  /// owed the call or visit; `reminderAt` is the instant the EMPLOYEE is told,
  /// resolved in the branch's timezone; the note is what was said. A reminder can
  /// fall before the due day (a heads-up) or on it.
  ///
  /// Who is reminded. Null means the lead's owner at the time the reminder fires.
  assigneeId String?
  assignee   User?   @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reminderAt DateTime?
  /// Set when the reminder went out, by a conditional claim, so two replicas or a
  /// retried sweep cannot both notify.
  reminderNotifiedAt DateTime?

  @@index([done, reminderNotifiedAt, reminderAt])

  @@index([storeId, done, dueDate])
  @@index([leadId])
}

/// A label a tenant puts on a lead, in the tenant's own words.
///
/// Deliberately NOT an enum and NOT a `isPotentialLead` boolean on Lead. The
/// meeting asked for "potential lead", but also asked for fields larger stores
/// can configure themselves — one tenant-defined tag list answers both, where a
/// hard-coded flag answers only the first and then has to be extended by a
/// migration every time somebody wants a second label.
///
/// This is NOT the same thing as ad-set routing tags. Those decide which branch
/// an inbound click belongs to and are written by the attribution engine; these
/// are written by a salesperson about a person they spoke to.
model LeadTag {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())

  name String
  /// Case- and space-normalised `name`, so "Potential Lead", "potential lead"
  /// and "Potential  Lead" cannot all exist side by side in one tenant.
  slug String

  /// A token name, not a raw hex value — the palette is the product's, so a tag
  /// stays legible when the theme changes underneath it.
  colour    String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments LeadTagAssignment[]

  /// Tenant-scoped, so two organisations may both have "Potential Lead".
  @@unique([organisationId, slug])
  @@index([organisationId, isActive, sortOrder])
}

/// One tag on one lead.
model LeadTagAssignment {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId  String
  tag    LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedById String?
  createdAt    DateTime @default(now())

  /// Applying a tag twice is the same tag, not two.
  @@unique([leadId, tagId])
  @@index([organisationId])
  @@index([tagId])
}

/// When a quote needs a manager's decision before it can leave the building.
///
/// The threshold is on the AMOUNT, not on a discount percentage. Discount caps
/// already live in DiscountLimit, per role and per store, and duplicating them
/// here would create a second answer to the same question — and the first thing
/// that drifts is the copy nobody can see. This gate answers a different
/// question: is this quote large enough that somebody senior should look at it.
model QuoteApprovalSettings {
  organisationId String       @id
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Quotes with a grand total at or above this need approval before sharing.
  /// NULL means no approval is ever required, which is the default and keeps
  /// every existing tenant behaving exactly as it did.
  valueThreshold Decimal? @db.Decimal(14, 2)

  /// Whether the person who asked may also decide. False by default: separation
  /// is the entire point of an approval step.
  allowSelfApproval Boolean @default(false)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// When, and whether, this tenant sends its staff their morning call list.
///
/// One row per organisation. Off by default: a system that starts messaging a
/// client's staff the moment it is deployed is a system nobody trusts again.
model StaffDigestSettings {
  organisationId String       @id
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  enabled Boolean @default(false)

  /// 0-23, read in each STORE's timezone rather than the tenant's. A chain with
  /// branches in two zones wants both to get it at nine in the morning where
  /// they are, not at nine in head office's morning.
  sendHourLocal Int @default(9)

  /// WhatsApp is a second, optional channel. The in-app notification always goes
  /// out; this only decides whether a message is also attempted.
  whatsappEnabled Boolean @default(false)

  /// Meta requires an approved template for a business-initiated message. With
  /// no template named here, the WhatsApp half is skipped and says so — it does
  /// not fall back to free text, which Meta would refuse anyway.
  templateName     String?
  templateLanguage String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One person's digest for one day.
///
/// The unique key on (userId, businessDate) is the idempotency guard: a
/// scheduler that fires twice, or a container that restarts mid-run, cannot send
/// somebody their list a second time.
model StaffDigestRun {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())

  userId String
  user   User   @relation("StaffDigestRecipient", fields: [userId], references: [id], onDelete: Cascade)

  /// The branch whose local morning this was.
  storeId String?

  businessDate DateTime @db.Date

  dueCount     Int @default(0)
  overdueCount Int @default(0)

  inAppNotified Boolean @default(false)

  /// 'skipped' | 'queued' | 'refused' (rows before the outbox: 'sent' | 'failed' | 'dead').
  ///
  /// `skipped` is a first-class outcome, not a failure: WhatsApp off for the
  /// tenant or no template configured. `refused` is the outbox declining before
  /// anything was queued — no usable staff number, a template the provider has
  /// not approved, a disconnected sender, an opt-out. `queued` means an outbox
  /// message exists; whether it was delivered is that message's status, never a
  /// copy kept here. The REASON is stored beside it so the settings screen can
  /// say which, instead of the team guessing why nobody got a message.
  whatsappStatus String  @default("skipped")
  whatsappReason String?
  /// The outbox Message carrying the WhatsApp half, once queued.
  whatsappMessageId String?

  /// Retries before the row is left as `dead`. A digest is worth very few — it
  /// is stale by lunchtime, and a queue that keeps retrying yesterday's list is
  /// worse than one that gives up and says so.
  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessDate])
  @@index([organisationId, businessDate])
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  authorId   String?
  authorName String?
  /// Activity kind: 'note' | 'call' | 'visit' | 'whatsapp' (validated in DTO).
  kind       String   @default("note")
  text       String
  createdAt  DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([leadId])
}

model OccasionReminder {
  id       String   @id @default(cuid())
  leadId   String
  occasion String
  date     DateTime @db.Date
  notified Boolean  @default(false)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([date])
}

// ============================================================================
// MODULE 2 � QUOTATION & PRICING (net-new; portable across stores)
// ============================================================================

/// Daily metal rate feed (Module 2 pricing source of truth � OP-2 open).
/// Legacy: RateDailyMst / MetalRateMst.
model MetalRate {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  metal          MetalKind
  /// INR per gram.
  ratePerGram    Decimal      @db.Decimal(12, 2)
  effectiveFrom  DateTime
  storeId        String?

  legacyId        String?
  legacyUpdatedAt DateTime?
  createdAt       DateTime  @default(now())

  @@unique([organisationId, legacyId])
  @@index([metal, effectiveFrom])
  @@index([organisationId])
}

model Quote {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  ref            String       @unique
  /// Store where the quote was raised.
  storeId        String
  partyId        String?
  leadId         String?
  assignedRepId  String?

  customerName String
  phone        String?
  status       QuoteStatus @default(draft)
  kind         QuoteKind   @default(sale)
  validUntil   DateTime?

  /// Round 2: free-text remarks (e.g. repair notes).
  remarks      String?
  /// Round 2: gross weight in grams for a repair quote (making-only).
  grossWeightG Decimal? @db.Decimal(10, 3)

  /// "@" kaccha provision: rough no-GST estimate. Hidden from the normal quote
  /// list and only reachable by head_office. Lightweight flag, not a separate DB.
  isKaccha Boolean @default(false)

  /// Money rollup snapshot (recomputed from lines, persisted for fast listing).
  /*
   * Approval.
   *
   * `approvedTotal` is the amount that was actually approved, snapshotted at the
   * moment of the decision. Sharing compares the CURRENT grand total against it
   * and refuses if they differ — otherwise a quote approved at one price could be
   * edited downward and sent, and the approval would be decoration.
   */
  requestedById  String?
  requestedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?
  approvedTotal  Decimal?  @db.Decimal(14, 2)

  /*
   * Discount: one percentage off making + diamond/stone charges together. Gold
   * is never discounted. Judged against DiscountLimit.maxPercent for the role of
   * whoever last PRICED the quote (`pricedByRole`), not whoever presses send.
   */
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  /// The discount as the salesperson gives it: a % off making, a % off
  /// diamonds and stones, and a flat amount off at the end. `discountPercent`
  /// above is what the three come to as one % of making + stones, the number
  /// the approval caps are judged on.
  makingDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  stoneDiscountPercent  Decimal @default(0) @db.Decimal(5, 2)
  additionalDiscount    Decimal @default(0) @db.Decimal(14, 2)
  pricedById      String?
  pricedByRole    Role?

  /// Content revision, bumped by every edit to lines, price, discount or
  /// validity. An approval is for one revision (`approvedRevision`).
  revision         Int   @default(1)
  approvedRevision Int?
  /// Why approval was needed, recorded when it was requested.
  approvalReasons  Json?
  /// What was approved: total, discount, revision and reasons at decision time.
  approvalSnapshot Json?

  requestedBy User? @relation("QuoteApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("QuoteApprovalDecidedBy", fields: [decidedById], references: [id])

  metalValue    Decimal @default(0) @db.Decimal(14, 2)
  makingCharges Decimal @default(0) @db.Decimal(14, 2)
  stoneCharges  Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  gstAmount     Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store                  @relation(fields: [storeId], references: [id])
  party            Party?                 @relation(fields: [partyId], references: [id])
  lead             Lead?                  @relation(fields: [leadId], references: [id])
  assignedRep      User?                  @relation(fields: [assignedRepId], references: [id])
  lines            QuoteLine[]
  photos           QuotePhoto[]
  /// Branches where this quote can be redeemed/checked out (portability).
  redeemableStores QuoteRedeemableStore[]

  @@index([storeId, createdAt])
  @@index([status])
  @@index([organisationId])
  @@index([organisationId, status])
}

/// Reference / repair photos attached to a quote (Round 2) � mirrors ReturnPhoto.
/// File lives in object storage, URL only here.
model QuotePhoto {
  id        String   @id @default(cuid())
  quoteId   String
  url       String
  label     String?
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

/// Stores where a quote is redeemable (quote at Store A -> buy at Store B).
model QuoteRedeemableStore {
  id      String @id @default(cuid())
  quoteId String
  storeId String

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, storeId])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  description String

  karat           Int
  /// Net metal weight in grams.
  weightGrams     Decimal  @db.Decimal(12, 3)
  /// Gold rate INR/g snapshotted at quote time.
  goldRatePerGram Decimal  @db.Decimal(12, 2)
  makingCharges   Decimal  @default(0) @db.Decimal(14, 2)
  stoneCharges    Decimal  @default(0) @db.Decimal(14, 2)
  /// Stone weight in carats (display).
  caratWeight     Decimal  @default(0) @db.Decimal(10, 3)
  /// Diamond rate per carat (INR/ct) snapshot.
  perCaratRate    Decimal? @db.Decimal(12, 2)

  /// The design this item was priced from, when there is one (StyleBom).
  styleNumber       String?
  /// The piece's size as the customer gives it: "12", "2.6", "16 inch", "5.5 cm".
  size              String?
  /// Item-master code of the metal (G14YG …) and its making rate per gram;
  /// making charges = rate x weight.
  metalCode         String?
  makingRatePerGram Decimal? @db.Decimal(12, 2)
  /// Diamonds (D) and colour stones (C), one entry per code and size:
  /// [{ type, code, name?, size?, pieces?, carats, ratePerCt, multiplier, amount }].
  /// The multiplier is the staff's pricing lever and never printed; the
  /// customer sees ratePerCt x multiplier as the rate.
  stones            Json?

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
}

// ============================================================================
// MODULE 5 + 9 � CATALOGUE / PRODUCT (Design) + STOCK (per-piece)
// ============================================================================

/// Item master used to price a quote: metals, diamonds, colour stones, charges
/// and item types, by the code the ERP uses (SJEP `SPM_Items`: G14YG,
/// LG-RND-VVS-E-F …; item types from `MainProduct`: ALR LADIES RING …). A quote
/// copies the code and name; nothing points back here, so a master edit never
/// changes a price already given.
model Material {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  code           String
  name           String
  /// metal | diamond | stone | charge | other | item_type
  kind           String
  /// ERP raw-material group: G, LG, LS, D, LGRB, PRL …
  groupCode      String?
  groupName      String?
  karat          Int?
  /// Metal tone (YG, WG, PG, W/YG) or diamond colour (E-F, D …).
  tone           String?
  shape          String?
  quality        String?
  /// Sale rate per carat by stone size group: { "<group>": rate }. Never cost.
  saleRates      Json?
  isActive       Boolean      @default(true)
  legacyId       String?
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, kind, code])
  @@index([organisationId, kind])
}

/// Stone sizes (SJEP `SizeMst`): the sieve or mm label and one stone's weight,
/// so pieces x caratPerPiece gives the carats.
model MaterialSize {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  code           String
  mm             String?
  caratPerPiece  Decimal?     @db.Decimal(8, 4)
  /// Rate-chart size group this size prices in (Material.saleRates key).
  sizeGroup      String?
  sortOrder      Int          @default(0)
  legacyId       String?

  @@unique([organisationId, code])
}

/// A design's default bill of materials (SJEP `StyleMst` + `StyleMstDetail`).
/// Entering the style number in a quote loads these lines, which the
/// salesperson then changes for the customer.
model StyleBom {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  styleCode      String
  /// Item-type code (ALR, APD …).
  itemType       String?
  itemSize       String?
  /// [{ code, size?, pieces?, weight }]
  lines          Json
  legacyId       String?
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, styleCode])
}

/// Product / design template. Legacy: StyleMst (design) blended with catalogue view.
model Product {
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  id             String          @id @default(cuid())
  storeId        String?
  sku            String
  name           String
  category       ProductCategory @default(other)
  metal          MetalKind
  /// Gold purity in karat (0 for platinum/silver-by-fineness).
  karat          Int             @default(0)
  /// Gross weight grams.
  weightGrams    Decimal         @default(0) @db.Decimal(12, 3)
  /// Diamond/gemstone weight carats.
  caratWeight    Decimal         @default(0) @db.Decimal(10, 3)
  /// Indicative retail price INR.
  price          Decimal         @default(0) @db.Decimal(14, 2)
  /// Distinguishes a real source zero from the legacy numeric placeholder.
  weightKnown    Boolean         @default(true)
  priceKnown     Boolean         @default(true)
  /// Landed cost price INR (from Gati). Module 15: visible only to area_manager/head_office; never to store_manager or below.
  costPrice      Decimal?        @db.Decimal(14, 2)
  availability   Availability    @default(in_stock)
  leadTimeDays   Int?
  description    String?
  bestSeller     Boolean         @default(false)
  /// Neutral ERP vocabulary retained alongside compatibility enums. These are
  /// intentionally optional so the existing Eclat jewellery pack is unchanged.
  categoryLabel  String?
  materialLabel  String?
  unitOfMeasure  String?

  /// The DESIGN, above the SKU.
  ///
  /// One style is made in several sizes and weights, each its own SKU and each
  /// its own piece on the shelf. "How is this design selling" and "how is this
  /// exact piece selling" are different questions, and until now only the second
  /// one could be asked. Free text because it is the supplier's vocabulary, not
  /// ours, and deliberately NOT unique: many products sharing a style number is
  /// the entire point.
  styleNumber    String?
  /// The design's code on the client's website (its `productCode`), when the
  /// website carries it. Kept separately because a Gati design matched to a
  /// website one keeps Gati's id in `legacyId` — without this the website code,
  /// and the fact that the design is on the website at all, was lost.
  websiteCode    String?
  /// What the design is made of — metal, diamonds, stones, making — as
  /// `{ source: 'gati'|'website', lines: [{ item, kind, weight?, unit?,
  /// pieces?, rate?, amount? }] }`. See src/products/composition.ts. Amounts
  /// are stripped from the API for anyone below store manager.
  composition    Json?
  /// Gati-owned HSN code for the design.
  hsn            String?
  /// Last time each source wrote this design (provenance shown in the detail).
  gatiSyncedAt    DateTime?
  websiteSyncedAt DateTime?

  /// Block 9 — the design's classification. A made-to-order design is
  /// `customised`, and every piece of it inherits that unless the piece says
  /// otherwise. Defaulted, so every existing design stays ordinary stock.
  stockClass     StockClass      @default(standard)

  // Image lives in object storage; only the URL is stored here.
  imageUrl String?
  stlUrl   String?

  // AI image search (Module 5). Float[] until pgvector is installed; then -> vector(N).
  // See header note + docs/eclat-schema.md for the pgvector upgrade migration.
  embedding Float[]

  // Legacy provenance (StyleMst.StyleId).
  legacyId        String?
  legacyUpdatedAt DateTime?

  /// Tenant-defined custom attribute values, keyed by AttributeDefinition.key
  /// (entity='product'). Industry vocabulary lives here instead of in new columns, so
  /// a pharmacy's `composition` and a textile's `gsm` need no migration.
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store               Store?               @relation(fields: [storeId], references: [id])
  stockItems          StockItem[]
  quoteLines          QuoteLine[]
  saleLines           SaleLine[]
  imageEmbeddings     ProductEmbedding[]
  /// Every photograph of this design. `imageUrl` above is the cover; this is
  /// the full set, and visual search matches against all of them.
  images              ProductImage[]
  variants            ProductVariant[]
  options             ProductOption[]
  prices              ProductPrice[]
  websiteListing      ProductWebsiteListing?
  // CaratOS Phase A3.
  productInteractions ProductInteraction[]
  /// Phase A7 — the file or Connect import run that created this row. Later
  /// updates do not rewrite creation provenance; legacyId identifies its source.
  importBatchId       String?
  importBatch         ImportBatch?         @relation(fields: [importBatchId], references: [id])

  @@unique([organisationId, sku])
  @@unique([organisationId, legacyId])
  @@index([organisationId, styleNumber])
  @@index([organisationId, websiteCode])
  @@index([storeId, createdAt])
  @@index([category])
  @@index([sku])
  @@index([organisationId])
}

/// Module 5 � dual visual embedding for one product image (DINOv3 + SigLIP 2).
///
/// One row per (product, preprocessingVersion). Kept in its own table (not on
/// Product) so re-indexing a model never rewrites the catalogue row, and so a
/// pgvector upgrade can swap the two Float[] columns for `vector(N)` + an HNSW
/// cosine index per column WITHOUT touching Product. Until pgvector is installed
/// on the target Postgres these stay `Float[]` and ranking runs in-app
/// (jewelry-ranking.service.ts). See prisma/manual/20260819_pgvector_dual_embeddings.sql.
model ProductEmbedding {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  productId      String
  /// Inherited from the product at index time so search can store-scope without a join.
  storeId        String?

  /// Which photograph this vector describes, when it came from the gallery.
  /// Null for a design whose only picture is the legacy `Product.imageUrl`.
  /// SET NULL rather than CASCADE so deleting a photo cannot silently take a
  /// vector with it mid-search; the next re-index prunes the orphan.
  productImageId String?
  productImage   ProductImage? @relation(fields: [productImageId], references: [id], onDelete: SetNull)

  /// DINOv3 patch/global embedding � structure & shape.
  dinoEmbedding   Float[]
  /// SigLIP 2 embedding � semantic / text-aligned appearance.
  siglipEmbedding Float[]

  /// Provenance so a model or pipeline upgrade auto-invalidates a stale row.
  dinoModelVersion     String @default("unknown")
  siglipModelVersion   String @default("unknown")
  preprocessingVersion String @default("unknown")
  /// sha256 of the source image bytes � the idempotency key for re-index skip.
  imageHash            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// One vector per IMAGE per pipeline version, not one per design.
  ///
  /// It used to be [productId, preprocessingVersion], which allowed a design
  /// exactly one embedding — so a ring photographed from the front, the side
  /// and on a hand could only ever be searchable from whichever angle was
  /// indexed last. imageHash is already the idempotency key for re-indexing,
  /// so it costs nothing to make it part of the identity too.
  @@unique([productId, imageHash, preprocessingVersion])
  @@index([storeId])
  @@index([organisationId])
  @@index([productImageId])
}

/// One photograph of a design. A jeweller shows a piece from several angles —
/// front, side, on the hand — and a customer photographs it from wherever they
/// happen to be standing; a catalogue holding one picture per design can only
/// ever match the one view somebody chose to upload.
model ProductImage {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Object-storage URL (R2 / Cloudinary), or a local /uploads path.
  url   String

  /// Which view this is: "front", "side", "on model", "CAD". Free text, not
  /// an enum — the useful list is the trade’s, not ours, and it differs by
  /// tenant. Null means nobody said, which is not the same as "front".
  angle String?

  /// The picture that represents the design in a grid. Not enforced unique in
  /// the database: two rows briefly both true during a re-order is harmless,
  /// and a partial unique index that blocks the intermediate state is not.
  /// The service clears the old cover in the same transaction as setting the
  /// new one.
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())


  /// Where the picture came from: gati_cad | website | manual | inventory | other.
  /// Drives the default order: an admin pin, else the Gati CAD, else website
  /// photos in source order, then the rest.
  source        String    @default("other")
  /// Set only by an explicit admin choice. `isPrimary` is the computed result.
  pinnedPrimary Boolean   @default(false)
  /// The URL the source published, and its own id for the picture if it has one.
  sourceUrl     String?
  sourceImageId String?
  /// Position within the source (website: order inside its colour group).
  sourceOrder   Int       @default(0)
  /// sha256 of the downloaded bytes; identical pictures under different URLs
  /// are one asset.
  contentHash   String?
  thumbUrl      String?
  width         Int?
  height        Int?
  /// active | tombstoned. A picture the source stopped publishing is kept as a
  /// tombstone (and dropped from search), never deleted outright.
  status        String    @default("active")
  tombstonedAt  DateTime?
  /// pending | queued | running | indexed | failed | dead | skipped
  embeddingStatus   String    @default("pending")
  embeddingVersion  String?
  embeddingError    String?
  embeddingAttempts Int       @default(0)
  embeddedAt        DateTime?

  updatedAt DateTime  @default(now()) @updatedAt

  embeddings   ProductEmbedding[]
  associations ProductImageAssociation[]

  @@index([productId, sortOrder])
  @@index([organisationId])
  @@index([organisationId, embeddingStatus])
  @@index([productId, contentHash])
}

/// Module 5 � relevance feedback on a jewelry similarity-search result.
/// Advisory training data: which returned hits the user judged close. Not linked
/// to a stored query (we never persist the uploaded photo); queryId is the opaque
/// id echoed from the search response.
model SimilaritySearchFeedback {
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id])
  id             String             @id @default(cuid())
  queryId        String
  productId      String
  storeId        String?
  rank           Int
  /// The closenessScore (0-100) the ranker gave this hit, for calibration analysis.
  score          Float
  feedback       SimilarityFeedback
  /// Ranking pipeline version + the model versions in play, so feedback stays
  /// interpretable after the ranker or models change.
  rankingVersion String
  modelVersions  Json
  createdAt      DateTime           @default(now())

  @@index([queryId])
  @@index([productId])
  @@index([organisationId])
}

/// A physical jewellery piece in stock. Legacy: Inward + InwardSummary (1:1 rollup).
/// All gold/diamond/stone weights and amounts live here as exact Decimals.
model StockItem {
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  id             String          @id @default(cuid())
  storeId        String
  productId      String?
  sku            String?
  name           String?
  category       ProductCategory @default(other)
  metal          MetalKind?
  karat          Int?

  status  StockStatus @default(in_stock)
  /// Days since inward, used for aging/dead-stock trackers (Module 9). Derived on write.
  ageDays Int?

  // --- Weights (grams) � from InwardSummary ---
  grossWeight     Decimal? @db.Decimal(12, 3)
  netWeight       Decimal? @db.Decimal(12, 3)
  pureWeight      Decimal? @db.Decimal(12, 3)
  metalLossWeight Decimal? @db.Decimal(12, 3)

  // --- Diamond / stone ---
  diamondWeightCt Decimal? @db.Decimal(10, 3)
  diamondPieces   Int?
  stoneWeightCt   Decimal? @db.Decimal(10, 3)

  // --- Amounts (INR) � from InwardSummary ---
  metalAmount   Decimal? @db.Decimal(14, 2)
  diamondAmount Decimal? @db.Decimal(14, 2)
  stoneAmount   Decimal? @db.Decimal(14, 2)
  makingAmount  Decimal? @db.Decimal(14, 2)
  cpfAmount     Decimal? @db.Decimal(14, 2)
  cost          Decimal? @db.Decimal(14, 2)
  mrp           Decimal? @db.Decimal(14, 2)
  tagPrice      Decimal? @db.Decimal(14, 2)

  /// The design this piece belongs to. Mirrored from the product at stock-in and
  /// carried here so a piece with no product link is still groupable by design.
  styleNumber   String?

  /// The piece's own identifier, generated by us.
  ///
  /// Every other code on a piece belongs to somebody else: the SKU is the
  /// design, the HUID is BIS's, the certificate number is the lab's, the legacy
  /// id is the old ERP's. None of them identifies THIS piece in a way we control
  /// — the SKU is shared across identical pieces, and the rest are absent until
  /// somebody else issues them.
  ///
  /// Nullable, because every piece that already exists has none and inventing
  /// them retroactively would put a number on a tag that the tag does not carry.
  vin           String?

  /// Block 9 — this piece's own classification. NULL means "whatever the design
  /// is", which is what every existing piece gets: one ring made for a customer
  /// on a standard design must be markable without reclassifying its siblings.
  stockClass     StockClass?

  /// A person has judged this piece worth remaking or customising rather than
  /// selling as it is. Set by hand, never inferred — a flag nobody decided would
  /// send a sellable piece to the melting pot.
  remakeSuitable Boolean     @default(false)

  hallmarkNo    String?
  /// BIS Hallmark Unique ID (6-char alphanumeric, one per hallmarked piece).
  /// Distinct from hallmarkNo (the BIS licence number). Entered at stock-in.
  huid          String?
  certificateNo String?
  imageUrl      String?
  inwardDate    DateTime?

  // --- Gati fields previously dropped by the sync -------------------------
  /// Ring/bangle size as Gati holds it (SizeNo / ItemSizeId).
  sizeLabel     String?
  itemSizeId    String?
  hsn           String?
  /// Gati ProductCode (the item-type code, not the style).
  productCode   String?
  quantity      Int?
  stonePieces   Int?
  /// The website variant this piece is, when the match is unambiguous.
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Legacy provenance (Inward.JewelId).
  legacyId        String?
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store         Store               @relation(fields: [storeId], references: [id])
  product       Product?            @relation(fields: [productId], references: [id])
  saleLines     SaleLine[]
  movements     StockMovement[]
  transferItems StockTransferItem[]

  @@unique([organisationId, legacyId])
  /// Unique per tenant. Two pieces with one VIN is the one thing that would make
  /// the number worthless.
  @@unique([organisationId, vin])
  @@index([storeId, createdAt])
  @@index([status])
  @@index([productId])
  @@index([sku])
  @@index([organisationId])
  @@index([organisationId, styleNumber])
}

/// Per-piece movement / location / status log. Legacy: InwardHistory (append-only).
model StockMovement {
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  id              String       @id @default(cuid())
  stockItemId     String
  fromStoreId     String?
  toStoreId       String?
  status          String?
  note            String?
  occurredAt      DateTime     @default(now())
  /// Links the movement to the inter-store transfer that produced it (Module 9).
  stockTransferId String?

  // Legacy provenance (InwardHistory.Id � append-only, watermark by Id).
  legacyId        String?
  legacyUpdatedAt DateTime?

  stockItem StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  transfer  StockTransfer? @relation(fields: [stockTransferId], references: [id])

  @@unique([organisationId, legacyId])
  @@index([stockItemId, occurredAt])
  @@index([stockTransferId])
  @@index([organisationId])
}

/// Module 9 � inter-store stock transfer (state machine). Source store submits � 
/// HO approves (pieces reserved) �  source dispatches �  destination receives (a
/// StockMovement is written and each piece is re-homed to the destination) � 
/// destination acknowledges. The ONLY inventory mutation is at receive.
model StockTransfer {
  organisationId String
  organisation   Organisation        @relation(fields: [organisationId], references: [id])
  id             String              @id @default(cuid())
  ref            String              @unique
  status         StockTransferStatus @default(draft)

  fromStoreId String
  toStoreId   String

  /// Rejection or cancellation reason, set on the terminal-negative transitions.
  reason String?

  // Actor id + timestamp per stage (ids only � names/roles resolved in the view).
  requestedById    String
  submittedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  dispatchedById   String?
  dispatchedAt     DateTime?
  receivedById     String?
  receivedAt       DateTime?
  acknowledgedById String?
  acknowledgedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromStore Store               @relation("StockTransferFrom", fields: [fromStoreId], references: [id])
  toStore   Store               @relation("StockTransferTo", fields: [toStoreId], references: [id])
  items     StockTransferItem[]
  movements StockMovement[]

  @@index([fromStoreId, createdAt])
  @@index([toStoreId, createdAt])
  @@index([status])
  @@index([organisationId])
}

/// One physical piece in a transfer. Snapshots sku/name so the request is
/// preserved even if the piece's metadata changes later. Unique per transfer.
model StockTransferItem {
  id          String  @id @default(cuid())
  transferId  String
  stockItemId String
  sku         String?
  name        String?

  transfer  StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem StockItem     @relation(fields: [stockItemId], references: [id])

  @@unique([transferId, stockItemId])
  @@index([stockItemId])
}

// ============================================================================
// SALES (Module 10 DSR source) � legacy JewelTrans + JewelTransInward
// ============================================================================

model Sale {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  storeId        String
  partyId        String?
  salesPersonId  String?

  docNo   String
  docType SaleDocType @default(sale)
  docDate DateTime

  grossAmount    Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)
  remarks        String?

  // Direct-sales (manual) capture for reporting + Module 12 payments-in-sales.
  // Additive: legacy-synced sales leave these null / default (isManual=false).
  /// Free-text customer name for a manual direct sale (when no linked Party).
  customerName    String?
  /// true = keyed by a store user via POST /sales (not sourced from the legacy sync).
  isManual        Boolean      @default(false)
  /// Advance payment method captured on the sale (Module 12 � folded into sales).
  paymentMode     PaymentMode?
  /// Advance amount received at sale time (INR). balance = totalAmount - advanceReceived.
  advanceReceived Decimal?     @db.Decimal(14, 2)
  /// Object-storage URL of the quotation photo given to the customer (Module 12).
  quotationUrl    String?
  /// Object-storage URL of the invoice photo (if the bill was made) (Module 12).
  invoiceUrl      String?

  // Module 15 � discount split captured on a manual sale so the configured
  // diamond/making caps are enforceable (gold is never discounted). Null on a
  // no-discount sale and on legacy-synced sales.
  diamondValue           Decimal? @db.Decimal(14, 2)
  makingValue            Decimal? @db.Decimal(14, 2)
  diamondDiscountPercent Decimal? @db.Decimal(5, 2)
  makingDiscountPercent  Decimal? @db.Decimal(5, 2)
  /// Set only for an OVER-cap sale whose discount was approved via a DiscountRequest.
  discountRequestId      String?  @unique

  /// Mirrors legacy soft-cancel (JewelTrans.isCancel) � do not hard-delete (audit).
  isCancelled   Boolean   @default(false)
  // Soft-void metadata (Phase 2). The row stays; reporting already excludes isCancelled.
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  // Legacy provenance (JewelTrans.JewelTransId).
  legacyId        String?
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store              Store              @relation(fields: [storeId], references: [id])
  party              Party?             @relation(fields: [partyId], references: [id])
  lines              SaleLine[]
  payments           Payment[]
  returns            ReturnRecord[]
  discountRequest    DiscountRequest?   @relation("SaleDiscount", fields: [discountRequestId], references: [id])
  attributionTouches AttributionTouch[]

  @@unique([storeId, docNo, docType])
  @@unique([organisationId, legacyId])
  @@index([storeId, docDate])
  @@index([docType])
  @@index([organisationId])
}

model SaleLine {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  saleId         String
  stockItemId    String?
  productId      String?
  description    String?

  netWeight      Decimal? @db.Decimal(12, 3)
  metalRate      Decimal? @db.Decimal(12, 2)
  metalAmount    Decimal? @db.Decimal(14, 2)
  makingAmount   Decimal? @db.Decimal(14, 2)
  stoneAmount    Decimal? @db.Decimal(14, 2)
  /// Old gold taken in part-exchange against this line. The legacy bill carries
  /// it as a component of the line total, so without a column of its own the
  /// line does not add up: metal + making + stone + exchange = lineTotal.
  exchangeAmount Decimal? @db.Decimal(14, 2)
  discountAmount Decimal? @db.Decimal(14, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(14, 2)

  // Legacy provenance (JewelTransInwardDetail composite key flattened).
  legacyId        String?
  legacyUpdatedAt DateTime?

  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id])
  product   Product?   @relation(fields: [productId], references: [id])

  @@unique([organisationId, legacyId])
  @@index([saleId])
  @@index([organisationId])
}

// ============================================================================
// MODULE 8 � TIMELINES: production orders + custom-order tracking
// ============================================================================

/// Manufacturing order. Legacy: Spm_MfgOrder (+ SPM_MfgOrderItem).
model ManufacturingOrder {
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id])
  id               String       @id @default(cuid())
  storeId          String
  partyId          String?
  orderNo          String
  orderDate        DateTime
  status           OrderStatus  @default(booked)
  amount           Decimal      @default(0) @db.Decimal(14, 2)
  poNo             String?
  expectedDelivery DateTime?

  // Legacy provenance (Spm_MfgOrder.OrderId).
  legacyId        String?
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store                    @relation(fields: [storeId], references: [id])
  party Party?                   @relation(fields: [partyId], references: [id])
  items ManufacturingOrderItem[]
  bags  ProductionBag[]

  @@unique([organisationId, legacyId])
  @@index([storeId, orderDate])
  @@index([status])
  @@index([organisationId])
}

model ManufacturingOrderItem {
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id])
  id                  String       @id @default(cuid())
  orderId             String
  styleSku            String?
  description         String?
  orderQty            Int          @default(1)
  status              OrderStatus  @default(booked)
  expectedDelivery    DateTime?
  /// JewelId of the produced piece, once made (legacy SPM_MfgOrderItem.Inward_JewelId).
  producedStockItemId String?

  legacyId        String?
  legacyUpdatedAt DateTime?

  order ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([organisationId, legacyId])
