  credit
}

enum LedgerKind {
  AR
  AP
  expense
  income
  asset
  liability
}

enum AttendanceStatus {
  present
  late
  on_leave
  absent
}

enum LeaveType {
  casual
  sick
  earned
  festival
}

enum LeaveStatus {
