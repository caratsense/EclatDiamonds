model NewStoreMilestone {
  id        String   @id @default(cuid())
  projectId String
  /// e.g. T-90 / T-60 / T-30 / Launch.
  marker    String
  title     String
  summary   String?
  date      DateTime @db.Date
  state     String   @default("upcoming")

  project NewStoreProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model NewStoreVendor {
  id        String    @id @default(cuid())
  projectId String
  name      String
  task      String?
  status    String?   @default("pending")
  amount    Decimal?  @db.Decimal(14, 2)
  dueDate   DateTime? @db.Date

  project NewStoreProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================================================
// DATA PIPELINE � sync watermark state (docs/DATA_PIPELINE.md)
// ============================================================================

/// Per-source-table watermark so the live SQL Server agent never re-pulls or loses rows.
model SyncState {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  /// Legacy source table, e.g. "JewelTrans", "Inward", "VoucherEntry".
  sourceTable    String
  /// Store this watermark belongs to (sync is per-store per-table).
  storeId        String?
  /// Highest identity PK seen (append-row watermark).
  lastLegacyId   String?
  /// Highest UpdateDate/EntryDate seen (changed-row watermark).
  lastUpdatedAt  DateTime?
  lastRunAt      DateTime?
  rowsSynced     Int          @default(0)

  updatedAt DateTime @updatedAt

  @@unique([organisationId, sourceTable, storeId])
  @@index([organisationId])
}

/// Gap-free, race-free counter behind every human-readable document reference
/// (order no, discount request no, ⬦).
///
/// The old `prisma.<model>.count() + 1` pattern is unsafe on two counts: two
/// concurrent bookings read the same count and mint the SAME ref, and deleting a
/// row makes the next ref collide with an existing one. `SequenceService` instead
/// bumps this row inside a single atomic `UPDATE ⬦ RETURNING`, so every caller
/// gets a distinct number even under concurrency.
///
/// `scope` is the counter's partition key � typically `<DOCTYPE>:<storeId>:<YYMM>`
/// so each store gets its own monthly series.
model DocSequence {
  scope     String   @id
  next      Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt
}

// ============================================================================
// MODULE 3 � DASHBOARD TASKS (to-do / cross-dept follow-ups)
// ============================================================================

/// A to-do surfaced on the dashboard agenda (Module 3), and the follow-up work
/// attached to a customer or a lead (Phase A11).
model Task {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  storeId        String?
  title          String
  detail         String?

  /// DISPLAY NAME ONLY, and kept for backward compatibility: every task created
  /// before assigneeId existed carries a name here and nothing else, so dropping
  /// it would orphan them. New writes set BOTH — the id for matching, the name so
  /// the row still reads correctly if the user is later deactivated.
  assignee   String?
  /// The real assignee. Nullable because historical rows have no id to backfill
  /// from: a name is not an identity, and guessing which "R. Sharma" was meant is
  /// exactly the kind of silent wrong answer that must not be invented.
  assigneeId String?
  assignedTo User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  /// "low" | "normal" | "high" | "urgent". Free-form-but-validated in the DTO
  /// rather than an enum, so a tenant-configurable priority list can back it
  /// later without a migration per customer.
  priority String @default("normal")

  /// What this task is ABOUT. Both nullable: a task need not concern anyone in
  /// particular ("count the safe"), and pretending otherwise would force a fake
  /// subject onto ordinary internal work.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// "open" | "in_progress" | "done"
  status      String    @default("open")
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  callLogs  CallLog[]

  @@index([storeId, status])
  @@index([organisationId])
  @@index([organisationId, assigneeId, status])
  @@index([organisationId, partyId])
  @@index([organisationId, leadId])
}

/// Cross-department hand-off (Module 3 collaboration): one team raises a piece of
/// work for another department (e.g. sales -> workshop). Store-scoped.
model Handoff {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  storeId        String
  fromDept       String
  toDept         String
  title          String
  note           String?
  /// "open" | "accepted" | "done" (assignee finished) | "closed" (creator approved)
  status         String       @default("open")
  createdById    String
  createdByName  String
  /// Display name of the assignee (kept for legacy rows / free-text fallback).
  assignedTo     String?
  /// The assignee's user id � who gets notified and whose "assigned to me" this is.
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([status])
  @@index([organisationId])
}

// ============================================================================
// MODULE 10 � REPORTING & DSR (Daily Sales Report, store-close entry)
// ============================================================================

/// A store-close Daily Sales Report � the exact figures a store manager currently
/// types on WhatsApp at end of day, captured on the website instead. One row per
/// store per report-date (traffic + sales + payment split + old-gold). Rolls up
/// into the derived weekly/monthly summaries; the composed text mirrors the
/// owner's WhatsApp format 1:1 (see docs/CLIENT-CALL-2026-07.md § Module 10).
model DailyReport {
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id])
  id               String       @id @default(cuid())
  storeId          String
  reportDate       DateTime     @db.Date
  reportTime       String? // "8:00 PM"
  walkIns          Int          @default(0)
  seriousEnquiries Int          @default(0)
  /// The third row of the store's own traffic sheet: how many of the serious
  /// enquiries actually bought. A subset of seriousEnquiries, which is itself a
  /// subset of walkIns — the service enforces both, so the funnel can never
  /// widen on the way down.
  conversions      Int          @default(0)

  /// TABLE A — counter sale. This is its value; cash/card/upi and oldGold*
  /// below are its payment split.
  deliveredBilled  Decimal      @default(0) @db.Decimal(14, 2)

  /// TABLE B — customised sale. `bookingsNew` is the value booked today and
  /// `advanceReceived` is what was actually collected against the book; the
  /// custom* columns below are that collection's payment split.
  bookingsNew      Decimal      @default(0) @db.Decimal(14, 2)
  advanceReceived  Decimal      @default(0) @db.Decimal(14, 2)

  /// The customised-order book as the store already keeps it: what stood open at
  /// the start of the day, and what closed (sale completed) during it.
  ///
  /// Closing booking is deliberately NOT a column: it is open + new - closed,
  /// and two stored numbers that have to agree is a reconciliation bug waiting
  /// to happen. The sheet shows it; the database derives it.
  bookingsOpen     Decimal      @default(0) @db.Decimal(14, 2)
  bookingsClosed   Decimal      @default(0) @db.Decimal(14, 2)

  /// Payment split for the COUNTER sale (Table A). Gold is a mode of payment on
  /// the store's sheet, not a separate transaction — a customer settling with
  /// old gold is paying — so it sits here beside cash/card/UPI.
  cash             Decimal      @default(0) @db.Decimal(14, 2)
  card             Decimal      @default(0) @db.Decimal(14, 2)
  upi              Decimal      @default(0) @db.Decimal(14, 2)
  oldGoldWtG       Decimal?     @db.Decimal(12, 3)
  oldGoldValue     Decimal?     @db.Decimal(14, 2)

  /// Payment split for the CUSTOMISED sale (Table B). Separate columns rather
  /// than one merged split, because the store reconciles the two tables
  /// separately and a merged total cannot be checked against either table. The
  /// short names above keep their meaning for every report already filed.
  customCash       Decimal      @default(0) @db.Decimal(14, 2)
  customCard       Decimal      @default(0) @db.Decimal(14, 2)
  customUpi        Decimal      @default(0) @db.Decimal(14, 2)
  customGoldWtG    Decimal?     @db.Decimal(12, 3)
  customGoldValue  Decimal?     @db.Decimal(14, 2)
  customBankTransfer Decimal    @default(0) @db.Decimal(14, 2)
  /// The sheet's Remark row, free text for the day.
  remark           String?
  submittedBy      String?
  /// Where this came from: "web" (the in-app form) or "whatsapp" (the bot), so
  /// HO can tell the channels apart.
  source           String       @default("web")
  createdAt        DateTime     @default(now())

  store Store @relation(fields: [storeId], references: [id])

  /// One report per store per day. Without this a resubmission (or a webhook
  /// retry) becomes a second row and silently doubles every roll-up that reads
  /// it; with it, a resubmission updates the day in place. storeId already
  /// belongs to exactly one organisation, so this is organisation-safe.
  @@unique([storeId, reportDate])
  @@index([storeId, reportDate])
  @@index([organisationId])
}

// ============================================================================
// LEGACY MIRROR � full raw copy of EVERY APRS-SJEP table (extract-everything-once)
// ============================================================================

/// Generic landing table: one row per source-table row, the whole record as JSON.
/// The on-site agent's full-dump mode mirrors EVERY legacy table here, so ANY
/// field is available later without ever changing the sync code. Upserted by
/// (sourceTable, rowKey); incremental via legacyUpdatedAt where the source has it.
model LegacyRow {
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  id              String       @id @default(cuid())
  sourceTable     String
  rowKey          String
  data            Json
  legacyUpdatedAt DateTime?
  syncedAt        DateTime     @default(now())

  @@unique([organisationId, sourceTable, rowKey])
  @@index([sourceTable])
  @@index([sourceTable, legacyUpdatedAt])
  @@index([organisationId])
}

// ============================================================================
// AUDIT LOG � append-only trail of sensitive decisions (approvals, role changes)
// ============================================================================

/// One immutable audit entry per sensitive mutation (discount/return approvals,
/// role/store changes, leave decisions, commission-rate + target edits). Human
/// call sites are normally best-effort; connector ingestion supplies its active
/// transaction so the accepted receipt/state and machine audit commit together.
model AuditLog {
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  /// Exactly one of actorId (a human User), machineActorId (a Connect agent) or
  /// systemActorId (an automation inside this software) is present, enforced by
  /// a database CHECK. The machine and system ids are intentionally denormalized
  /// so retiring an agent, or renaming an automation, never erases the immutable
  /// audit identity.
  actorId        String?
  machineActorId String?
  /// The automation that acted with no person and no customer machine behind it:
  /// an inbound webhook placing a lead in the round-robin queue, a public QR form
  /// creating one. A key from SYSTEM_ACTORS in common/audit.service.ts. Without
  /// this column an automatic action either had to fake a human actor or go
  /// unrecorded, and it went unrecorded.
  systemActorId  String?
  actorName      String
  actorRole      Role
  action         String
  entityType     String
  entityId       String
  storeId        String?
  summary        String
  metadata       Json?
  actor          User?        @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([storeId])
  @@index([organisationId])
  @@index([machineActorId])
  @@index([systemActorId])
}

// ============================================================================
// SALES TARGETS � per-store (+ optional per-staff) monthly revenue goals
// ============================================================================

/// A monthly revenue target for a store, optionally narrowed to one staff member.
/// `staffId = null` is the WHOLE-STORE target used by the dashboard achievement view.
model SalesTarget {
  id          String   @id @default(cuid())
  storeId     String
  staffId     String?
  period      String // "YYYY-MM"
  amount      Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  staff User? @relation("UserSalesTargets", fields: [staffId], references: [id])

  @@unique([storeId, staffId, period])
  @@index([period])
}

// ============================================================================
// CARATOS PHASE A2 — UNIVERSAL CONFIGURATION
//
// Industry behaviour is data, not code. A pack (defined in
// src/config/industry-packs/, versioned in git) is APPLIED to a tenant, which
// materialises rows here; the tenant then edits them without a deploy. There is
// deliberately no IndustryPack table: a pack definition that lived in the DB
// would need its own admin UI and its own migrations to ship, and would rot into
// exactly the "dead configuration system" this layer exists to avoid.
//
// These models SHADOW the existing platform enums rather than replacing them.
// `TaxonomyTerm.systemValue` carries the enum value a term maps to, so Eclat's
// ProductCategory/LeadSource keep working untouched while a new tenant gets a
// vocabulary that was never a jewellery enum in the first place.
// ============================================================================

/// One term in one tenant-scoped vocabulary (`kind`), e.g. kind='lead_source'
/// code='walk_in'. Self-referencing for hierarchies (category → subcategory).
model TaxonomyTerm {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// The vocabulary this term belongs to: 'product_category', 'lead_source',
  /// 'metal', 'checkin_purpose', 'medicine_form', 'fabric', … Free-form by
  /// design — a new industry adds vocabularies without a schema change.
  kind  String
  code  String
  label String

  parentId String?
  parent   TaxonomyTerm?  @relation("TaxonomyTree", fields: [parentId], references: [id])
  children TaxonomyTerm[] @relation("TaxonomyTree")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  /// Pack that seeded this term. NULL = created by the tenant, so a pack upgrade
  /// must never overwrite or delete it.
  packCode String?

  /// The core Prisma enum value this term shadows, when one exists (e.g.
  /// 'walk_in' for LeadSource.walk_in). NULL for terms with no enum behind them.
  /// This is what lets configuration arrive without breaking typed columns.
  systemValue String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, kind, code])
  @@index([organisationId, kind, isActive])
}

/// A custom field a tenant may set on an entity. Values are stored in the
/// entity's own JSONB `attributes` column (Product/Party/Lead), not in an EAV
/// value table: a jewellery product has ~8 attributes and a pharmacy product ~6,
/// so a join-per-attribute buys nothing and costs every catalogue query.
model AttributeDefinition {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Which entity carries the value: 'product' | 'party' | 'lead'.
  entity String
  /// Key inside that entity's `attributes` JSON. Stable; renaming needs a backfill.
  key    String
  label  String

  /// 'text' | 'number' | 'decimal' | 'boolean' | 'date' | 'enum' | 'multi_enum'
  dataType String
  required Boolean @default(false)

  /// For enum/multi_enum: the TaxonomyTerm.kind supplying the options, so the
  /// option list stays editable in one place.
  taxonomyKind String?
  /// Static option list, when the values are not worth a vocabulary.
  options      Json?

  /// Display unit ('g', 'ct', 'mg', 'GSM'). Presentation only — never parsed.
  unit String?

  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
  /// Surface this attribute in list filters / search facets.
  searchable Boolean @default(false)

  packCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, entity, key])
  @@index([organisationId, entity, isActive])
}

/// Per-tenant policy over a BUILT-IN field: hide it, relabel it, make it
/// required, or record who owns it against an external source. This is how a
/// pharmacy hides `karat` on the product form without the product service ever
/// learning what a pharmacy is.
model FieldPolicy {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  entity String
  field  String

  /// 'hidden' | 'optional' | 'required'. Advisory to the UI and to import
  /// validation; it never relaxes a database NOT NULL constraint.
  requirement String  @default("optional")
  /// Tenant's own wording for the field, when the default term does not fit.
  label       String?

  /// FieldOwnership from src/integration/contracts/provenance.ts:
  /// SOURCE_OWNED | CARATOS_OWNED | CONFLICT | UNKNOWN. Consulted before a sync
  /// overwrites a value.
  ownership String @default("UNKNOWN")

  sortOrder Int     @default(0)
  packCode  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, entity, field])
  @@index([organisationId, entity])
}

// ============================================================================
// CARATOS PHASE A3 — CRM IDENTITY SPINE + CUSTOMER 360
//
// What is deliberately NOT here, because the repository already has it:
//   Customer          -> Party
//   Opportunity       -> Lead already carries value/stage/outcome/closedAt.
//                        A second model would split one funnel across two
//                        tables and give every report two answers.
//   Visit / check-in  -> CheckIn
//   Task / follow-up  -> Task, LeadFollowUp
//   Quote / Sale      -> Quote, Sale
//
// What is genuinely missing and is added below: a stable IDENTITY (ContactPoint),
// a single TIMELINE (ActivityEvent), customer-facing MESSAGING (Conversation /
// Message — WhatsAppEvent is the staff DSR bot's plumbing, not a customer
// thread), CONFIGURABLE stages (Pipeline / PipelineStage, since LeadStage is a
// three-value closed enum), and PRODUCT INTEREST (ProductInteraction).
// ============================================================================

/// A way to reach one customer: a phone number, an email, a WhatsApp number, a
/// provider-scoped social id. This is the identity spine — the thing that lets a
/// WhatsApp message, a walk-in and a web form resolve to the same Party.
///
/// UNIQUENESS TRADE-OFF, made deliberately: `(organisationId, kind,
/// valueNormalized)` is unique, so within a tenant one phone number resolves to
/// exactly one customer and resolution is deterministic. The cost is real — a
/// household that shares a number can only attach it to one Party. The second
/// claimant does NOT silently take it over and does NOT get a duplicate row:
/// IdentityService records a MergeCandidate for a human to settle, and the
/// party's own `phone` snapshot still holds the number for display. Silent
/// merging of two customers is the one outcome worth this much care to avoid.
model ContactPoint {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  partyId        String
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)

  /// 'phone' | 'email' | 'whatsapp' | 'instagram' | 'external'
  kind            String
  /// Exactly as supplied, for display — never used for matching.
  value           String
  /// The matching key: E.164 digits for phone/whatsapp, lowercased email, raw
  /// provider id for social. Two records match iff these are equal.
  valueNormalized String

  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  /// Where it came from: 'manual' | 'import' | 'gati' | 'whatsapp' | 'web' | …
  source     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, kind, valueNormalized])
  @@index([organisationId, partyId])
}

/// Two records claim the same identity. Raised instead of merging, because an
/// automatic merge of the wrong two customers is close to unrecoverable — their
/// sales, payments and conversations end up on one record with no trace of which
/// belonged to whom.
model MergeCandidate {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// The party that currently owns the identity.
  primaryPartyId   String
  primaryParty     Party   @relation("MergePrimary", fields: [primaryPartyId], references: [id], onDelete: Cascade)
  /// The other claimant. Null when the claim came from an inbound message that
  /// has no party yet — the value below is then all that is known.
  duplicatePartyId String?
  duplicateParty   Party?  @relation("MergeDuplicate", fields: [duplicatePartyId], references: [id], onDelete: Cascade)

  /// What collided: the ContactPoint.kind and its normalised value.
  matchKind  String
  matchValue String
  /// 0.000–1.000. Only an exact identity match reaches 1; anything softer stays
  /// well below and is presented as a suggestion, never acted on.
  confidence Decimal @db.Decimal(4, 3)

  /// 'open' | 'merged' | 'rejected'
  status       String    @default("open")
  reason       String?
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([organisationId, status, createdAt])
  @@index([organisationId, primaryPartyId])
}

/// THE customer timeline. One row per thing that happened, whatever module it
/// happened in — so Customer 360 is a single indexed read rather than a fan-out
/// across fifteen tables that each know a different shape of "recently".
///
/// Writing here is additive: the owning module still writes its own row (a Sale
/// is still a Sale). This is a projection for reading, never the source of truth,
/// so a missing event degrades the timeline and nothing else.
model ActivityEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Who caused it. Null for system/automated events, which is meaningful — an
  /// unattributed event is honest about being unattributed.
  actorUserId String?
  actorUser   User?   @relation("ActivityActor", fields: [actorUserId], references: [id])

  /// Dotted, past-tense: 'lead.created', 'message.received', 'sale.completed',
  /// 'visit.recorded', 'product.shortlisted', 'ai.qualified', 'handoff.requested'.
  type       String
  occurredAt DateTime @default(now())
  /// One human sentence. Rendered directly; never parsed.
  summary    String

  /// The record this is about, for deep-linking back to the owning module.
  entityType String?
  entityId   String?

  /// 'store' | 'whatsapp' | 'instagram' | 'phone' | 'web' | 'system'
  channel      String?
  /// Provenance, matching SourceSystem in integration/contracts/provenance.ts.
  sourceSystem String?

  /// Stable key making replay idempotent — a redelivered webhook or a re-run
  /// backfill produces the same key and collides instead of duplicating. NULL is
  /// allowed and Postgres treats NULLs as distinct, so events with no natural key
  /// simply are not deduplicated.
  dedupeKey String?

  metadata Json?

  createdAt DateTime @default(now())

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, partyId, occurredAt])
  @@index([organisationId, occurredAt])
  @@index([organisationId, type, occurredAt])
  @@index([organisationId, leadId, occurredAt])
}

/// A customer-facing thread on one channel.
///
/// NOT the same thing as WhatsAppEvent/WhatsAppSession: those are the internal
/// staff bot (a salesperson filing a daily report over WhatsApp). This is a
/// conversation WITH A CUSTOMER, and the two must not be conflated — one is an
/// employee tool, the other is CRM data subject to customer-data rules.
model Conversation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])
  /// Null until the sender resolves to a customer. An unresolved thread is
  /// visible and answerable — it is not dropped for lacking an identity.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  /// 'whatsapp' | 'instagram' | 'email' | 'web' | 'sms' | 'phone'
  channel       String
  /// The tenant integration this thread arrived through. Populated once the
  /// integration framework lands (Phase A5); null for manually created threads.
  integrationId String?

  /// The provider's thread identifier. Unique per (tenant, channel) so a
  /// redelivered webhook re-attaches to the existing thread instead of forking it.
  externalThreadId String?

  /// THE NUMBER THIS THREAD ARRIVED ON, and the one a reply must leave from.
  ///
  /// Outranks the branch's route at send time. Answering from a different number
  /// starts a second thread on the customer's phone, abandons the 24-hour
  /// customer-care window opened on the first, and reads to them as a different
  /// business. Null for threads that predate multi-number routing or were
  /// started from inside CaratOS, where the branch route decides.
  senderAssetId String?
  senderAsset   IntegrationAsset? @relation("ConversationSender", fields: [senderAssetId], references: [id])

  /// 'open' | 'snoozed' | 'closed'
  status   String @default("open")
  /// Who is answering right now: 'ai' | 'human' | 'unassigned'. The handoff state
  /// is explicit rather than inferred from whether an assignee exists.
  handling String @default("unassigned")

  /// 'customer' | 'staff'. A staff thread carries the business's own notices to
  /// an employee (the morning digest) through the same outbox, consent, template
  /// and delivery-receipt path as a customer message, and is kept out of the
  /// customer inbox, its counts and its KPIs. Its key never matches an inbound
  /// sender, so a reply from that employee still lands in an ordinary thread.
  audience String @default("customer")

  assignedUserId String?
  assignedUser   User?   @relation("ConversationAssignee", fields: [assignedUserId], references: [id])

  subject       String?
  lastMessageAt DateTime?
  lastInboundAt DateTime?
  /// Why the AI stopped handling it. Set on every AI→human handoff, including
  /// handoffs caused by an AI error, so a silent failure is impossible to miss.
  handoffReason String?

  /// Opaque provider identifiers for the ad this thread came from. Measured
  /// evidence, mirrored here from AttributionTouch so the inbox can badge a
  /// conversation without a join. Null means the provider did not tell us —
  /// which is NOT the same as organic and must never be displayed as such.
  sourceAdId            String?
  sourceAdSetId         String?
  sourceCampaignId      String?
  sourceClickId         String?
  /// The ad-set automation rule that produced this routing, for audit and UI.
  matchedRuleId         String?
  /// Set when a LATER ad on this thread would have routed somewhere else. The
  /// conversation deliberately stays where it was first routed; this flags it
  /// for a human to look at rather than silently moving an active thread.
  routingReviewRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages           Message[]
  leadQualifications LeadQualification[]
  routingConflicts   ConversationRoutingConflict[]
  responseSlas       ConversationResponseSla[]

  @@unique([organisationId, channel, externalThreadId])
  @@index([organisationId, status, lastMessageAt])
  @@index([organisationId, partyId, lastMessageAt])
  @@index([organisationId, assignedUserId, status])
  @@index([organisationId, sourceAdId])
  @@index([senderAssetId])
}

/// One message in a Conversation.
model Message {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 'inbound' | 'outbound'
  direction    String
  /// 'customer' | 'agent' | 'ai' | 'bot' | 'system' — who composed it. An AI
  /// reply is never recorded as an agent's, so an audit can always tell them
  /// apart. 'bot' is the SCRIPTED qualification flow, kept distinct from 'ai'
  /// for the same reason: approved copy and generated text are not the same
  /// claim, and the CRM labels them differently to the people reading them.
  authorType   String
  authorUserId String?
  authorUser   User?   @relation("MessageAuthor", fields: [authorUserId], references: [id])

  body      String?
  mediaUrl  String?
  mediaType String?

  /// The provider's message id — the idempotency key for webhook retries.
  /// Unique per tenant; NULL for messages composed inside CaratOS.
  externalId String?

  /// 'received' | 'queued' | 'sent' | 'delivered' | 'read' | 'failed'
  status String  @default("received")
  error  String?

  sentAt  DateTime @default(now())
  /// The raw provider payload, kept so a mapping bug can be diagnosed and
  /// replayed rather than guessed at.
  payload Json?

  createdAt DateTime       @default(now())
  aiDraft   AiDraftRecord?

  @@unique([organisationId, externalId])
  @@index([conversationId, sentAt])
  @@index([organisationId, sentAt])
}

/// A tenant-configurable funnel. `LeadStage` is a closed three-value enum
/// (inquiry / quotation / order_placed) that reads as a jewellery sales process;
/// a pharmacy's funnel is not those three words. Stages here carry their own
/// labels and map back to the enum via `systemValue` where one applies.
model Pipeline {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// What flows through it. 'lead' today; the column exists so a service pipeline
  /// or a ticket pipeline does not need a second table.
  entity String @default("lead")

  code      String
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  /// Which industry pack wrote this funnel, or NULL when the tenant owns it.
  /// Same convention as TaxonomyTerm / AttributeDefinition / FieldPolicy, and
  /// the ONLY licence provisioning has to re-word the row when a tenant changes
  /// industry — every pack ships the same pipeline code, so without this the
  /// previous industry's wording would survive the switch for ever.
  /// `_system` marks the generic funnel ensureDefault creates before any pack is
  /// chosen: not the tenant's words, so a later pack may safely replace them.
  packCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]

  @@unique([organisationId, code])
  @@index([organisationId, entity, isActive])
  @@index([organisationId, packCode])
}

model PipelineStage {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  code      String
  label     String
  sortOrder Int    @default(0)

  /// What reaching this stage MEANS for reporting: 'open' | 'won' | 'lost'.
  /// Reports read this, never the stage name, so renaming a stage cannot silently
  /// change a conversion number.
  outcome String @default("open")

  /// The LeadStage enum value written to the typed column when a lead sits here.
  /// NULL for stages with no enum equivalent — the lead keeps its previous enum
  /// value and the pipeline stage is authoritative for display.
  systemValue String?

  /// Indicative close probability, 0–100. Advisory only; nothing computes revenue
  /// from it without a human asking for a weighted view.
  probability Int?

  isActive Boolean @default(true)

  /// Which industry pack wrote this stage's wording, or NULL when the tenant
  /// owns it. Cleared the moment a tenant edits the stage, so "pack-owned" can
  /// never mean "we may overwrite what someone typed". See Pipeline.packCode.
  packCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, code])
  @@index([organisationId, pipelineId, sortOrder])
  @@index([organisationId, packCode])
}

/// A customer showed interest in a product. The universal version of "she tried
/// on the bangle": nothing here is jewellery-specific, and `sku` is free text so
/// an item that is not in the catalogue yet can still be recorded rather than lost.
model ProductInteraction {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The visit this interest was shown during, when it was shown at a counter.
  ///
  /// Nullable because interest is also shown over WhatsApp and on the website,
  /// where there is no visit at all, and because rows written before this column
  /// existed have no visit to point at. Reconstructing it from partyId and a
  /// time window would attach one customer's enquiries to another's visit.
  checkInId String?
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  /// The identifier as scanned/typed, when it matches no catalogue row.
  sku       String?

  /// 'viewed' | 'shown' | 'shortlisted' | 'tried' | 'quoted' | 'rejected' | 'purchased'
  kind String

  /// The salesperson who recorded it.
  userId String?
  user   User?   @relation("ProductInteractionUser", fields: [userId], references: [id])

  /// 'store' | 'web' | 'whatsapp' | 'instagram' — where the interest was shown.
  channel String?

  occurredAt DateTime @default(now())
  quantity   Int?
  notes      String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([organisationId, partyId, occurredAt])
  @@index([organisationId, checkInId])
  @@index([organisationId, productId, kind])
  @@index([organisationId, leadId, occurredAt])
  @@index([organisationId, storeId, occurredAt])
}

// ============================================================================
// CARATOS PHASE A5 — INTEGRATION FRAMEWORK
//
// Provider-neutral. Nothing here names Meta, Tally or BUSY; a provider is a code
// in a TypeScript registry (src/integration/providers/) and this is the tenant's
// *instance* of one. That is what makes a credential tenant-scoped instead of an
// environment variable, which is the single change that lets a second tenant
// exist at all.
// ============================================================================

/// One tenant's configured connection to one provider.
model Integration {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Key into the provider registry. Never a free-form vendor name.
  providerCode String
  /// The tenant's label — they may have two of the same provider.
  name         String

  /// 'not_configured' | 'connected' | 'needs_attention' | 'failed' | 'disabled'.
  /// Defaults to not_configured: an integration row proves someone started, not
  /// that anything works. Only a successful health check sets 'connected'.
  status String @default("not_configured")

  /// NON-SECRET settings only: account ids, endpoints, sync options. Secrets go
  /// in IntegrationCredential, encrypted. Anything readable by an admin screen
  /// belongs here; anything that would authenticate as the tenant does not.
  config       Json?
  /// What this instance can actually do, mirroring ConnectorCapabilities.
  capabilities Json?

  lastHealthAt DateTime?
  lastSyncAt   DateTime?
  lastError    String?
  /// Incremental sync position, source-defined and opaque.
  watermark    String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials     IntegrationCredential[]
  assets          IntegrationAsset[]
  adSpendDays     AdSpendDaily[]
  adSpendCoverage AdSpendCoverage[]
  messagingRoutes StoreMessagingRoute[]

  @@unique([organisationId, providerCode, name])
  @@index([organisationId, status])
}

/// One provider-measured advertising spend fact: one campaign, one ad account,
/// one account-local calendar day.
///
/// This used to be a JSON blob in LegacyRow, the untyped landing table the
/// import pipeline stages raw source rows in. That was the wrong home for money
/// three ways over: a JSON string cannot be a Decimal, nothing constrained the
/// currency, and the only key was a composed `rowKey` string, so the database
/// could not tell a replay from a second genuine row. Reporting also had to
/// re-validate every blob on read and silently drop the ones that failed --
/// which is exactly how a ROAS denominator can shrink without anyone noticing.
///
/// `date` is a calendar date, not a timestamp: an account-local day is the unit
/// the provider bills in, and `timezone` records which day that was.
model AdSpendDaily {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// The IntegrationAsset (kind 'ad_account') the spend was measured against.
  adAccountAssetId  String
  /// Provider-side account id, denormalised so retiring the asset row never
  /// makes an existing number ambiguous.
  externalAccountId String

  externalCampaignId String
  campaignName       String?

  date     DateTime @db.Date
  /// IANA zone the account-local `date` was resolved in.
  timezone String
  /// ISO 4217, uppercase. A database CHECK enforces the shape; nothing in the
  /// application converts between currencies, so this is the unit of `spend`
  /// and never a hint.
  currency String

  spend       Decimal @db.Decimal(18, 4)
  impressions BigInt?
  clicks      BigInt?

  /// When the provider was read, and by which job -- so a disputed number can
  /// be traced back to the run that produced it.
  fetchedAt DateTime
  jobId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Replay safety. One row per campaign per account-local day; a re-run of the
  /// same window updates in place instead of double-counting spend.
  @@unique([organisationId, adAccountAssetId, date, externalCampaignId], map: "AdSpendDaily_org_asset_date_campaign_key")
  /// Reporting: a date-range scan for one account.
  @@index([organisationId, adAccountAssetId, date])
  /// Reporting: joining spend to the campaigns revenue was attributed to.
  @@index([organisationId, externalCampaignId])
}

/// Proof that one account-local day was fully ingested.
///
/// Kept apart from the spend rows on purpose: "no spend rows for Tuesday" and
/// "Tuesday was never fetched" are different facts, and only the first may be
/// read as zero. Without this a partial sync would quietly publish a ROAS built
/// on a fraction of the denominator.
model AdSpendCoverage {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  adAccountAssetId  String
  externalAccountId String

  date     DateTime @db.Date
  timezone String
  /// The account currency in force when the day was ingested. A day covered in
  /// one currency and reported in another is a mismatch, not a conversion.
  currency String

  completedAt DateTime
  jobId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, adAccountAssetId, date])
  @@index([organisationId, adAccountAssetId, date])
}

/// An encrypted secret belonging to one tenant's integration.
///
/// The plaintext NEVER exists in a column, a log, an API response or an
/// environment variable. Encryption is AES-256-GCM with a platform master key;
/// `keyVersion` records which key wrapped it so a rotation can find and re-wrap
/// exactly the rows that need it rather than re-encrypting everything blindly.
model IntegrationCredential {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// 'api_key' | 'access_token' | 'refresh_token' | 'password' | 'shared_secret'
  kind String

  /// Version-marked AES-256-GCM ciphertext (`aad1:` + Base64 for context-bound
  /// rows), with its nonce and auth tag alongside. The tag is what makes
  /// tampering detectable rather than silently decrypting to garbage.
  ciphertext String
  iv         String
  authTag    String
  keyVersion Int    @default(1)

  expiresAt  DateTime?
  rotatedAt  DateTime?
  /// Touched on use, so an unused credential can be spotted and revoked.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, kind])
  @@index([organisationId])
}

/// Something the provider owns that the tenant selected: a WhatsApp number, an
/// ad account, a source database, a watched folder.
///
/// Most identities are unique only inside one Integration. `ownershipKey` is the
/// exception used for provider identities which must have exactly one active
/// owner platform-wide (currently WhatsApp phone-number IDs). Inactive and
/// provider-local assets leave it NULL, so their existing uniqueness semantics
/// do not change.
model IntegrationAsset {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  integrationId  String
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Provider-defined: 'phone_number' | 'account' | 'ad_account' | 'database' | 'folder'
  kind       String
  externalId String
  name       String?
  metadata   Json?
  isActive   Boolean @default(true)

  /// True only after a live provider call proved this tenant's credential can
  /// read this asset. A manually typed id is NOT ownership: without this, an
  /// admin screen cannot tell "somebody entered a Page id" from "we confirmed
  /// the token can read that Page", and would have to call both connected.
  providerOwnershipVerified Boolean   @default(false)
  /// When that check last ran — set only by an actual check, never on save.
  lastVerifiedAt            DateTime?
  /// Bounded, redacted provider failure. Never a token, never a raw response.
  lastError                 String?
  /// `whatsapp_cloud:phone_number:<externalId>` while that sender is active.
  /// NULL for inactive/provider-local assets. The unique index is the final race
  /// backstop against two tenants claiming the same inbound routing identity.
  ownershipKey              String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagingRoutes StoreMessagingRoute[]
  /// Threads that arrived on this sender and must be answered from it.
  conversations   Conversation[]        @relation("ConversationSender")

  @@unique([integrationId, kind, externalId])
  @@index([organisationId, kind])
}

/// Every inbound webhook, stored BEFORE it is processed.
///
/// Providers retry for days, so the handler persists and acknowledges first and
/// works afterwards. `organisationId` is NULLABLE and starts null: a webhook that
/// cannot be attributed to a tenant is kept unattributed rather than guessed onto
/// one. It is stamped once the integration resolves.
model WebhookEvent {
  id             String        @id @default(cuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  integrationId  String?

  providerCode String
  /// Provider's event id — the idempotency key. Unique per provider; NULL when a
  /// provider sends none, in which case duplicates cannot be detected and the
  /// handler must be idempotent by other means.
  externalId   String?

  /// Whether the signature actually verified. Stored, not assumed: an unverified
  /// event is retained for diagnosis but must never drive a business write.
  signatureVerified Boolean @default(false)

  payload Json
  headers Json?

  /// 'received' | 'processed' | 'ignored' | 'failed'
  status      String    @default("received")
  error       String?
  attempts    Int       @default(0)
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([providerCode, externalId])
  @@index([status, createdAt])
  @@index([organisationId, createdAt])
}

// ============================================================================
// CARATOS PHASE A8 — BACKGROUND JOBS
//
// PostgreSQL-backed, not Redis/BullMQ. The system already depends on Postgres
// and already runs a scheduler; adding a broker would add a second thing that
// can be down, a second thing to back up, and a second place tenant data lives —
// for a workload measured in hundreds of jobs a day. SELECT ... FOR UPDATE SKIP
// LOCKED is the right tool at this size.
// ============================================================================

/// One unit of deferred work.
model JobTask {
  id             String        @id @default(cuid())
  /// NULL for platform-level work that legitimately spans tenants. Every
  /// tenant-owned job MUST set this — it is what the worker binds runAsTenant to.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])

  /// 'import.process' | 'sync.pull' | 'ai.embed' | 'export.build' | …
  kind    String
  payload Json

  /// Enqueue guard: while a task with this key is pending or running, a second
  /// enqueue is a no-op rather than a duplicate. Unique across the table, so the
  /// key must include the tenant to avoid one tenant blocking another's job.
  idempotencyKey String?

  /// 'pending' | 'running' | 'succeeded' | 'failed' | 'dead'.
  /// 'failed' is retryable; 'dead' has exhausted maxAttempts and needs a human.
  status   String @default("pending")
  priority Int    @default(0)

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  /// Earliest time this may run — also the backoff mechanism, pushed forward on
  /// each failure.
  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  /// Worker lease. A row locked by a worker that died is reclaimed once the lease
  /// goes stale, so a crash cannot strand a job forever.
  lockedBy String?
  lockedAt DateTime?

  lastError String?
  result    Json?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([idempotencyKey])
  @@index([status, runAt, priority])
  @@index([organisationId, kind, status])
  @@index([status, lockedAt])
}

// ============================================================================
// CARATOS PHASE A10 — ATTRIBUTION
//
// The central honesty rule: DECLARED source and MEASURED source are different
// columns and are never conflated. `Lead.source` stays exactly what it is — what
// a salesperson typed. AttributionTouch records what was actually observed. When
// nothing was observed, that is represented as an absence of touches, never as
// "organic" or "direct", because a fabricated attribution is worse than a blank
// one: it gets spent against.
// ============================================================================

/// One observed or declared contact between a marketing source and a person.
model AttributionTouch {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// 'ad' | 'organic' | 'referral' | 'direct' | 'unknown'
  channel String
  /// Platform or origin: 'meta' | 'google' | 'walk_in' | 'website' | …
  source  String?
  medium  String?

  /// Internal campaign, when the touch maps to one the tenant planned.
  campaignId String?
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id])

  /// Provider-side identifiers, stored as opaque strings. No provider API is
  /// assumed or called to obtain them — they arrive on a link or are entered.
  externalCampaignId String?
  externalAdSetId    String?
  externalAdId       String?
  clickId            String?

  /// 'first_touch' | 'last_touch' | 'mid'. Which position in the journey this
  /// occupies; attribution MODELS read this rather than re-deriving order.
  position String @default("mid")

  /// HOW this is known: 'measured' (a click id / tracked link),
  /// 'declared' (a human chose it from a dropdown), 'inferred' (a rule matched).
  /// A report may filter on this, so a "measured ROI" figure never silently
  /// includes what someone guessed at the counter.
  evidence String @default("declared")

  /// The sale this touch is credited with, when a conversion has been recorded.
  ///
  /// Written by the attribution service when a sale is linked to a customer who
  /// has touches, and ONLY under a stated model (first or last touch) — never by
  /// assuming the most recent campaign deserves the credit. Null means "not
  /// converted, or not attributable", which is a real answer.
  saleId      String?
  sale        Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  /// Which model credited it: 'first_touch' | 'last_touch' | 'both'. Recorded
  /// per row so two models coexist without one overwriting the other. `both` is
  /// a single touch that is simultaneously first and last — it must appear in
  /// either report, or single-touch customers vanish from one of them.
  creditModel String?

  occurredAt DateTime @default(now())
  metadata   Json?

  /// Stable identity of the ad interaction this touch represents, so a provider
  /// retry or a second message carrying the same click cannot double-count it.
  /// Nullable: touches with no natural provider identity (a salesperson's
  /// declared source) are never deduped, and Postgres treats NULLs as distinct.
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([organisationId, dedupeKey])
  @@index([organisationId, partyId, occurredAt])
  @@index([organisationId, leadId, occurredAt])
  @@index([organisationId, campaignId, occurredAt])
  @@index([organisationId, evidence, occurredAt])
  @@index([organisationId, saleId])
}

// ============================================================================
// CRM AI QUALIFICATION (Phase A9) — conversation → intent → score → action
// ============================================================================

/// One AI assessment of one customer conversation or lead.
///
/// SEPARATE FROM VISUAL SIMILARITY ON PURPOSE. That pipeline is
/// image → embedding → nearest product, is deterministic, and has its own
/// inference service. This one is text → signals → score → recommended action,
/// and its whole value is that a human can see WHY. Sharing infrastructure
/// between them would couple a catalogue feature to an LLM provider.
///
/// Every row records the policy version and the model that produced it, so a
/// score can always be explained in terms of the rules that were actually in
/// force when it was computed — not the rules as they stand today.
model LeadQualification {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// What was assessed. At least one of these is always set; which one depends
  /// on where the assessment was triggered from.
  partyId        String?
  party          Party?        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 'ai' | 'rules' | 'human'. A rules run is a real, explainable qualification
  /// that needs no provider; it is not a downgraded or simulated AI result.
  method String @default("rules")

  /// 0-100. Nullable because "could not assess" is a legitimate outcome and must
  /// not be recorded as a zero — a zero means cold, not unknown.
  score      Int?
  /// 0-1. How much the producer trusts its own answer.
  confidence Decimal? @db.Decimal(4, 3)

  /// The tenant's own band label for this score, resolved through their policy
  /// ("hot"/"warm"/"cold" is Eclat's choice, not the platform's).
  band String?

  /// What the system suggests a human do next. Advisory: nothing in CaratOS acts
  /// on this automatically.
  recommendedAction String?
  /// Whether a human is being asked to take over, and why.
  handoffRequested  Boolean @default(false)
  handoffReason     String?

  /// The signals that fired, each with the evidence that fired it. This is what
  /// makes the score explainable rather than an oracle: [{ key, label, weight,
  /// matched, evidence }]. Stored with the row so a later policy edit cannot
  /// retroactively change what a past assessment "meant".
  signals      Json?
  /// Extracted requirements in the tenant's own vocabulary (budget, occasion,
  /// timeline, …). Never invented — absent when the conversation did not say.
  requirements Json?
  /// One-paragraph human-readable summary.
  summary      String?

  /// Which policy produced this, and which model. Both recorded because a score
  /// with no provenance cannot be defended when someone disputes it.
  policyVersion Int     @default(1)
  provider      String?
  model         String?

  /// Set when the producer could NOT assess — no provider configured, the text
  /// was too short, the provider errored. Present means score is null.
  unavailableReason String?

  /// How much conversation was actually read. A score from two messages deserves
  /// less weight than one from forty, and hiding that is how a confident-looking
  /// number gets over-trusted.
  messagesConsidered Int @default(0)

  createdAt   DateTime @default(now())
  createdById String?

  @@index([organisationId, partyId, createdAt])
  @@index([organisationId, leadId, createdAt])
  @@index([organisationId, conversationId, createdAt])
  @@index([organisationId, band, createdAt])
}

// ============================================================================
// CARATOS CONNECT (Phase A14) — the on-site agent's server-side contract
// ============================================================================

/// An enrolled on-premise agent.
///
/// THE DIRECTION OF TRUST IS THE WHOLE POINT. CaratOS never dials into a
/// customer's network; the agent dials out. So this row is not a connection, it
/// is an IDENTITY the agent presents when it calls in.
///
/// The agent authenticates with a server-issued token that exists here only as a
/// SHA-256 hash — a leaked database row cannot be replayed as an agent. The
/// organisation is resolved from that token server-side, which is why the agent
/// never sends an organisationId: a client-supplied tenant is not an
/// authorization input.
///
/// It is deliberately NOT a User. An agent that could authenticate as a head
/// office user would inherit every HO permission in the product; instead it
/// carries exactly the rights its own endpoints grant.
model ConnectAgent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Human label — "Surat back office PC".
  name    String
  /// Which store's data this agent is expected to carry, when it is store-bound.
  /// Null for an agent that serves the whole organisation.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// Which source it reads. A registry key ('gati'), never a free-form name.
  sourceSystem       String
  /// Hash of the reviewed connection descriptor. Preview is zero-write; this is
  /// pinned atomically when the first approved live sync starts so one token
  /// cannot later be repointed to overwrite another source descriptor.
  sourceInstanceHash String?

  /// SHA-256 of the enrolment token. The plaintext is shown ONCE at enrolment
  /// and never stored, so it cannot be recovered from here or from a backup.
  tokenHash   String    @unique
  /// First 8 chars of the plaintext, for "which token is this?" without
  /// revealing anything usable.
  tokenPrefix String
  /// Set when the token is rotated or revoked; a revoked agent authenticates
  /// nowhere, and the row is kept so its history stays readable.
  revokedAt   DateTime?
  revokedById String?

  /// 'enrolled' | 'active' | 'stale' | 'error' | 'revoked'. `stale` is derived
  /// from lastSeenAt by the read path rather than written by a timer, so it can
  /// never disagree with the timestamp it is supposed to describe.
  status String @default("enrolled")

  /// What the agent reports about itself on each call. Never trusted for
  /// authorization — only for display and for spotting an un-upgraded machine.
  agentVersion String?
  hostname     String?
  os           String?

  lastSeenAt DateTime?
  lastSyncAt DateTime?
  lastError  String?
  /// Free-form counters the agent reports (rows pushed, queue depth).
  lastStats  Json?

  /// Non-secret connector configuration the server hands back on heartbeat:
  /// which tables to read, batch size, schedule. The agent asks; the server
  /// decides. Secrets never travel this way.
  config Json?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organisationId, name])
  @@index([organisationId, status])
  @@index([organisationId, sourceSystem])
}

/// A later ad wanted to route a conversation somewhere other than where it
/// already lives. The conversation deliberately does NOT move; this row records
/// what was proposed, what was kept, and who decided.
///
/// A row rather than a sentence in an ActivityEvent: the original and proposed
/// assignment are operational state somebody has to act on, and state that only
/// exists inside a log line cannot be queried, counted or resolved.
model ConversationRoutingConflict {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  detectedAt DateTime @default(now())

  /// What the conversation had when the conflicting ad arrived.
  originalStoreId        String?
  originalAssignedUserId String?
  originalRuleId         String?
  originalHandling       String?

  /// What the later rule wanted instead.
  proposedStoreId        String?
  proposedAssignedUserId String?
  proposedRuleId         String?
  proposedRuleName       String?
  proposedHandling       String?

  /// Opaque provider identifiers of the ad that caused it.
  sourceAdId       String?
  sourceAdSetId    String?
  sourceCampaignId String?

  /// 'kept_original' | 'accepted_proposed' | 'manual'. NULL while unresolved.
  resolution     String?
  resolutionNote String?
  resolvedById   String?
  resolvedBy     User?     @relation("RoutingConflictResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([organisationId, resolution, detectedAt])
  @@index([conversationId, detectedAt])
}

/// Provenance for one AI-drafted reply (Phase 2C).
///
/// Separate from `Message` on purpose: this is the record of HOW a draft was
/// produced, and it exists only for the small fraction of messages an assistant
/// wrote. Putting six nullable columns on the hot message table to serve them
/// would cost every row; overloading `Message.payload` — which means "the raw
/// provider payload of an inbound message" — would give one column two meanings
/// and make "which drafts cited this document?" a JSON scan.
///
/// Nothing here is ever shown to a customer. It is what lets a person answer
/// "why did the assistant say that, and on what basis?" after the fact.
model AiDraftRecord {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// The draft itself. Cascades: this row is provenance FOR that message.
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  conversationId String

  provider      String
  model         String
  /// 0.000-1.000. Stored exactly rather than as a float so a threshold
  /// comparison means the same thing everywhere.
  confidence    Decimal @db.Decimal(4, 3)
  latencyMs     Int?
  /// Which version of the drafting policy produced this. Without it, a policy
  /// change makes every earlier draft unexplainable.
  policyVersion String

  /// KnowledgeDocument ids quoted to the model. IDS ONLY — the retrieved text is
  /// never copied here, so a document deletion cannot leave its content behind.
  knowledgeDocumentIds String[]

  /// 'pending' | 'approved' | 'edited' | 'rejected'. Approval is a human act and
  /// is attributed to one.
  review       String    @default("pending")
  reviewedById String?
  reviewedBy   User?     @relation("AiDraftReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([organisationId, review, createdAt])
  @@index([conversationId])
}

// ============================================================================
// CARATOS BLOCK 3 — CAMPAIGN ORCHESTRATION
//
// Deliberately SEPARATE from MarketingCampaign. That model plans agency work:
// budget, brief, deliverables, a jewellery-flavoured `CampaignType`. This one
// SENDS, and sending has a different lifecycle, a different audit surface and
// must stay industry-neutral. Conflating them would force `bridal`/`festive`
// onto a hospital's appointment reminder. The optional link below is how a send
// is credited back to a plan when the tenant runs both.
//
// Nothing here talks to a provider. Every recipient is delivered by
// OmnichannelService.queueToContact, which is the single chokepoint that
// enforces consent, the WhatsApp window, approved templates and the outbox.
// ============================================================================

enum MessagingCampaignStatus {
  draft
  awaiting_approval
  approved
  scheduled
  expanding
  queued
  sending
  completed
  partially_failed
  cancelled
  failed
}

/// A saved, re-runnable audience rule. `definition` is a neutral condition tree
/// compiled to a Prisma filter in code (see audience-segment.dsl.ts) rather than
/// stored SQL — a stored predicate is an injection surface and cannot be
/// tenant-checked at read time.
model AudienceSegment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name        String
  description String?

  /// `{ match: 'all' | 'any', conditions: [{ field, op, value }] }`.
  definition Json

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns MessagingCampaign[]

  @@unique([organisationId, name])
  @@index([organisationId, updatedAt])
}

model MessagingCampaign {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name        String
  description String?

  /// 'whatsapp' today. Email/SMS/RCS adapters exist as contracts and fixtures;
  /// a campaign may not be approved on a channel whose adapter is not live.
  channel String @default("whatsapp")

  status MessagingCampaignStatus @default(draft)

  segmentId String?
  segment   AudienceSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  /// The segment definition FROZEN at approval. Expansion reads this, never the
  /// live segment: editing a saved segment after approval must not silently
  /// change who a scheduled campaign reaches.
  audienceSnapshot Json?

  /// Template identity as the provider knows it. Both required for WhatsApp —
  /// a name without a language is not a template.
  templateName     String?
  templateLanguage String?
  /// Resolved IntegrationAsset at approval time, so a template deleted from the
  /// tenant afterwards fails loudly instead of sending something else.
  templateAssetId  String?
  /// Rendered example for the review screen. NOT what is sent.
  bodyPreview      String?

  /// Store scope. Empty = every store the approver can see.
  storeIds String[] @default([])

  scheduledAt DateTime?

  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?

  /// What the provider looked like at approval: provider code, template verdict
  /// and its age. Kept so a later dispute can be answered from the record.
  providerSnapshot Json?

  /// Optional credit back to the planning module.
  marketingCampaignId String?

  /// Set once expansion succeeds; makes re-expansion a no-op.
  expandedAt DateTime?
  /// Terminal-state stamp, so `completed` vs `partially_failed` is not recomputed.
  finishedAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]

  @@index([organisationId, status, scheduledAt])
  @@index([organisationId, createdAt])
}

/// One person, one campaign, exactly once.
///
/// The unique key is what makes expansion idempotent: a retried or duplicated
/// expansion job re-inserts the same rows and loses on the constraint instead of
/// messaging anyone twice. `contactValue` is the NORMALIZED key (E.164), not the
/// display value, for the same reason identity matching uses it.
model CampaignRecipient {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  campaignId String
  campaign   MessagingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  partyId      String?
  contactValue String

  /// 'pending' | 'excluded' | 'queued' | 'sent' | 'delivered' | 'read'
  /// | 'failed' | 'dead' | 'cancelled'
  status String @default("pending")

  /// Why this row will never be sent. Set with status='excluded' at expansion
  /// (consent, STOP, no usable number) or at send time when consent changed
  /// between preview and send — the recheck that makes a stale preview safe.
  exclusionReason String?

  /// The Message row the outbox created. Delivery receipts flow back to this
  /// recipient through it.
  messageId String?

  queuedAt  DateTime?
  sentAt    DateTime?
  lastError String?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, contactValue])
  @@index([organisationId, campaignId, status])
  @@index([messageId])
}

// ============================================================================
// CARATOS BLOCK 5 — TELEPHONY
//
// Provider-neutral. Nothing here names Exotel or Tata Tele: a provider is a code
// and the webhook that writes these rows normalises whatever shape it arrived
// in. That is what lets a second telephony provider exist without a migration.
//
// RECORDINGS ARE REFERENCED, NEVER COPIED. `recordingUrl` is the provider's own
// URL and `recordingExpiresAt` is when it stops working. Copying audio into our
// own storage would mean holding customer call recordings under a retention
// policy nobody has agreed, in a jurisdiction nobody has chosen.
// ============================================================================

model CallLog {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId String?

  /// What this call was about. All nullable: a call can precede any of them.
  taskId         String?
  task           Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  partyId        String?
  party          Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?

  /// 'inbound' | 'outbound'
  direction String

  /// Provider code, or 'manual' when a person dialled from their own handset and
  /// logged it afterwards. A manual row is honest about having no provider
  /// evidence behind it.
  provider String @default("manual")

  /// The provider's own call id. Unique per tenant+provider, which is what makes
  /// a replayed webhook a no-op instead of a duplicate call in the report.
  providerCallId String?

  agentUserId String?
  agent       User?   @relation("CallLogAgent", fields: [agentUserId], references: [id])

  /// E.164, normalized. Masked at read time by role — the raw value is needed to
  /// match a call to a customer, and is not needed by everyone who reads a list.
  fromNumber String?
  toNumber   String?

  startedAt   DateTime  @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int?

  /// What the agent decided. Tenant-configurable vocabulary, so a string rather
  /// than an enum: 'connected', 'no_answer', 'callback', 'not_interested', …
  disposition String?
  notes       String?

  /// Reference only, and time-limited. See the header.
  recordingUrl       String?
  recordingExpiresAt DateTime?

  /// Provenance matters: a machine transcript and a human note are not the same
  /// evidence, and a summary generated by a model must never be presentable as
  /// something the customer said.
  transcript       String?
  transcriptSource String?
  summary          String?
  summarySource    String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, provider, providerCallId])
  @@index([organisationId, startedAt])
  @@index([organisationId, taskId])
  @@index([organisationId, partyId, startedAt])
}

// ============================================================================
// CARATOS BLOCK 4 — FEEDBACK, AND THE LINE BETWEEN INTERNAL AND PUBLIC
//
// The single rule this model exists to enforce: a customer is asked ONE
// question, and where their answer goes afterwards depends on what they said.
// A happy customer may be offered the tenant's public review link. An unhappy
// one is routed to a human and is NEVER shown that link.
//
// Inverting that — inviting everyone to review publicly and hoping — is review
// gating in the other direction and is how a business collects its own worst
// reviews. It is also why `escalatedTaskId` exists: a bad rating that nobody is
// made to answer is just a number in a report.
// ============================================================================

model FeedbackRequest {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId String?
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)

  /// What prompted the ask. All nullable: a tenant may ask after a visit, an
  /// order, or a closed task, and adding a column per trigger would mean a
  /// migration each time a tenant invents a new one.
  checkInId String?
  saleId    String?
  taskId    String?

  /// Unguessable, and the only thing the public response page accepts. The
  /// tenant is resolved FROM this server-side, never from the request, so a
  /// caller cannot choose whose CRM to write into.
  publicKey String @unique

  /// 'scheduled' | 'processing' | 'pending' | 'sent' | 'responded' | 'expired' | 'cancelled'
  ///
  /// `scheduled` is an automatic ask not yet due; `processing` is a sweep holding
  /// it. Neither has asked anybody anything, so neither counts as requested.
  status String @default("pending")

  /// The outbound Message, when one was sent. Null for a request created but
  /// not yet delivered, or one collected in person.
  messageId String?

  sentAt      DateTime?
  respondedAt DateTime?
  expiresAt   DateTime?

  /// 1..5. Null until they answer.
  rating  Int?
  comment String?

  /// Set when the rating was low enough that a human was put on it. Holding the
  /// id rather than a boolean means the escalation can be followed to the person
  /// who owns it.
  escalatedTaskId String?

  /// True once this response was offered the public review link. Recorded so a
  /// tenant can prove it never invited an unhappy customer to review publicly.
  reviewLinkOffered Boolean @default(false)

  /// 'manual' | 'visit_auto'. An automatic ask after a walk-in that ended with no
  /// follow-up booked. It is a feedback request, never a sales follow-up.
  origin       String    @default("manual")
  scheduledFor DateTime?
  /// One automatic ask per visit, whatever retries or a second checkout do.
  dedupeKey    String?   @unique
  /// Why an automatic ask did not go out on WhatsApp, in words a manager can act on.
  deliveryNote String?
  dispatchAttempts Int   @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organisationId, status, createdAt])
  @@index([organisationId, storeId, respondedAt])
  @@index([organisationId, partyId])
  @@index([status, scheduledFor])
}

/// How long a customer may wait for a first reply, per tenant.
///
/// From the meeting: "a customer message must be answered within five minutes".
/// Five is the Éclat number, not the product's — a clinic answering emails and a
/// showroom answering WhatsApp do not share a target, so the number is
/// configuration and the default is OFF.
model ConversationSlaSettings {
  organisationId String       @id
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Minutes allowed for the first genuine reply. NULL means the SLA is not
  /// running at all: no clocks are opened and nothing changes for a tenant who
  /// has not chosen a number. Setting it to 5 is what the meeting asked for.
  firstResponseMinutes Int?

  /// Minutes from the customer's message at which an unanswered thread goes to
  /// the store manager. NULL means it never escalates — a breach still alerts
  /// the assigned employee and still lands in the calling queue.
  ///
  /// Measured from the START of the clock, not from the breach, so "five minutes
  /// to answer, fifteen before your manager hears about it" is written as 5 and
  /// 15 rather than 5 and 10. The service refuses a value below the target.
  escalateAfterMinutes Int?

  /// Whether a breach may place an automatic outbound call.
  ///
  /// False by default, and today it changes nothing either way: no telephony
  /// provider in this system can PLACE a call — the telephony integration is an
  /// inbound webhook. The flag exists so the answer to "does it ring the
  /// customer automatically?" is a recorded decision plus a live-provider check,
  /// rather than something a future connector could switch on by accident.
  autoCallOnBreach Boolean @default(false)

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One first-response clock: a customer said something, and this is whether
/// anybody answered in time.
///
/// ── Why a row and not a computed view ────────────────────────────────────────
///
/// The breach alert, the calling-queue task and the escalation each have to
/// happen EXACTLY ONCE, across restarts and across replicas. A view can tell you
/// a thread is late; it cannot remember that somebody was already told. The
/// `breachedAt`/`escalatedAt` columns are claimed by a conditional UPDATE, so
/// whichever instance gets the row does the work and the others see zero rows
/// affected and do nothing.
///
/// ── One open clock per conversation ──────────────────────────────────────────
///
/// `openConversationId` holds the conversation id while the clock runs and NULL
/// once it stops. Postgres treats NULLs as distinct in a unique index, so this
/// is a partial-unique in disguise: a second customer message on a thread that
/// is already waiting cannot start a second clock. That is the right reading of
/// "first response" — the wait is measured from the first unanswered message,
/// not restarted by an impatient customer sending three in a row.
model ConversationResponseSla {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The branch that owes the reply. Null for an unrouted thread — which is
  /// still tracked, because "nobody's branch" is the worst case, not an excuse.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// The customer message that started the wait. Also the idempotency key: the
  /// same inbound message can never open two clocks.
  triggerMessageId String

  /// conversationId while waiting, NULL once answered or closed. See above.
  openConversationId String? @unique

  startedAt DateTime
  /// startedAt + target. Stored rather than recomputed so changing the tenant's
  /// target does not retroactively breach or un-breach threads already running.
  dueAt     DateTime
  /// startedAt + escalation delay, or NULL when the tenant does not escalate.
  escalateAt DateTime?
  /// The target in force when this clock started, kept for the same reason.
  targetMinutes Int

  /// 'waiting' | 'met' | 'breached'.
  ///
  /// A thread answered AFTER it breached stays 'breached' — the breach happened,
  /// and a late reply does not unhappen it — but still records respondedAt and
  /// responseSeconds, which is how "how long did they actually wait" stays
  /// answerable for the ones that went wrong.
  status String @default("waiting")

  respondedAt     DateTime?
  responderId     String?
  responder       User?     @relation("SlaResponder", fields: [responderId], references: [id])
  /// 'agent' | 'ai' — an approved AI reply counts, and is never recorded as a
  /// person's.
  responderType   String?
  responseSeconds Int?

  breachedAt  DateTime?
  escalatedAt DateTime?
  /// The calling-queue task a breach created, so the queue and the SLA row point
  /// at each other instead of duplicating on a re-run.
  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, triggerMessageId])
  /// The sweep's own query: everything still owed, oldest deadline first.
  @@index([status, dueAt])
  @@index([organisationId, storeId, startedAt])
}

/// A report that arrives without anybody asking for it.
///
/// From the meeting: the month-end lead report should land in an inbox on the
/// first of the month rather than being remembered, filtered and downloaded by
/// hand. The manual export stays exactly as it is — this is the same workbook,
/// on a schedule, with the columns the tenant chose.
model ScheduledReport {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// What the tenant calls it. Unique per tenant so two people cannot both
  /// create "Monthly leads" and then argue about which one is wrong.
  name String

  /// 'leads' — the only report shape today. A string rather than an enum because
  /// the next one is a new value, not a migration of every existing row.
  kind String @default("leads")

  /// Null = every branch. A report scoped to one branch is the common case for a
  /// store manager; head office wants the chain.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// 'monthly' | 'weekly'. Monthly runs on the 1st for the month just ended;
  /// weekly runs on Monday for the week just ended. Both are "the period that
  /// has finished", never a partial one — a report covering three days of a
  /// month is the kind of number somebody quotes in a meeting by mistake.
  cadence String @default("monthly")

  /// The hour, at the BRANCH, to send it. The scheduler ticks hourly and asks
  /// each report what time it is where its store is, so a chain across two
  /// timezones gets its report at breakfast in each.
  sendHour Int @default(7)

  /// Which columns, in which order. Empty means every column the export has.
  /// This is the configurable mapping: a tenant that only wants name, phone and
  /// follow-up date gets a file with three columns, not sixteen and a hidden
  /// instruction to ignore thirteen of them.
  columns String[]

  /// Where it goes. Email addresses; an empty list produces the file and records
  /// that nobody was configured to receive it, rather than failing silently.
  recipients String[]

  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ScheduledReportRun[]

  @@unique([organisationId, name])
  @@index([organisationId, isActive])
}

/// One delivery of one scheduled report.
///
/// `@@unique([reportId, periodKey])` is the idempotency guard, and it is the
/// whole reliability story: an hourly tick that overlaps, a replica, a restart
/// mid-send, or a manual re-run all collide on the same key and the second one
/// does nothing. Nobody gets September's leads twice.
model ScheduledReportRun {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  reportId       String
  report         ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// '2026-08' for a month, '2026-W35' for a week. The period the file COVERS,
  /// not the day it was sent — which is what makes a re-run a no-op instead of a
  /// second copy with a different name.
  periodKey  String
  periodFrom DateTime
  periodTo   DateTime

  rows Int @default(0)

  /// 'ok' | 'empty' | 'failed'. `empty` is a real outcome and is reported as
  /// one: a branch with no leads last month gets a row saying so rather than a
  /// blank spreadsheet that reads like a broken job.
  status String  @default("ok")
  detail String?

  /// 'sent' | 'dry_run' | 'no_recipients' | 'failed'.
  ///
  /// `dry_run` is the honest label for "SMTP is not configured here". The file
  /// was built and nothing was delivered; saying 'sent' would be a lie the
  /// tenant only discovers by asking why they never got it.
  emailStatus String  @default("no_recipients")
  emailDetail String?
  recipients  String[]

  createdAt DateTime @default(now())

  @@unique([reportId, periodKey])
  @@index([organisationId, createdAt])
}

/// A column mapping somebody already worked out once.
///
/// The import pipeline already maps any spreadsheet's columns onto canonical
/// fields, but the mapping was re-done by hand on every upload. A supplier file
/// arrives every month with the same forty columns, and re-mapping it monthly is
/// both tedious and the place a mistake creeps in — the column that was "Cost"
/// last month is "Cost Price" this month and nobody notices it landed in
/// `price`.
///
/// A profile remembers the answer AND the question: `sourceHeaders` is the header
/// row it was built from, so applying it to a file whose columns have changed
/// reports what moved instead of silently mapping the wrong column.
model ImportMappingProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// The tenant's name for it — "Gati monthly stock", "Tally customers".
  name String

  /// 'customers' | 'stores' | 'products'. A profile is only valid for the entity
  /// it was built against; the canonical fields differ per entity.
  entity String

  /// `[{ sourceColumn, canonicalField }]` — exactly the shape the import
  /// endpoints already take, so a saved profile is replayed, not translated.
  mappings Json

  /// The header row this was built from. Kept so a file with renamed, added or
  /// removed columns is REPORTED rather than quietly mapped by position.
  sourceHeaders String[]

  createdById String?
  lastUsedAt  DateTime?
  useCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, entity, name])
  @@index([organisationId, entity])
}

/// When a piece counts as dead.
///
/// 180 days was a constant in two places — the service and the frontend — and
/// wrong for everybody. A chain moves in weeks; a bridal set is expected to sit.
/// Counting them against one threshold makes the dead-stock figure either alarm
/// about normal inventory or say nothing at all, and either way nobody acts on
/// it.
///
/// One row per (tenant, category), plus one row with a null category as the
/// tenant's default. Absent entirely means the platform default still applies,
/// so this changes nothing for a tenant that has not configured it.
model DeadStockPolicy {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// NULL = the tenant's default for anything without its own rule.
  category ProductCategory?

  /// Days in stock past which a piece is dead.
  thresholdDays Int

  /// Days at which it is worth looking at but not yet dead. NULL = no warning
  /// band, which is the honest answer for a tenant that only wants one line.
  warnAfterDays Int?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// One rule per category. The "exactly one DEFAULT" half cannot be expressed
  /// here — Postgres treats NULLs as distinct, so (org, NULL) would be insertable
  /// repeatedly. The migration adds a partial unique index on organisationId
  /// WHERE category IS NULL for that.
  @@unique([organisationId, category])
}

/// One employee's weekly off day.
///
/// Until now the week off was a property of the STORE: one day, everybody, every
/// week. A shop that never closes cannot work that way — the staff rotate, and
/// marking the whole branch off on a Tuesday when half of it is on the floor
/// makes the attendance register fiction.
///
/// A row per employee per off day, so somebody with two days off has two rows.
/// NO rows means the employee follows the store's `weekOffDay`, which is what
/// keeps every existing tenant behaving exactly as it does today.
model StaffWeekOff {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The branch this roster belongs to. An employee mapped to two branches can
  /// have a different off day at each.
  storeId String?

  /// 0 = Sunday … 6 = Saturday, read in the STORE's timezone.
  dayOfWeek Int

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([userId, storeId, dayOfWeek])
  @@index([organisationId, storeId])
}

/// What an employee is paid, and on what basis.
///
/// Deliberately thin. This is not a payroll system: there is no tax table, no
/// statutory deduction engine, no bank file. It holds the few numbers needed to
/// turn an attendance register into a payslip, and everything it cannot compute
/// honestly it leaves to the accountant rather than guessing.
model StaffCompensation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'monthly' — a fixed salary, of which unpaid absence is deducted.
  /// 'daily'   — a wage per day actually worked.
  ///
  /// The distinction is not cosmetic: on a monthly basis the weekly offs and
  /// holidays are PAID, on a daily basis they are not, and paying one as the
  /// other is a real overpayment or a real underpayment every month.
  basis String @default("monthly")

  /// Monthly gross for 'monthly', or the day rate for 'daily'.
  amount Decimal @db.Decimal(12, 2)

  /// Paid leave days a month before an absence starts costing money. Null = none,
  /// so every unapproved absence is a deduction.
  paidLeavePerMonth Decimal? @db.Decimal(4, 1)

  /// Per HOUR. Null means overtime is not paid — the honest default, because
  /// paying it by accident is worse than the conversation about whether to.
  overtimeHourlyRate Decimal? @db.Decimal(10, 2)

  effectiveFrom DateTime? @db.Date
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// One employee's pay for one month, computed from the attendance register.
///
/// ── Why every figure is stored, not derived ─────────────────────────────────
///
/// A payslip is a statement about money that somebody may query six months
/// later. If it recomputed from live data, a roster edited in October would
/// silently change September's payslip, and the number the employee was shown
/// would no longer exist anywhere. Everything that went into the figure is
/// frozen here at generation, including the day-by-day breakdown.
///
/// ── What this is not ────────────────────────────────────────────────────────
///
/// Not statutory payroll. No tax, no PF, no ESI, no bank file. It answers "how
/// many days was this person paid for, and what does that come to", which is the
/// question the attendance register can actually answer. Anything requiring a
/// tax table is left to the accountant rather than approximated.
model Payslip {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String?

  /// '2026-09'. The period the slip COVERS.
  periodKey   String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  /// 'draft' | 'issued'. A draft recomputes on request; an issued one never
  /// changes, because it is what the employee was shown.
  status     String    @default("draft")
  issuedAt   DateTime?
  issuedById String?

  // ── The attendance, as counted ────────────────────────────────────────────
  calendarDays  Int
  weeklyOffDays Int
  holidayDays   Int
  /// Sum of dayFraction: a half day counts 0.5, which is what payroll consumes.
  presentDays   Decimal @db.Decimal(5, 2)
  paidLeaveDays Decimal @db.Decimal(5, 2)
  /// Absences nobody paid for. The number that actually costs the employee.
  unpaidDays    Decimal @db.Decimal(5, 2)
  overtimeMins  Int     @default(0)

  // ── The money, as computed ────────────────────────────────────────────────
  basis            String
  /// The compensation figures AS THEY WERE when this was generated.
  amount           Decimal  @db.Decimal(12, 2)
  perDayRate       Decimal  @db.Decimal(12, 2)
  earnedAmount     Decimal  @db.Decimal(12, 2)
  overtimeAmount   Decimal  @db.Decimal(12, 2) @default(0)
  deductionAmount  Decimal  @db.Decimal(12, 2) @default(0)
  netPay           Decimal  @db.Decimal(12, 2)

  /// Day by day, so a disputed slip can be walked line by line rather than
  /// argued about from a single total.
  breakdown Json?

  /// Set when the register, counted again AFTER this slip was issued, no longer
  /// agrees with it — a correction that arrived late. The issued figures above
  /// are never rewritten; this is the flag beside them, naming the days that
  /// changed, for a person to settle. Cleared if the register comes back into
  /// agreement.
  difference           Json?
  differenceDetectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodKey])
  @@index([organisationId, periodKey])
  @@index([organisationId, storeId, periodKey])
}

/// One payroll run for one branch and one month: the month-end scheduler's, or
/// a person re-running it.
///
/// This is the answer to "did August's payroll actually get drafted?", which
/// nothing recorded before. It only ever produces DRAFTS — issuing stays a
/// person's act.
model PayrollRun {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId   String
  /// '2026-08'. The month the run drafted.
  periodKey String

  /// 'scheduler' | 'user'
  trigger         String
  triggeredById   String?
  triggeredByName String?

  /// 'started' | 'completed' | 'failed'. A 'started' row that never finished is
  /// a process that died mid-run; a re-run recovers it.
  status String @default("started")

  /// Drafts written, employees that could not be drafted (named in
  /// `skippedDetail`), issued slips left alone, and how many of those the
  /// register now disagrees with.
  generated     Int     @default(0)
  skipped       Int     @default(0)
  issued        Int     @default(0)
  differences   Int     @default(0)
  skippedDetail Json?
  error         String?

  /// The scheduler's claim, "<storeId>:<periodKey>", on its run only. Unique, so
  /// a retried tick, a restart or a second replica cannot draft a month twice.
  /// NULL on a person's re-run, which may happen as often as they need.
  schedulerKey String? @unique

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([organisationId, storeId, periodKey])
}

// ============================================================================
// BLOCK 11 — the loyalty website API
// ============================================================================
//
// ── Why a points ledger and not a balance column ────────────────────────────
//
// A balance is a conclusion. When a customer stands at a counter saying "your
// website told me I had 4,000 points", the only useful answer is the list of
// things that happened: earned on this bill, redeemed on that one, reversed
// because the sale was cancelled. A single mutable number cannot produce that
// answer, and cannot be reconciled against the website afterwards.
//
// So every movement is a row, `points` is SIGNED, and `balanceAfter` is written
// at the same instant inside the same transaction. The balance on the account is
// a cache of the last entry's `balanceAfter`, kept only so a lookup does not sum
// the ledger. If the two ever disagree the ledger wins, and the entries are the
// thing a dispute is settled from.
//
// ── Why idempotency is a database constraint, not a check ───────────────────
//
// The caller here is somebody else's website, retrying over a network we do not
// control. "Did my redeem go through?" cannot be answered by asking again — the
// second call would debit again. `(organisationId, idempotencyKey)` is unique,
// so a replay collides in the database and returns the ORIGINAL entry. Two
// concurrent identical requests cannot both win; that is a property of the
// index, not of the order the application happens to read in.

/// A customer's standing in the tenant's loyalty programme.
///
/// Keyed by phone, because that is what the website's visitor can type and what
/// the counter already asks for. `partyId` links it to the CRM customer once one
/// exists — which is often AFTER the account (somebody joins on the website
/// before they ever walk in), so it is nullable on purpose and never a gate.
model LoyaltyAccount {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Set once the customer is matched into the CRM. Never used for scoping.
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  /// Normalised to digits, the same way the CRM normalises a contact number.
  phone String
  name  String?

  /// The branch that enrolled them. Nullable: a website signup has no branch.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// Cache of the newest entry's `balanceAfter`. The ledger is authoritative.
  pointsBalance    Int @default(0)
  lifetimeEarned   Int @default(0)
  lifetimeRedeemed Int @default(0)

  /// The tenant's own label ('silver', 'gold'). Never computed here: a tier
  /// threshold is a business rule the tenant owns, and one invented in code is
  /// one nobody can change.
  tier String?

  /// 'active' | 'suspended' | 'closed'. A suspended account can be read but
  /// cannot earn or redeem, which is what a fraud hold actually needs.
  status String @default("active")

  enrolledAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries LoyaltyLedgerEntry[]

  @@unique([organisationId, phone])
  @@index([organisationId, partyId])
  @@index([organisationId, storeId])
}

/// One movement of points. Append-only: nothing here is ever updated except the
/// webhook bookkeeping columns at the bottom.
model LoyaltyLedgerEntry {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// 'earn' | 'redeem' | 'reversal' | 'adjustment'
  kind String

  /// SIGNED. An earn is positive, a redeem negative, a reversal the exact
  /// negation of the entry it undoes. Summing the column gives the balance,
  /// which is the property that makes the ledger auditable.
  points Int

  /// The balance immediately after this entry, written in the same transaction.
  /// This is what makes a statement printable without re-summing history.
  balanceAfter Int

  /// The money this movement corresponds to, when there is any — a bill total
  /// for an earn, the discount given for a redeem. Recorded for reconciliation
  /// against the tenant's own sales, never used to recompute points.
  amount Decimal? @db.Decimal(14, 2)

  /// The caller's replay key. NULL for movements made inside CaratOS, where
  /// there is no network to retry across. Postgres treats NULLs as distinct, so
  /// the unique index below constrains only the calls that supplied one.
  idempotencyKey String?

  /// The entry this one reverses. Unique, so an entry can be reversed ONCE:
  /// two concurrent reversals of the same sale cannot both succeed.
  reversesId String?             @unique
  reverses   LoyaltyLedgerEntry? @relation("LoyaltyReversal", fields: [reversesId], references: [id])
  reversedBy LoyaltyLedgerEntry? @relation("LoyaltyReversal")

  /// Free text for the statement line ("Diwali purchase", "cancelled sale").
  reason String?
  /// The caller's own identifier — invoice number, web order id. Not unique:
  /// one invoice can legitimately produce an earn and later a reversal.
  reference String?

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// 'website' | 'store' | 'system'. Where the movement came from, so a
  /// statement can say "earned online" without guessing.
  source String @default("store")
  /// 'api_client' | 'user' | 'system', and which one.
  actorType String
  actorId   String?

  // ── Outbound notification bookkeeping ─────────────────────────────────────
  //
  // Points also move at the counter, and the website's cached balance goes stale
  // the moment they do. So every entry is announced to the tenant's configured
  // endpoint, signed. These three columns record what actually happened to that
  // announcement: a webhook nobody can see the failure of is worse than none.
  webhookAttempts Int       @default(0)
  webhookedAt     DateTime?
  webhookError    String?
  /// Every announcement of this entry and what happened to it.
  webhookDeliveries LoyaltyWebhookDelivery[]

  createdAt DateTime @default(now())

  @@unique([organisationId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([organisationId, createdAt])
  /// The retry sweep's read: unannounced entries, oldest first.
  // Named as Postgres stored it: the migration spelt the name past 63 characters.
  @@index([organisationId, webhookedAt, webhookAttempts], map: "LoyaltyLedgerEntry_organisationId_webhookedAt_webhookAttempts_i")
}

/// One announcement of one ledger movement to the tenant's website, and
/// everything that happened to it.
///
/// The entry's own webhook columns say only whether it landed. This says when,
/// where, how many times, what the website answered and why it did not — which
/// is what a person needs to fix a broken integration without reading logs. The
/// sending itself rides the durable job queue, so retries, backoff and the dead
/// state are the queue's, not a second policy.
///
/// Holds no body and no secret. `payloadSha256` identifies the exact bytes sent
/// without keeping them.
model LoyaltyWebhookDelivery {
  /// Also the EVENT ID: sent as `eventId` and `x-caratos-event-id`, identical on
  /// every attempt and every manual retry, so the receiver can drop a repeat.
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// The movement being announced — the replay reference.
  entryId String
  entry   LoyaltyLedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// 'loyalty.movement'
  eventType String

  /// Scheme, host and path of the URL last attempted. Query string and any
  /// credentials in the URL are removed: a receiver's token often lives there.
  destination String?

  /// 'pending' | 'delivered' | 'failed' | 'dead'. Delivered is set only on a 2xx.
  status        String    @default("pending")
  attempts      Int       @default(0)
  responseCode  Int?
  /// Redacted, and short. Never the response body.
  lastError     String?
  nextAttemptAt DateTime?
  payloadSha256 String?
  /// The JobTask carrying it.
  jobId         String?
  /// The last attempts, newest last: { at, responseCode, error, durationMs }.
  attemptLog    Json?

  manualRetries   Int     @default(0)
  lastRetriedById String?

  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime?
  deliveredAt   DateTime?
  deadAt        DateTime?
  updatedAt     DateTime  @updatedAt

  /// One announcement per movement per event. A replay finds this row.
  @@unique([organisationId, entryId, eventType])
  @@index([organisationId, status, createdAt])
}

// ============================================================================
// BLOCK 12 — which number does this branch send from
// ============================================================================
//
// ── The problem, concretely ─────────────────────────────────────────────────
//
// A business with eight WhatsApp numbers across two WABA accounts had, until
// now, exactly one sender: `senderFor` read the tenant's phone-number assets
// ordered by creation date and took the FIRST. Every branch therefore sent from
// whichever number was registered first, and a customer who wrote to the Surat
// shop was answered from the Mumbai one. The registry made this worse by
// design, deactivating every other number whenever a new one was registered —
// "exactly one active sender per connection" was a deliberate simplification
// that is now the blocker.
//
// ── Why a route table and not a column on Store ────────────────────────────
//
// A column would answer "which number does this branch use" for WhatsApp and
// then need a second column for Instagram, a third for SMS. More importantly a
// column cannot express what actually has to be true: the same number may serve
// several branches (a head-office line answering for three shops), and a branch
// may have no number of its own and correctly fall back. A row per
// (branch, channel) says exactly that, and its absence is a meaningful state
// rather than a null that has to be interpreted.
//
// ── Why the conversation remembers its number ──────────────────────────────
//
// `Conversation.senderAssetId` is the number the thread ARRIVED on, and it
// outranks the branch route when a reply goes out. A customer who wrote to a
// number must be answered from that number: replying from a different one
// starts a second thread on their phone, loses the 24-hour customer-care window
// on the first, and reads as a different business. The branch route is what
// decides where a NEW outbound conversation starts.

/// Which sender a branch uses on one channel.
///
/// The asset is the provider identity (a WhatsApp phone-number id); the
/// integration is the account that owns it. Both are stored so a route cannot
/// outlive the connection it depends on.
model StoreMessagingRoute {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// 'whatsapp' | 'instagram' | 'sms' | 'email'. Kept as a string for the same
  /// reason the Conversation channel is: a new channel must not need a
  /// migration to an enum before a tenant can be routed on it.
  channel String

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// The phone-number (or equivalent) asset this branch sends from.
  assetId String
  asset   IntegrationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Who set it, for the conversation that follows "why is Surat sending from
  /// the Mumbai number".
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// One sender per branch per channel. Two would be a coin toss at send time.
  @@unique([storeId, channel])
  @@index([organisationId, channel])
  @@index([assetId])
}


// ===========================================================================
// Employee master, roster and the attendance ledger (Module 6).
//
// A person is a User; EmployeeProfile is their employment record beside it,
// never a second person. Departments and designations are masters with stable
// ids, so "Bandra" and "BANDRA" are one department and renaming one never
// rewrites history.
// ===========================================================================

enum EmploymentStatus {
  active
  /// On the books but not working (long leave, suspended). Not marked absent.
  inactive
  /// Left. Kept for history; never counted from `exitDate` on.
  separated
}

model Department {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  /// The branch this department is, when it is one (EzAttendance used
  /// departments for stores: "BANDRA", "Kala Ghoda"). Null for head office teams.
  storeId        String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees EmployeeProfile[]

  @@unique([organisationId, name])
}

model Designation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employees EmployeeProfile[]

  @@unique([organisationId, name])
}

model EmployeeProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String       @unique
  user           User         @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  /// "ED003". Unique per organisation; what payroll and the biometric device use.
  employeeCode   String
  biometricNo    String?
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  designationId  String?
  designation    Designation? @relation(fields: [designationId], references: [id])
  /// EzAttendance "UNIT" (city / legal unit), kept as text.
  unit           String?
  reportingManagerId String?
  gender         String?
  dateOfBirth    DateTime?    @db.Date
  dateOfJoining  DateTime?    @db.Date
  dateOfConfirmation DateTime? @db.Date
  exitDate       DateTime?    @db.Date
  exitReason     String?
  /// full_time | part_time | contract
  employmentType String       @default("full_time")
  status         EmploymentStatus @default(active)
  bloodGroup     String?
  address        String?
  personalEmail  String?
  /// Legacy shift code ("S", "G", "F", "6HR") until a ShiftAssignment exists.
  shiftCode      String?
  /// manual | ezattendance
  source         String       @default("manual")
  /// The source row exactly as imported, so cleaning never loses evidence.
  sourceRaw      Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, employeeCode])
  @@index([organisationId, status])
}

/// Which shift an employee works, from a date. History is never rewritten:
/// a change closes the open row and opens a new one.
model ShiftAssignment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId        String
  effectiveFrom  DateTime     @db.Date
  /// Inclusive last day; null = open-ended.
  effectiveTo    DateTime?    @db.Date
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([userId, effectiveFrom])
  @@index([organisationId])
}

/// One punch as it happened. Append-only: a correction is a new event with
/// source "manager"/"regularization", never an edit. The daily register
/// (AttendanceRecord) is computed from these.
model RawPunchEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String
  storeId        String?
  /// in | out
  kind           String
  eventAt        DateTime
  receivedAt     DateTime     @default(now())
  /// self | manager | regularization | import | device | auto
  source         String
  externalId     String?
  /// Replays of the same punch land here and are ignored.
  idempotencyKey String
  lat            Decimal?     @db.Decimal(10, 7)
  lng            Decimal?     @db.Decimal(10, 7)
  accuracyM      Int?
  note           String?
  createdById    String?
  /// Set when a manager voids a punch; the row stays as evidence.
  voidedAt       DateTime?
  voidedById     String?

  @@index([organisationId, eventAt])
  @@index([userId, eventAt])
  @@unique([organisationId, idempotencyKey])
}

model AttendanceProcessingRun {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  storeId        String?
  fromDate       DateTime     @db.Date
  toDate         DateTime     @db.Date
  /// running | done | failed
  status         String       @default("running")
  processed      Int          @default(0)
  changed        Int          @default(0)
  skippedLocked  Int          @default(0)
  errors         Json?
  startedById    String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  @@index([organisationId, startedAt])
}

/// A payroll month closed to edits. Attendance, leave and punches dated inside
/// it are refused until head office reopens it with a reason.
model PayrollPeriodLock {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  /// "YYYY-MM"
  month          String
  lockedAt       DateTime     @default(now())
  lockedById     String?
  reopenedAt     DateTime?
  reopenedById   String?
  reopenReason   String?

  @@unique([organisationId, month])
}


// ===========================================================================
// Lossless catalogue sources (Module 5). See docs/modules/05-catalogue-sources.md.
//
// The website owns marketing: name, categories, tags, sizes, variants, colours,
// photos, online prices, publication and SEO. Gati owns the physical piece:
// stock, stores, tag, style number, weights, hallmark/HUID/certificate, HSN and
// the tag price. Each source writes only its own columns/tables, so neither can
// silently overwrite the other.
// ===========================================================================

/// The source record exactly as received, one row per external product.
/// `payloadHash` makes a re-sync of an unchanged product a no-op.
model ExternalProductSnapshot {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  /// website | gati
  source         String
  /// The source's own id (website `_id`); falls back to the product code.
  externalId     String
  productCode    String?
  schemaVersion  Int          @default(1)
  payload        Json
  payloadHash    String
  sourceUpdatedAt DateTime?
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  /// Set when a full run no longer sees it, or the source marks it deleted.
  goneAt         DateTime?
  syncRunId      String?
  /// ok | error | conflict
  normalizationStatus String  @default("ok")
  normalizationError  String?
  productId      String?

  @@unique([organisationId, source, externalId])
  @@index([organisationId, source, productCode])
}

/// Website-owned marketing record for a design, kept beside the Product so a
/// Gati sync never touches it and vice versa.
model ProductWebsiteListing {
  id              String       @id @default(cuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  productId       String       @unique
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalId      String
  productCode     String
  marketingName   String
  slug            String?
  categories      String[]
  subCategories   String[]
  features        String[]
  tags            String[]
  countries       String[]
  isActive        Boolean      @default(true)
  isDeleted       Boolean      @default(false)
  description     String?
  /// Customer-facing specification text, verbatim, with its conflicts flagged
  /// separately (CatalogueConflict kind `spec_mismatch`).
  specifications  String?
  sizeGuide       String?
  seo             Json?
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  lastSeenAt      DateTime     @default(now())
  tombstonedAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organisationId, productCode])
}

/// One purchasable configuration of a design as a source defines it
/// (website: metal type × karat × diamond type). Sizes are NOT multiplied in:
/// they are product-level options unless the source says otherwise.
model ProductVariant {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id])
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// website | gati
  source           String
  /// Stable key within the source: its variant id, else "metal|karat|diamond".
  sourceKey        String
  sku              String?
  metalType        String?
  /// Parsed purity, e.g. 9, 14, 18.
  karat            Int?
  metal            MetalKind?
  diamondType      String?
  colour           String?
  weightType       String?
  goldWeight       Decimal?     @db.Decimal(12, 3)
  diamondWeight    Decimal?     @db.Decimal(10, 3)
  stoneWeight      Decimal?     @db.Decimal(10, 3)
  totalWeight      Decimal?     @db.Decimal(12, 3)
  price            Decimal?     @db.Decimal(14, 2)
  priceWithMargin  Decimal?     @db.Decimal(14, 2)
  /// Internal costing: never in a public/customer response.
  marginPercentage Decimal?     @db.Decimal(6, 2)
  makingCharge     Decimal?     @db.Decimal(14, 2)
  currency         String       @default("INR")
  /// The bill of material lines as the source sent them (internal costing).
  bom              Json?
  attributes       Json?
  status           String       @default("active")
  tombstonedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  stockItems StockItem[]
  imageAssociations ProductImageAssociation[]

  @@unique([productId, source, sourceKey])
  @@index([organisationId])
}

/// Product-level options such as sizes ("IND 6" … "IND 18"), in source order.
model ProductOption {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  source         String
  /// size
  kind           String
  value          String
  sortOrder      Int          @default(0)
  tombstonedAt   DateTime?

  @@unique([productId, source, kind, value])
  @@index([organisationId, kind, value])
}

/// Every price a design carries, labelled by what it is and who said it.
/// kind: indicative | min_variant | natural_diamond | variant |
///       variant_with_margin | gati_tag
model ProductPrice {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// ProductVariant.id for variant prices; "" for product-level prices.
  variantKey     String       @default("")
  source         String
  kind           String
  amount         Decimal      @db.Decimal(14, 2)
  currency       String       @default("INR")
  capturedAt     DateTime     @default(now())

  @@unique([productId, variantKey, source, kind])
  @@index([organisationId, kind, amount])
}

/// Where one stored picture appears in the source: a colour group, a shape, a
/// variant, a position. The same photo reused for three colours is one
/// ProductImage with three associations.
model ProductImageAssociation {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  imageId        String
  image          ProductImage    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  source         String
  colour         String          @default("")
  shape          String          @default("")
  angle          String?
  sourceOrder    Int             @default(0)
  tombstonedAt   DateTime?

  @@unique([imageId, source, colour, shape, sourceOrder])
  @@index([organisationId])
}

/// One catalogue synchronisation, with its receipt. Resumable from `nextPage`.
model CatalogueSyncRun {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  /// website | gati
  source         String
  /// full | delta | resume
  mode           String       @default("full")
  dryRun         Boolean      @default(false)
  /// running | done | partial | failed
  status         String       @default("running")
  nextPage       Int          @default(1)
  pageSize       Int          @default(100)
  expected       Int?
  received       Int          @default(0)
  created        Int          @default(0)
  updated        Int          @default(0)
  unchanged      Int          @default(0)
  tombstoned     Int          @default(0)
  conflicted     Int          @default(0)
  failed         Int          @default(0)
  imagesExpected Int          @default(0)
  imagesReceived Int          @default(0)
  imagesQueued   Int          @default(0)
  /// Preview of what a dry run would change, and per-item failures.
  detail         Json?
  lastError      String?
  startedById    String?
  startedAt      DateTime     @default(now())
  heartbeatAt    DateTime     @default(now())
  finishedAt     DateTime?

  @@index([organisationId, source, startedAt])
}

/// Operator review queue: things a sync refused to guess about.
/// kind: gati_match_none | gati_match_ambiguous | spec_mismatch | unit_mismatch
///       | missing_cad | image_failed | normalization_error
model CatalogueConflict {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  kind           String
  /// Idempotency: the same problem found again updates this row.
  key            String
  productId      String?
  externalId     String?
  summary        String
  detail         Json?
  /// open | resolved | ignored
  status         String       @default("open")
  resolution     Json?
  resolvedById   String?
  resolvedAt     DateTime?
  firstSeenAt    DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())

  @@unique([organisationId, kind, key])
  @@index([organisationId, status])
}
