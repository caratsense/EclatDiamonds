// ============================================================================
// MODULE 6 — HRMS & GEO ATTENDANCE (net-new)
// ============================================================================

model AttendanceRecord {
  id          String           @id @default(cuid())
  storeId     String
  staffId     String
  staffName   String?
  date        DateTime         @db.Date
  status      AttendanceStatus @default(present)
  checkInAt   DateTime?
  checkOutAt  DateTime?
  // Geo-tag captured at check-in (verified against Store geofence).
  checkInLat  Decimal?         @db.Decimal(10, 7)
  checkInLng  Decimal?         @db.Decimal(10, 7)
  geoVerified Boolean          @default(false)

  // Zoho-style HRMS additions (Module 6). All additive/nullable.
  // Geo-tag captured at check-out (verified against Store geofence).
  checkOutLat      Decimal? @db.Decimal(10, 7)
  checkOutLng      Decimal? @db.Decimal(10, 7)
  /// Metres from the store centre at check-in (geofence distance).
  checkInDistanceM Int?
  /// Worked duration in minutes (checkOut − checkIn).
  workedMins       Int?

  // Shift / lateness (Module 6). Lateness is measured against the ASSIGNED shift's
  // start + buffer, so a night/second-batch check-in in the afternoon is not "late".
  shiftId     String?
  isLate      Boolean @default(false)
  lateMinutes Int?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, staffId, date])
  @@index([storeId, date])
}

/// Store shift / batch (Module 6). Mall stores run 2 shifts (morning + night).
/// startTime/endTime are "HH:MM" (24h) store-local; bufferMins is the grace window
/// before a check-in counts as late. Lateness is always vs the assigned shift.
model Shift {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  startTime    String
  endTime      String
  bufferMins   Int      @default(15)
  isNightBatch Boolean  @default(false)
  createdAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

/// Per-store holiday (Module 6), configured by head office alongside weekOffDay.
model StoreHoliday {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime @db.Date
  label     String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, date])
}

model LeaveRequest {
  id        String      @id @default(cuid())
  storeId   String
  staffId   String
  staffName String?
  type      LeaveType
  status    LeaveStatus @default(pending)
  fromDate  DateTime    @db.Date
  toDate    DateTime    @db.Date
  reason    String?

  // Zoho-style HRMS additions (Module 6). All additive/nullable.
  /// Reserved for future configurable leave types; no relation for now.
  leaveTypeId String?
  /// Number of leave days; Decimal(4,1) supports half-days (e.g. 1.5).
  days        Decimal? @db.Decimal(4, 1)
  /// true when this request covers a half day.
  halfDay     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, fromDate])
}

/// Sales-incentive commission rows (Module 6 leaderboard / commission engine).
model Commission {
  id         String  @id @default(cuid())
  userId     String
  storeId    String?
  period     String // e.g. "2026-06"
  salesValue Decimal @default(0) @db.Decimal(14, 2)
  rate       Decimal @default(0) @db.Decimal(5, 2)
  amount     Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, period])
}

/// Per-staff, per-leave-type, per-year leave balance (Zoho-style HRMS, Module 6).
model LeaveBalance {
  id        String    @id @default(cuid())
  userId    String
  storeId   String?
  type      LeaveType
  year      Int
  allocated Decimal   @default(0) @db.Decimal(5, 1)
  used      Decimal   @default(0) @db.Decimal(5, 1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, year])
  @@index([userId, year])
}

/// Request to fix a missed/wrong punch (Zoho-style HRMS regularization, Module 6).
model AttendanceRegularization {
  id                String      @id @default(cuid())
  storeId           String
  staffId           String
  staffName         String?
  date              DateTime    @db.Date
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String?
  status            LeaveStatus @default(pending)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

// ============================================================================
// MODULE 7 — CUSTOMER CHECK-INS & FOOTFALL (net-new; CCTV dropped)
// ============================================================================

model CheckIn {
  id           String         @id @default(cuid())
  storeId      String
  partyId      String?
  customerName String
  phone        String?
  purpose      CheckinPurpose @default(other)
  outcome      CheckinOutcome @default(in_store)
  repId        String?
  repName      String?
  timeIn       DateTime
  timeOut      DateTime?

  createdAt DateTime @default(now())

  store Store  @relation(fields: [storeId], references: [id])
  party Party? @relation(fields: [partyId], references: [id])

  @@index([storeId, timeIn])
}

// ============================================================================
// MODULE 17 — LOYALTY & GOLD SAVINGS SCHEME (net-new; legacy schema-only)
// ============================================================================

/// Scheme plan template. Legacy: SchemeMaster (defined, no data).
model SchemePlan {
  id           String  @id @default(cuid())
  name         String
  tenureMonths Int
  /// Store-funded bonus expressed as extra installments at maturity.
  bonusMonths  Int     @default(0)
  bonusLabel   String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())

  members SchemeMember[]
}

/// Enrolled gold-savings member account. Legacy: SchemeMemberMaster.
model SchemeMember {
  id           String       @id @default(cuid())
  ref          String       @unique
  storeId      String
  partyId      String?
  planId       String
  customerName String
  phone        String?
  /// Monthly installment amount (INR).
  installment  Decimal      @db.Decimal(14, 2)
  tenureMonths Int
  bonusMonths  Int          @default(0)
  status       SchemeStatus @default(active)
  enrolledAt   DateTime

  legacyId        String?   @unique
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store               @relation(fields: [storeId], references: [id])
  party        Party?              @relation(fields: [partyId], references: [id])
  plan         SchemePlan          @relation(fields: [planId], references: [id])
  installments SchemeInstallment[]
  payments     Payment[]

  @@index([storeId, createdAt])
  @@index([status])
}

/// One installment in a scheme member's plan. Legacy: SchemeMemberInstalment.
model SchemeInstallment {
  id          String            @id @default(cuid())
  memberId    String
  /// 1-based installment index in the plan.
  sequence    Int
  dueDate     DateTime          @db.Date
  amount      Decimal           @db.Decimal(14, 2)
  /// Gold weight credited (rate-on-pay model), exact.
  goldWeightG Decimal?          @db.Decimal(12, 3)
  goldRate    Decimal?          @db.Decimal(12, 2)
  status      InstallmentStatus @default(due)
  paidAt      DateTime?

  member SchemeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, sequence])
  @@index([dueDate])
}

// ----------------------------------------------------------------------------
// MODULE 17 — "Earn with Ratanlall" referral / commission program (net-new).
// A referrer X gets a unique coupon code; a referee Y using it gets 5% off on
// diamond, and X earns 5% commission on Y's total bill, credited to X's balance
// and redeemable / cashable out. Optional per-code usage cap prevents public
// leaks. See docs/CLIENT-CALL-2026-07.md (Module 17 referral bullet).
// ----------------------------------------------------------------------------

/// A referrer's unique coupon code + running commission balance.
model ReferralCode {
  id                String   @id @default(cuid())
  code              String   @unique
  referrerName      String
  referrerPhone     String?
  storeId           String?
  /// Optional anti-leak cap: max number of times this code may be applied.
  maxUses           Int?
  uses              Int      @default(0)
  /// Earned-but-unpaid commission (INR). Credited on each referral, drawn down on payout.
  commissionBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt         DateTime @default(now())

  referrals Referral[]
  payouts   ReferralPayout[]

  @@index([storeId])
}

/// One redemption of a referral code on a referee's purchase.
model Referral {
  id                    String  @id @default(cuid())
  codeId                String
  refereeName           String
  refereePhone          String?
  storeId               String?
  billAmount            Decimal @db.Decimal(14, 2)
  diamondDiscountPct    Decimal @default(5) @db.Decimal(5, 2)
  diamondDiscountAmount Decimal @default(0) @db.Decimal(14, 2)
  commissionPct         Decimal @default(5) @db.Decimal(5, 2)
  commissionAmount      Decimal @default(0) @db.Decimal(14, 2)

  // Round 2: per-referral invoice + sale date (referral wallet sheet).
  /// Invoice number of the referee's purchase.
  invoiceNo String?
  /// Sale / bill date (distinct from createdAt).
  billDate  DateTime? @db.Date

  createdAt DateTime @default(now())

  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId])
}

/// A redeem / cash-out of a referrer's accrued commission balance.
model ReferralPayout {
  id        String   @id @default(cuid())
  codeId    String
  amount    Decimal  @db.Decimal(14, 2)
  /// 'redeem' | 'cashout'.
  type      String
  /// Round 2: invoice a redeem is tied to (encash/cashout has none).
  invoiceNo String?
  createdAt DateTime @default(now())

  code ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId])
}

// ============================================================================
// MODULE 13 — TICKETING (net-new)
// ============================================================================

model Ticket {
  id           String         @id @default(cuid())
  ref          String         @unique
  storeId      String?
  subject      String
  category     TicketCategory
  priority     TicketPriority @default(medium)
  status       TicketStatus   @default(open)
  assigneeId   String?
  assigneeName String?
  reporterName String?
  /// Group recurring tickets for structural-fix pattern recognition.
  patternTag   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store?          @relation(fields: [storeId], references: [id])
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages TicketMessage[]

  @@index([storeId, createdAt])
  @@index([status])
  @@index([patternTag])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String?
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ============================================================================
// MODULE 14 — RETURNS & EXCHANGE (partial legacy: JewelTrans return variant)
// ============================================================================

model ReturnRecord {
  id           String         @id @default(cuid())
  ref          String         @unique
  storeId      String
  partyId      String?
  saleId       String?
  customerName String
  phone        String?
  type         ReturnType
  item         String?
  /// Estimated value / trade-in value (INR).
  value        Decimal?       @db.Decimal(14, 2)
  weightGrams  Decimal?       @db.Decimal(12, 3)
  settlement   SettlementType @default(credit_note)
  status       ReturnStatus   @default(draft)
  reason       String?
  /// Approver's note on the approve/reject decision — surfaced back to the requester.
  decisionNote String?
  raisedBy     String?

  // Round 2: By-Invoice vs By-Manual intake toggle.
  /// 'invoice' = pulled from a Gati bill, 'manual' = typed.
  entryMode String? @default("manual")
  /// Source invoice number when entryMode = 'invoice'.
  invoiceNo String?

  // Module 14 — exchange / buyback calculator (all additive, nullable).
  // Original purchase inputs (manager keys these from the old bill):
  purchaseGoldWtG  Decimal? @db.Decimal(12, 3)
  purchaseGoldRate Decimal? @db.Decimal(12, 2)
  purchaseDiaCarat Decimal? @db.Decimal(10, 3)
  purchaseDiaRate  Decimal? @db.Decimal(12, 2)
  diaSpec          String?
  purchaseMaking   Decimal? @db.Decimal(14, 2)
  // Resolved "today" rates + computed option values (snapshot at intake):
  todayGoldRate    Decimal? @db.Decimal(12, 2)
  todayDiaRate     Decimal? @db.Decimal(12, 2)
  exchangeValue    Decimal? @db.Decimal(14, 2)
  buybackValue     Decimal? @db.Decimal(14, 2)
  /// 'exchange' | 'buyback' — which option the customer took.
  chosenOption     String?

  // Legacy provenance (JewelTrans return-type doc).
  legacyId        String?   @unique
  legacyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store  Store         @relation(fields: [storeId], references: [id])
  party  Party?        @relation(fields: [partyId], references: [id])
  sale   Sale?         @relation(fields: [saleId], references: [id])
  photos ReturnPhoto[]

  @@index([storeId, createdAt])
  @@index([status])
}

/// Photo-based intake (Module 14) — file in object storage, URL only here.
model ReturnPhoto {
  id        String   @id @default(cuid())
  returnId  String
  url       String
  label     String?
  createdAt DateTime @default(now())

  returnRecord ReturnRecord @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

/// HO-set diamond rate table for the Module 14 exchange/buyback calculator.
/// Unlike gold (daily, MetalRate) this changes only every 3-6 months and is keyed
/// by diamond spec / internal code (e.g. "1ct", "20cent"). Optional per-store override.
model DiamondRate {
  id            String   @id @default(cuid())
  spec          String
  ratePerCarat  Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  storeId       String?
  createdAt     DateTime @default(now())

  @@index([spec, effectiveFrom])
}

// ============================================================================
// MODULE 15 — DISCOUNT MANAGEMENT (partial legacy: DiscountMarkupMst)
// ============================================================================

model DiscountRequest {
  id             String         @id @default(cuid())
  ref            String         @unique
  storeId        String
  customerName   String
  item           String?
  /// Requested discount as percentage and/or absolute amount (legacy single figure).
  percent        Decimal?       @db.Decimal(5, 2)
  amount         Decimal?       @db.Decimal(14, 2)
  /// Module 15 split caps: requested DIAMOND / MAKING discount percentages. Gold is never discounted.
  diamondPercent Decimal?       @db.Decimal(5, 2)
  makingPercent  Decimal?       @db.Decimal(5, 2)
  /// Snapshot of the piece's selling price (INR) at request time (from Gati / Product).
  sellingPrice   Decimal?       @db.Decimal(14, 2)
  /// Snapshot of the piece's cost price (INR). Never surfaced to store_manager or below.
  costPrice      Decimal?       @db.Decimal(14, 2)
  /// Margin-impact preview snapshot (INR) shown before approval.
  marginImpact   Decimal?       @db.Decimal(14, 2)
  status         DiscountStatus @default(pending)
  reason         String?
  /// Approver's note on the approve/reject decision — surfaced back to the requester.
  decisionNote   String?

  requestedById String?
  requestedRole Role?
  /// Module 15: the minimum role that must approve this request (set on escalation).
  requiredRole  Role?
  approvedById  String?
  approvedRole  Role?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store @relation(fields: [storeId], references: [id])
  requestedBy User? @relation("DiscountRequester", fields: [requestedById], references: [id])
  approvedBy  User? @relation("DiscountApprover", fields: [approvedById], references: [id])

  @@index([storeId, createdAt])
  @@index([status])
}

// ============================================================================
