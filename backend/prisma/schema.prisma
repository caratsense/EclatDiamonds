}

/// Shop-floor bag/lot moving through production departments. Legacy: SPM_BagMaster.
model ProductionBag {
  id          String    @id @default(cuid())
  orderId     String?
  bagNo       String
  barcode     String?
  department  String?
  status      String?
  grossWeight Decimal?  @db.Decimal(12, 3)
  netWeight   Decimal?  @db.Decimal(12, 3)
