// ============================================================================
// MODULE 7 � CUSTOMER CHECK-INS & FOOTFALL (net-new; CCTV dropped)
// ============================================================================

model CheckIn {
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  id             String         @id @default(cuid())
  storeId        String
  partyId        String?
  customerName   String
  phone          String?
  purpose        CheckinPurpose @default(other)
  outcome        CheckinOutcome @default(in_store)
  repId          String?
  repName        String?
  timeIn         DateTime
  timeOut        DateTime?

  /// The tenant's OWN visit purpose, as a `checkin_purpose` taxonomy code.
  ///
  /// `purpose` above is a jewellery enum (bridal, investment, repair, scheme)
  /// and cannot be extended per tenant without a migration each time. Every
  /// industry pack already seeds its own visit vocabulary — "Appointment" for a
  /// clinic, "Site visit" for a developer — so this is where a non-jewellery
  /// tenant's real answer lives. The enum stays for the existing rows and
  /// defaults to `other` for everyone else.
  purposeCode String?

  /// Free text from the person who attended the visit.
  notes String?

  /// A photo taken at the counter when the visit was recorded, as a storage URL.
  /// A picture, not an identification: nothing compares it to anything, and who
  /// the visitor is comes from the customer record this visit is attached to.
  photoUrl String?

  /*
   * What was decided when the customer left.
   *
   * `remark` and `followUpDate` are deliberately two columns, not one. The
   * meeting argued about exactly this and stopped without settling it, so the
   * reading taken here is the one where they do not overlap: the remark is what
   * was SAID, the follow-up date is what will be DONE. A visit can carry either
   * alone — somebody can say something worth recording and need no callback,
   * and a callback can be booked with nothing quotable to write down.
   */
  remark String?

  /// A calendar date in the STORE's timezone, not an instant. "Call them
  /// Tuesday" is a day; storing it as a timestamp makes it a different day for
  /// anyone reading from another zone.
  followUpDate DateTime? @db.Date

  /// Who owes the follow-up. Defaults to whoever served the visit, but a manager
  /// may hand it to whoever is on shift that day.
  followUpOwnerId String?
  followUpOwner   User?   @relation("CheckInFollowUpOwner", fields: [followUpOwnerId], references: [id])

  /// How the customer said they would rather be reached. Free text, not an enum:
  /// the channels a tenant uses are not ours to fix, and a clinic's answer is
  /// not a jeweller's.
  preferredAction String?

  /// The enquiry the follow-up was filed against, so the visit, what they looked
  /// at, the remark and the callback all read as one thing in Customer 360.
  /// SET NULL, not CASCADE: losing the enquiry must not delete the record that
  /// the person came to the shop.
  leadId String?
  lead   Lead?   @relation("CheckInLead", fields: [leadId], references: [id], onDelete: SetNull)

  /// Who actually attended, as an id. `repName` is a display string kept for
  /// rows written before this existed; a name is not an identity.
  attendedById String?
  attendedBy   User?   @relation("CheckInAttendedBy", fields: [attendedById], references: [id])

  /// Tenant-defined visit fields, keyed by AttributeDefinition.key
  /// (entity='checkin'): a jeweller's counter and occasion, a clinic's
  /// department. Industry vocabulary lives here instead of in new columns.
  metadata Json?

  createdAt DateTime @default(now())

  store Store  @relation(fields: [storeId], references: [id])
  party Party? @relation(fields: [partyId], references: [id])

  /// What the customer asked about during this visit.
  productInteractions ProductInteraction[]

  @@index([storeId, timeIn])
  @@index([organisationId])
  @@index([storeId, followUpDate])
  @@index([followUpOwnerId, followUpDate])
  @@index([leadId])
}

