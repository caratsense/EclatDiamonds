# ─────────────────────────────────────────────────────────────────────────────
# Eclat / CaratSense — BACKEND environment
# Copy to `.env` and fill in real values. `.env` is git-ignored (only this
# .env.example is committed). On Railway, set these as service Variables instead
# of shipping a .env file. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core: required for the app to boot ──────────────────────────────────────

# PostgreSQL connection used by Prisma (migrations + client).
# Local dev (Postgres 18 service "postgresql-x64-18"):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eclat_dev?schema=public"
# Production (Railway managed Postgres) — set as a reference ${{ Postgres.DATABASE_URL }};
# ensure it ends with ?schema=public&sslmode=require. Example shape:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public&sslmode=require"

# HTTP port. Local default 4000. Railway injects PORT automatically — do NOT hardcode in prod.
PORT=4000

# Secret used to sign/verify JWTs (auth). Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates all existing sessions.
JWT_SECRET="change-me-to-a-long-random-string"
# Optional token lifetime (e.g. 12h, 7d). Defaults in app if unset.
JWT_EXPIRES_IN="12h"

# Root domain for generated staff login handles (never receives mail).
# Handles are minted as <first>.<branch>@<tenant-slug>.<this>.
PLATFORM_HANDLE_DOMAIN="accounts.caratos.invalid"

# Comma-separated list of allowed browser origins for CORS.
# Local: http://localhost:3000  |  Prod: your real Vercel domain(s).
# (See docs/DEPLOYMENT.md — main.ts currently hardcodes localhost:3000; the runbook
#  documents switching CORS to read this var before going live.)
CORS_ORIGINS="http://localhost:3000"

# The web app address customers are sent to (the feedback link in an automatic
# after-visit WhatsApp). https:// in production. Unset, those asks go to the
# staff member as a task instead, and say why.
PUBLIC_APP_URL=""

# ── Object storage for jewellery images / return photos (URLs only in Postgres) ──
# Path A default: Cloudflare R2 (S3-compatible). Leave blank until provisioned.
STORAGE_PROVIDER="r2"                       # r2 | cloudinary | railway-volume
# Local-disk fallback (the default provider in code): where uploads are written
# and served from at /uploads. Relative paths resolve from the backend cwd.
UPLOAD_DIR="uploads"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="eclat-jewellery-images"
R2_PUBLIC_BASE_URL=""                       # e.g. https://images.caratsense.in
# Alternative: Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Integrations (Phase 4 — code-complete; each activates the moment its keys are set) ──
# Until filled in, every integration degrades to a logged no-op ("dry-run"), so the
# app runs identically with or without credentials. See src/integrations/.

# WhatsApp Business Cloud API (quotes, DSR, reminders — see CLAUDE.md channels)
WHATSAPP_PHONE_NUMBER_ID=""                  # sender phone-number id (enables sending)
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""                      # permanent system-user token (enables sending)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""             # arbitrary string you also enter in Meta's webhook setup
WHATSAPP_APP_SECRET=""                        # Meta app secret — verifies inbound X-Hub-Signature-256
# Optional overrides (sane defaults in code):
# WHATSAPP_API_VERSION="v21.0"
# WHATSAPP_GRAPH_BASE="https://graph.facebook.com"
# Display number the bot messages from, shown in-app when a user links their
# WhatsApp (e.g. "+1 555 677-2943" for the Meta test sender). Optional.
WHATSAPP_BOT_NUMBER=""

# Razorpay (Module 12 payment collection, Module 17 gold-savings scheme)
RAZORPAY_KEY_ID=""                            # KEY_ID + KEY_SECRET enable payment-link creation
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""                    # required to accept (verify) the payment webhook

# Gold / metal rate feed (Module 2 pricing engine — OP-2 source of truth pending)
# Supported response shapes auto-detected: {inr_per_gram} | goldapi.io {price_gram_24k}
# | metals.dev {metals:{gold}} (per troy ounce). Set the URL to enable POST /integrations/gold-rate/refresh.
GOLD_RATE_API_URL=""
GOLD_RATE_API_KEY=""                          # sent as x-access-token (goldapi.io style); optional

# AI image search (Module 5) — OPTIONAL metadata enrichment. Claude vision TAGS an
# uploaded design photo (category/metal/keywords). This is NOT visual similarity;
# without a real embedding provider (below) it only powers a keyword fallback that
# the API labels visualMatch:false. Leave blank to disable tagging.
ANTHROPIC_API_KEY=""

# === REAL visual similarity — THE live catalogue "AI image search" + "Find Similar" ===
# Both the catalogue AI-search card and the Find-Similar page use the DUAL
# DINOv2 + SigLIP 2 inference service in `inference/` (deploy it, then point here).
# Contract: POST /embed { image_b64, mime } -> { dino:[...], siglip:[...], ... }.
# With no URL, POST /products/jewelry/similarity-search returns available:false
# (never a fake match). Catalogue must also be indexed once via
# POST /products/embeddings/reindex (head office) after images exist.
# pgvector upgrade (optional, at scale): prisma/manual/20260819_pgvector_dual_embeddings.sql.
ML_INFERENCE_URL=""                            # e.g. https://eclat-inference.up.railway.app
ML_INFERENCE_KEY=""                            # sent as Bearer token (matches inference INFERENCE_API_KEY)

# --- LEGACY single-embedding path (AiImageSearchService / POST /products/image-search).
# Superseded by the dual DINOv2+SigLIP service above and no longer wired to the UI.
# Nothing currently serves this generic { embedding:[...] } contract; leave blank.
IMAGE_EMBEDDING_PROVIDER=""                   # "http" to enable; blank = unavailable (legacy)
IMAGE_EMBEDDING_URL=""                         # embedding endpoint (legacy)
IMAGE_EMBEDDING_KEY=""                         # sent as Bearer token (legacy)
IMAGE_EMBEDDING_MATCH_THRESHOLD="0.7"          # cosine cutoff; calibrate per model (legacy)

# Google Sign-In (optional, alongside email/password). The OAuth Client ID from
# Google Cloud Console → Credentials. Backend uses it to verify the ID token's
# audience; the SAME id must be set as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
# Only EXISTING users (matched by Google email) can sign in — no auto-provisioning.
# Leave blank to disable Google sign-in (the button hides; /auth/google returns 400).
GOOGLE_CLIENT_ID=""
# Optional Workspace domain allow-list, e.g. "caratsense.in" or "a.com,b.com".
# Blank = no restriction. Only works for Workspace accounts (personal Gmail tokens
# carry no `hd` claim), so leave it blank until the OAuth client moves to Workspace.
GOOGLE_ALLOWED_DOMAINS=""

# ── Sync agent service account (on-site agent logs in with these) ──
# The on-site Python sync agent authenticates as a dedicated user via POST /auth/login.
# Create this user in the DB; scope/role per least-privilege. Value here is documentation
# only — the agent stores its own credentials in data_sync/EclatSync/eclat_config.bat.
# SYNC_AGENT_EMAIL="sync@yourjewelryclient.com"

# ============================================================================
# Phase B — production hardening. Every value below is OPTIONAL; the app runs
# without them, and each one says plainly what is lost when it is unset.
# ============================================================================

# --- Credential encryption (REQUIRED before any tenant connects an integration)
# AES-256-GCM master key for IntegrationCredential. Without it, storing a tenant
# secret FAILS CLOSED rather than falling back to plaintext. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Positive integer stamped onto new ciphertext. Start at 1 and increment every
# time the active key changes; re-wrap all credentials before removing PREVIOUS.
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Key rotation: set the new key above, keep the previous one here until every row
# has been re-wrapped, then remove it.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# --- WhatsApp tenant binding (Phase A14)
# Names the ONE organisation permitted to send from the platform's own WhatsApp
# number. Unset means no organisation uses it — deliberately, so a second tenant
# can never inherit another business's identity by default.
WHATSAPP_PLATFORM_ORGANISATION_ID=

# --- CRM AI qualification + knowledge-grounded reply drafts (Phase A9 / 2C)
# All are optional. Drafting is disabled unless provider, model and key are set;
# inbound conversations then remain in the visible human queue. The key is never
# logged. Supported providers: anthropic | openai. BASE_URL is only for a reviewed
# OpenAI-compatible gateway; leave it empty for the provider's official endpoint.
CRM_AI_PROVIDER=
CRM_AI_MODEL=
CRM_AI_API_KEY=
CRM_AI_BASE_URL=

# --- Rate limiting (Phase B4). Requests per 60s per key.
# Authenticated traffic is keyed on the ORGANISATION (or the user, for expensive
# work); only unauthenticated traffic is keyed on IP.
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_TENANT=600
RATE_LIMIT_EXPENSIVE=20
RATE_LIMIT_INTEGRATION=600

# --- Observability (Phase B5)
# Requests slower than this are logged at warn even when they succeed.
SLOW_REQUEST_MS=1000

# --- Row-level security (Phase B3) — NOT YET ENABLED
# The policies exist but every table has RLS disabled. Enabling requires the app
# to establish a per-request tenant context first (see the B3 migration header).
# It ALSO requires the application to connect as a NON-SUPERUSER role: a
# superuser bypasses RLS entirely and silently, so policies would appear to work
# while enforcing nothing.
# Private PDF/DOC knowledge files. `local` is development-only; production must
# use `r2` so source documents survive deploys. No public base URL is used: the
# server performs signed PUT/GET/DELETE against the private S3-compatible API.
KNOWLEDGE_STORAGE_PROVIDER=local             # local | r2
KNOWLEDGE_UPLOAD_DIR=uploads-private/knowledge
KNOWLEDGE_R2_BUCKET=                         # dedicated private bucket preferred
KNOWLEDGE_R2_ENDPOINT=                       # optional; defaults to R2_ENDPOINT/account endpoint

# --- Operator-only backup / restore commands (not read by the running API)
# BACKUP_DATABASE_URL=                         # defaults to DATABASE_URL
# BACKUP_OUTPUT_DIR=D:\\CaratOS-Backups        # absolute encrypted/off-site mount
# RESTORE_DATABASE_URL=                        # target must end _test or _rehearsal
# BACKUP_FILE=D:\\CaratOS-Backups\\backup.dump
# PG_DUMP_PATH=                                # optional explicit executable path
# PG_RESTORE_PATH=
# PSQL_PATH=

# --- Meta (Facebook/Instagram) webhooks and Graph API
# All three are REQUIRED before any Meta feature works, and each fails in a
# different, quiet way when absent — which is why they are listed rather than
# discovered.
#
#   META_GRAPH_API_VERSION  every Graph call throws before the request is made
#                           (meta-graph.client.ts), so Lead Ads jobs dead-letter
#                           after five attempts with no outbound traffic at all.
#   META_APP_SECRET         X-Hub-Signature-256 verification returns false for
#                           every event — fail-closed, so the webhook 403s and
#                           Meta eventually disables the subscription.
#   META_WEBHOOK_VERIFY_TOKEN  the subscription challenge cannot be answered, so
#                           the webhook can never be registered in the first place.
#
# The app secret and the verify token are credentials: keep them here as empty
# placeholders only. A tenant's page access tokens do NOT belong in env at all —
# they are encrypted per tenant in IntegrationCredential.
META_GRAPH_API_VERSION=                      # explicit version, e.g. v21.0 — no default on purpose
META_APP_SECRET=                             # Meta App dashboard -> App secret
META_WEBHOOK_VERIFY_TOKEN=                   # any high-entropy string; must match the Meta dashboard

# --- CRM QR lead capture
# Signs the QR payload (AES-256-GCM, domain-separated). REQUIRED in production:
# QR lead capture fails closed without it. It no longer falls back to
# JWT_SECRET — one key with two jobs could not be rotated for either, and store
# QR posters live on walls for months while sessions rotate in minutes.
# Minimum 16 characters; generate with: openssl rand -hex 32
CRM_QR_SECRET=

# ── Operations alerting (dead / failed background jobs) ──────────────────────
# A dead Meta lead-fetch job is a customer who filled in a form and reached
# nobody, so the scheduler sweeps every 30 minutes and pages once per condition
# per tenant (again only after it recovers). With no webhook set it logs at
# error level instead — that is a deployment gap, not a failure.
OPS_ALERT_WEBHOOK_URL=                       # https:// endpoint; receives counts only, never customer data
OPS_ALERT_DEAD_THRESHOLD=                    # dead jobs before paging (default 1)
OPS_ALERT_FAILED_THRESHOLD=                  # failed delivery jobs before paging (default 10)

# ── Staging blast door ──────────────────────────────────────────────────────
# When set, this process may send WhatsApp messages ONLY to these numbers;
# every other recipient is refused at the single outbound chokepoint, below all
# policy and retry logic. Set it on staging. Leave it EMPTY in production —
# an empty value means "no restriction", a non-empty one means "these only".
MESSAGING_RECIPIENT_ALLOWLIST=               # comma-separated, e.g. 919812345678,919800000000
