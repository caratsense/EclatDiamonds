{
  "name": "eclat-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Eclat / CaratSense — data layer (Prisma + PostgreSQL). NestJS app is added on top of this by the backend-engineer.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test scripts prisma",
    "lint:changed": "node scripts/lint-changed.mjs",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "seed:local": "node scripts/seed-conversations.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore:verify": "node scripts/db-restore-verify.mjs",
    "db:restore:drill": "node scripts/db-restore-drill.mjs",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:db:setup": "node scripts/test-db.mjs setup",
    "test:db:drop": "node scripts/test-db.mjs drop",
    "test:e2e:isolated": "node scripts/run-e2e.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "qs": "6.16.0",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/testing": "^11.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.21",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "playwright": "^1.63.0",
    "prisma": "^6.2.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
