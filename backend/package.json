    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "mssql": "^12.5.5",
    "nodemailer": "^10.0.1",
    "pdf-lib": "1.17.1",
